<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>preview.1</VersionSuffix>
    <ApplicationTitle>NovaSharp Preview</ApplicationTitle>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Locator" Version="1.11.2" />
    <PackageReference Include="Microsoft.Build.Framework" Version="17.11.48" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.6.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" Version="5.6.0" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.6.0" />
    <PackageReference Include="PhotinoXDX.Blazor" Version="0.1.0-preview.7" />
    <PackageReference Include="Porta.Pty" Version="1.0.7" />
    <PackageReference Include="StreamJsonRpc" Version="2.25.29" />
    <PackageReference Include="Microsoft.NET.StringTools" Version="18.4.0" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="XtermBlazor" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>LanguageServerDevelopmentAssetRoot</_Parameter1>
      <_Parameter2>$(MSBuildProjectDirectory)/LanguageServers/Assets</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>DebugAdapterDevelopmentAssetRoot</_Parameter1>
      <_Parameter2>$(MSBuildProjectDirectory)/DebugAdapters/Assets</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Content Remove="wwwroot/**/*" />
    <None Include="wwwroot/**/*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="LanguageServers/Assets/$(RuntimeIdentifier)/**/*" Link="LanguageServers/%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="'$(RuntimeIdentifier)' != ''" />
    <None Include="DebugAdapters/Assets/$(RuntimeIdentifier)/**/*" Link="DebugAdapters/%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="'$(RuntimeIdentifier)' != ''" />
    <None Include="../../THIRD-PARTY-NOTICES-LANGUAGESERVERS.md" Link="THIRD-PARTY-NOTICES-LANGUAGESERVERS.md"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../LANGUAGE-SERVERS.spdx.json" Link="LANGUAGE-SERVERS.spdx.json"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
