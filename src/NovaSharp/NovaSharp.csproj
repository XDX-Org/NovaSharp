<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Locator" Version="1.11.2" />
    <PackageReference Include="Microsoft.Build.Framework" Version="17.11.48" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" Version="5.6.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.6.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.6.0" />
    <PackageReference Include="Microsoft.NET.StringTools" Version="18.4.0" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="PhotinoXDX.Blazor" Version="0.1.0-preview.6" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>LanguageServerDevelopmentAssetRoot</_Parameter1>
      <_Parameter2>$(MSBuildProjectDirectory)/LanguageServers/Assets</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Content Remove="wwwroot/**/*" />
    <None Include="wwwroot/**/*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="LanguageServers/Assets/$(RuntimeIdentifier)/**/*"
          Link="LanguageServers/%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Condition="'$(RuntimeIdentifier)' != ''" />
    <None Include="../../THIRD-PARTY-NOTICES-LANGUAGESERVERS.md"
          Link="THIRD-PARTY-NOTICES-LANGUAGESERVERS.md"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../THIRD-PARTY-NOTICES-MONACO.md"
          Link="THIRD-PARTY-NOTICES-MONACO.md"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="ValidateLocalAssets" BeforeTargets="Build;Publish">
    <Error Condition="!Exists('wwwroot/monaco/asset-manifest.json')"
           Text="Monaco assets are missing. Run the platform bootstrap command from README.md." />
    <Error Condition="'$(RuntimeIdentifier)' != '' and !Exists('LanguageServers/Assets/$(RuntimeIdentifier)/.source-manifest.sha256')"
           Text="Language-server assets for $(RuntimeIdentifier) are missing. Run the platform bootstrap command from README.md." />
  </Target>
</Project>
