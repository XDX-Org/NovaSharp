@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="monaco-editor-host" @ref="_root"></div>

@code {
    [Parameter, EditorRequired] public string Value { get; set; } = string.Empty;
    [Parameter, EditorRequired] public EventCallback<EditorEditBatch> EditsChanged { get; set; }
    [Parameter, EditorRequired] public EditorDocumentState Document { get; set; } = null!;
    [Parameter, EditorRequired] public EditorViewState ViewState { get; set; } = null!;
    [Parameter] public EventCallback ViewStateChanged { get; set; }
    [Parameter] public bool WordWrap { get; set; }
    [Parameter] public IReadOnlyList<LanguageDiagnostic> Diagnostics { get; set; } = [];
    [Parameter] public IReadOnlySet<int> BreakpointLines { get; set; } = new HashSet<int>();
    [Parameter] public int? ExecutionLine { get; set; }
    [Parameter] public IReadOnlyList<SemanticSpan> SemanticSpans { get; set; } = [];
    [Parameter] public bool SuggestionsEnabled { get; set; } = true;
    [Parameter] public bool BraceGuides { get; set; }
    [Parameter] public EventCallback<BreakpointToggleRequest> BreakpointToggled { get; set; }
    [Parameter] public EventCallback<EditorInputCommand> CommandRequested { get; set; }

    private ElementReference _root;
    private IJSObjectReference? _module;
    private DotNetObjectReference<MonacoEditorHost>? _self;
    private bool _created;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./monaco-editor-host.js");
            _self = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("createEditor", _root, Document.Id.ToString("N"), Document.FilePath,
                LanguageId(Document.FilePath), Value, Document.Version, Options(), ViewState.SelectionStart, ViewState.SelectionEnd,
                ViewState.ScrollTop, ViewState.ScrollLeft, _self);
            _created = true;
        }
        if (_created)
            await _module!.InvokeVoidAsync("updateEditor", _root, Value, Document.Version, Options(), Markers(),
                BreakpointLines, ExecutionLine, SemanticSpans);
    }

    [JSInvokable]
    public Task ModelChanged(long baseVersion, EditorTextEdit[] edits, int selectionStart, int selectionEnd)
    {
        return EditsChanged.InvokeAsync(new(baseVersion, edits, selectionStart, selectionEnd));
    }

    [JSInvokable]
    public async Task ViewChanged(int selectionStart, int selectionEnd, double scrollTop, double scrollLeft)
    {
        ViewState.SetSelection(selectionStart, selectionEnd, Value.Length);
        ViewState.SetScroll(scrollTop, scrollLeft);
        await ViewStateChanged.InvokeAsync();
    }

    [JSInvokable]
    public Task ToggleBreakpoint(int line) => Document.FilePath is null
        ? Task.CompletedTask : BreakpointToggled.InvokeAsync(new(Document.FilePath, line));

    [JSInvokable]
    public Task Command(string command, int position) => CommandRequested.InvokeAsync(new(command, position));

    internal Task ApplyEditAsync(int start, int length, string text, int? newPosition) =>
        _module!.InvokeVoidAsync("applyEditorEdit", _root, start, length, text, newPosition).AsTask();

    internal Task ReplaceTextAsync(string text, int selectionStart, int selectionLength) =>
        _module!.InvokeVoidAsync("replaceEditorText", _root, text, selectionStart, selectionLength).AsTask();

    internal Task SetSelectionAsync(int selectionStart, int selectionEnd) =>
        _module!.InvokeVoidAsync("setEditorSelection", _root, selectionStart, selectionEnd).AsTask();

    internal Task<double[]> GetAnchorAsync(int position) =>
        _module!.InvokeAsync<double[]>("getEditorAnchor", _root, position).AsTask();

    private object[] Markers() => Diagnostics.Select(item => new
    {
        startLineNumber = item.StartLine + 1,
        startColumn = item.StartColumn + 1,
        endLineNumber = (item.EndLine < 0 ? item.StartLine : item.EndLine) + 1,
        endColumn = (item.EndColumn < 0 ? item.StartColumn + Math.Max(1, item.Range.Length) : item.EndColumn) + 1,
        severity = item.Severity.ToString(),
        code = item.Id,
        message = item.Message,
        source = item.Source
    }).Cast<object>().ToArray();

    private object Options()
    {
        var settings = Program.Configuration.Current;
        return new { wordWrap = WordWrap, settings.TabSize, settings.Ligatures, settings.HighContrast,
            lightTheme = settings.Theme == "Light", settings.ReducedMotion, SuggestionsEnabled, BraceGuides };
    }

    private static string LanguageId(string? path) => Path.GetExtension(path)?.ToLowerInvariant() switch
    {
        ".cs" => "csharp", ".razor" => "razor", ".html" or ".htm" => "html", ".css" => "css",
        ".js" or ".jsx" => "javascript", ".ts" or ".tsx" => "typescript", ".json" => "json",
        ".xml" or ".csproj" or ".slnx" => "xml", ".md" => "markdown", _ => "plaintext"
    };

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("disposeEditor", _root); }
            catch (JSDisconnectedException) { }
            await _module.DisposeAsync();
        }
        _self?.Dispose();
    }
}
