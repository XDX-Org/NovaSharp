@using PhotinoEx.Core.Models

<main class="workbench">
    <header class="toolbar">
        <button type="button" @onclick="OpenFileAsync">Open C# file</button>
        <span class="file-name" title="@_document.FilePath">@FileName</span>
    </header>

    <section class="editor-panel" aria-label="C# editor">
        @if (_document.Error is not null)
        {
            <div class="error" role="alert">@_document.Error</div>
        }
        else if (_document.FilePath is null)
        {
            <div class="empty-state">Open a .cs file to begin.</div>
        }
        else
        {
            <textarea aria-label="File contents" spellcheck="false" @bind="_document.Content"></textarea>
        }
    </section>
</main>

@code {
    private readonly EditorDocumentState _document = new();

    private string FileName => _document.FilePath is null ? "No file open" : Path.GetFileName(_document.FilePath);

    private async Task OpenFileAsync()
    {
        var files = await Program.App.MainWindow.ShowOpenFileDialogAsync(
            title: "Open C# file",
            multiSelect: false,
            filterPatterns: [new FileFilter("C# source", "*.cs")]);

        await _document.OpenAsync(files is [var path] ? path : null);
    }
}
