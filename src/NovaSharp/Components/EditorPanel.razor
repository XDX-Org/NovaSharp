@using PhotinoEx.Core.Models
@using Microsoft.AspNetCore.Components.Web
@implements IDisposable
@inject IJSRuntime JS

<main @ref="_workbench" class="workbench" @onkeydown="HandleKeyAsync">
    <header class="toolbar">
        <div class="main-menu">
            <button class="menu-trigger" @onclick="ToggleMenu" aria-label="Main menu" aria-expanded="@_showMenu">☰</button>
            @if (_showMenu)
            {
                <div class="menu-dismiss" @onclick="CloseMenu" @oncontextmenu="CloseMenu" @oncontextmenu:preventDefault></div>
                <div class="menu-popup" role="menu" @onclick:stopPropagation @oncontextmenu:preventDefault @oncontextmenu:stopPropagation>
                    <button role="menuitem" @onclick='() => RunMenu("file.open")'>Open <kbd>Ctrl+O</kbd></button>
                    <button role="menuitem" @onclick='() => RunMenu("file.save")' disabled="@(!_document.IsDirty)">Save <kbd>Ctrl+S</kbd></button>
                    <button role="menuitem" @onclick='() => RunMenu("file.saveAs")' disabled="@(_document.FilePath is null)">Save As <kbd>Ctrl+Shift+S</kbd></button>
                    <button role="menuitem" @onclick="ReloadMenu" disabled="@(_document.FilePath is null)">Reload</button>
                    <hr />
                    <button role="menuitem" @onclick='() => RunMenu("edit.undo")' disabled="@(!_document.CanUndo)">Undo <kbd>Ctrl+Z</kbd></button>
                    <button role="menuitem" @onclick='() => RunMenu("edit.redo")' disabled="@(!_document.CanRedo)">Redo <kbd>Ctrl+Y</kbd></button>
                    <button role="menuitem" @onclick='() => RunMenu("edit.find")'>Find <kbd>Ctrl+F</kbd></button>
                    <button role="menuitem" @onclick="ToggleWrapMenu">Word wrap <span>@(_wordWrap ? "On" : "Off")</span></button>
                </div>
            }
        </div>
    </header>

    @if (_showFind)
    {
        <div class="findbar">
            <input aria-label="Find" placeholder="Find" @bind="_query" @bind:event="oninput" />
            <input aria-label="Replace" placeholder="Replace" @bind="_replacement" />
            <span>@FindCount matches</span>
            <button @onclick="ReplaceAll">Replace all</button>
            <button @onclick="ToggleFind" aria-label="Close find">×</button>
        </div>
    }
    @if (_externalChange)
    {
        <div class="conflict" role="alert">
            <span>@(_document.IsDeletedOnDisk ? "The file was deleted outside NovaSharp." : "The file changed outside NovaSharp.")</span>
            <button @onclick="CompareAsync">Compare</button>
            <button @onclick="ReloadConfirmedAsync">Reload disk version</button>
            <button @onclick="KeepBuffer">Keep editor version</button>
        </div>
    }
    @if (_confirmReload)
    {
        <div class="modal-backdrop" @onclick="CancelReload">
            <div class="modal-dialog" role="alertdialog" aria-modal="true" aria-labelledby="reload-title" @onclick:stopPropagation>
                <h2 id="reload-title">Discard unsaved changes?</h2>
                <p>Reloading will replace the editor contents with the version on disk.</p>
                <div class="modal-actions">
                    <button class="danger" @onclick="ReloadConfirmedAsync">Discard and reload</button>
                    <button @onclick="CancelReload">Cancel</button>
                </div>
            </div>
        </div>
    }
    @if (_showTabContextMenu && _contextTab is not null)
    {
        <div class="context-menu-dismiss" @onclick="HideTabContextMenu"
             @oncontextmenu="HideTabContextMenu" @oncontextmenu:preventDefault></div>
        <div @ref="_tabContextMenu" class="explorer-context-menu tab-context-menu" role="menu"
             @onclick:stopPropagation @oncontextmenu:preventDefault @oncontextmenu:stopPropagation>
            <button role="menuitem" @onclick="ToggleContextTabPin">@(_contextTab.IsPinned ? "Unpin" : "Pin")</button>
            <hr />
            <button role="menuitem" @onclick="() => CloseFromContextAsync(TabCloseScope.One)">Close</button>
            <button role="menuitem" @onclick="() => CloseFromContextAsync(TabCloseScope.Others)" disabled="@(_tabs.Tabs.Count < 2)">Close others</button>
            <button role="menuitem" @onclick="() => CloseFromContextAsync(TabCloseScope.Right)" disabled="@(!HasTabsRight)">Close to the right</button>
            <button role="menuitem" @onclick="() => CloseFromContextAsync(TabCloseScope.Saved)" disabled="@(!_tabs.Tabs.Any(tab => !tab.Document.IsDirty))">Close saved</button>
            <button role="menuitem" @onclick="() => CloseFromContextAsync(TabCloseScope.All)">Close all</button>
        </div>
    }

    <div class="workbench-body">
    <div class="editor-area">
    @if (_tabs.Tabs.Count > 0)
    {
        <div @ref="_tabStrip" class="document-tabs" role="tablist" aria-label="Open editors">
            @foreach (var tab in _tabs.Tabs)
            {
                <div class="document-tab @(ReferenceEquals(tab, _tabs.ActiveTab) ? "active" : null) @(tab.IsPreview ? "preview" : null) @(ReferenceEquals(tab, _draggedTab) ? "dragging" : null)"
                     role="tab" aria-selected="@ReferenceEquals(tab, _tabs.ActiveTab)" tabindex="@(ReferenceEquals(tab, _tabs.ActiveTab) ? 0 : -1)"
                     aria-label="@TabAccessibleLabel(tab)" title="@tab.Document.FilePath" draggable="true" @onclick="() => ActivateTab(tab)"
                     @onmousedown="args => HandleTabMouseDownAsync(args, tab)" @ondragstart="() => BeginTabDrag(tab)"
                     @ondragenter="() => PreviewTabDrop(tab)" @ondragover:preventDefault
                     @ondrop="EndTabDrag" @ondragend="EndTabDrag"
                     @oncontextmenu="args => ShowTabContextMenu(args, tab)" @oncontextmenu:preventDefault>
                    <span class="tab-label">@(_tabs.GetDisplayName(tab))</span>
                    @if (tab.Document.IsDirty) { <span class="tab-dirty" aria-label="Unsaved changes">●</span> }
                    <button class="tab-pin" aria-label="@(tab.IsPinned ? "Unpin" : "Pin") @(_tabs.GetDisplayName(tab))"
                            title="@(tab.IsPinned ? "Unpin" : "Pin")" @onclick="() => TogglePin(tab)" @onclick:stopPropagation>◆</button>
                    <button class="tab-close" aria-label="Close @(_tabs.GetDisplayName(tab))" title="Close"
                            @onclick="() => CloseTabAsync(tab)" @onclick:stopPropagation>×</button>
                </div>
            }
        </div>
    }
    @if (_draggedTab is not null)
    {
        <div class="tab-drag-surface" @ondragover="ReorderFromEditorAsync" @ondragover:preventDefault
             @ondrop="EndTabDrag" @ondrop:preventDefault></div>
    }
    <section class="editor-panel" aria-label="C# editor">
        @if (_document.Error is not null) { <div class="error" role="alert">@_document.Error</div> }
        @if (_document.FilePath is null) { <div class="empty-state">Open a .cs file to begin.</div> }
        else if (_compareText is not null)
        {
            <div class="compare"><pre><strong>Editor</strong>\n@_document.Content</pre><pre><strong>Disk</strong>\n@_compareText</pre></div>
        }
        else { <CodeEditor Value="@(_document.Content ?? string.Empty)" ValueChanged="ContentChanged" WordWrap="_wordWrap"
                           ViewState="_viewState" ViewStateChanged="SaveSessionAsync" @key="(_tabs.ActiveTab?.Id, _wordWrap)" /> }
    </section>
    </div>
    <WorkspaceExplorer @ref="_explorer" Document="_document" FileOpened="OpenWorkspaceFileAsync"
                       FilePreviewed="PreviewWorkspaceFileAsync" OpenChanged="ExplorerOpenChanged" />
    <nav class="activity-bar" aria-label="Tool windows">
        <button class="@(_explorerOpen ? "active" : null)" @onclick="ToggleExplorerAsync" aria-label="Explorer" title="Explorer" aria-pressed="@_explorerOpen">
            <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M3 5.5h6l2 2h10v11H3z" /></svg>
        </button>
    </nav>
    </div>
    <footer class="statusbar">
        <span class="status-message">@Status</span>
        @if (_document.FilePath is not null)
        {
            <span class="document-info">@_document.Encoding · @LineEndingLabel</span>
        }
    </footer>
</main>

@code {
    private readonly DocumentTabService _tabs = new();
    private readonly EditorDocumentState _emptyDocument = new();
    private readonly EditorViewState _emptyViewState = new();
    private readonly CommandRegistry _commands = new();
    private ElementReference _tabStrip;
    private ElementReference _tabContextMenu;
    private ElementReference _workbench;
    private EditorDocumentState _document => _tabs.ActiveTab?.Document ?? _emptyDocument;
    private EditorViewState _viewState => _tabs.ActiveTab?.ViewState ?? _emptyViewState;
    private DocumentTab? _draggedTab;
    private DocumentTab? _contextTab;
    private WorkbenchSessionPersistence _sessionPersistence = null!;
    private DotNetObjectReference<EditorPanel>? _self;
    private bool _phase4SmokeStarted;
    private WorkspaceExplorer? _explorer;
    private string? _status, _compareText;
    private string _query = "", _replacement = "";
    private bool _showFind, _externalChange, _confirmReload, _showMenu, _explorerOpen = true;
    private bool _showTabContextMenu, _positionTabContextMenu;
    private double _tabContextX, _tabContextY;
    private bool _wordWrap;
    private string Status => _status ?? (_document.IsReadOnly ? "Read-only" : _document.FilePath ?? "Ready");
    private string LineEndingLabel => _document.LineEnding == LineEnding.CrLf ? "CRLF" : _document.LineEnding.ToString().ToUpperInvariant();
    private int FindCount => _document.Find(_query).Count;

    protected override async Task OnInitializedAsync()
    {
        _wordWrap = Program.Configuration.Current.WordWrap;
        _sessionPersistence = new(Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData),
            "NovaSharp", "workbench-session.json"));
        RegisterCommands();
        if (Program.Phase4Workspace is not null)
            foreach (var path in Directory.EnumerateFiles(Program.Phase4Workspace, "*.cs").Order())
                await OpenTabAsync(path);
        else if (Program.SmokeFile is not null) await OpenTabAsync(Program.SmokeFile);
        else await RestoreSessionAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_showTabContextMenu && _positionTabContextMenu)
        {
            _positionTabContextMenu = false;
            await JS.InvokeVoidAsync("novaSharp.positionContextMenu", _tabContextMenu, _tabContextX, _tabContextY);
        }
        if (!_phase4SmokeStarted && Program.Phase4Workspace is not null && _tabs.Tabs.Count > 2)
        {
            _phase4SmokeStarted = true;
            _self ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("novaSharp.runPhase4Smoke", _workbench, _self);
        }
    }

    private async Task OpenFileAsync()
    {
        var files = await Program.App.MainWindow.ShowOpenFileDialogAsync(
            title: "Open C# file", multiSelect: true, filterPatterns: [new FileFilter("C# source", "*.cs")]);
        foreach (var path in files ?? []) await OpenTabAsync(path);
    }

    private async Task OpenWorkspaceFileAsync(string path)
    {
        await OpenTabAsync(path);
    }

    private Task PreviewWorkspaceFileAsync(string path) => OpenTabAsync(path, preview: true);

    private async Task OpenTabAsync(string path, bool preview = false)
    {
        var previous = _tabs.ActiveTab?.Document;
        var tab = await _tabs.OpenAsync(path, preview);
        if (tab is null) { _status = _tabs.LastError; return; }
        if (previous is not null) previous.ExternalChangeDetected -= OnExternalChange;
        tab.Document.ExternalChangeDetected -= OnExternalChange;
        tab.Document.ExternalChangeDetected += OnExternalChange;
        Program.ActiveDocument = tab.Document;
        _status = null;
        await SaveSessionAsync();
    }

    private void ActivateTab(DocumentTab tab)
    {
        _document.ExternalChangeDetected -= OnExternalChange;
        _tabs.Activate(tab);
        tab.Document.ExternalChangeDetected -= OnExternalChange;
        tab.Document.ExternalChangeDetected += OnExternalChange;
        Program.ActiveDocument = tab.Document;
        _externalChange = _confirmReload = false;
        _compareText = null;
        _ = SaveSessionAsync();
    }

    private async Task CloseTabAsync(DocumentTab tab)
    {
        await CloseTabsAsync([tab]);
    }

    private async Task CloseTabsAsync(IReadOnlyList<DocumentTab> targets)
    {
        var dirty = targets.Where(tab => tab.Document.IsDirty).ToArray();
        if (dirty.Length > 0)
        {
            var names = string.Join(Environment.NewLine, dirty.Select(tab => $"• {_tabs.GetDisplayName(tab)}"));
            var result = await Program.App.MainWindow.ShowMessageDialogAsync(
                "Unsaved changes", $"Save these files before closing?{Environment.NewLine}{Environment.NewLine}{names}",
                DialogButtons.YesNoCancel, DialogIcon.Warning);
            if (result is not (DialogResult.Yes or DialogResult.No)) return;
            if (result == DialogResult.Yes)
            {
                foreach (var tab in dirty)
                {
                    try { await tab.Document.SaveAsync(); }
                    catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or InvalidOperationException)
                    { _status = ex.Message; return; }
                }
            }
        }

        var activeDocument = _tabs.ActiveTab?.Document;
        activeDocument?.ExternalChangeDetected -= OnExternalChange;
        foreach (var tab in targets) _tabs.Close(tab, discardDirty: true);
        if (_tabs.ActiveTab is { } active)
        {
            active.Document.ExternalChangeDetected -= OnExternalChange;
            active.Document.ExternalChangeDetected += OnExternalChange;
        }
        Program.ActiveDocument = _tabs.ActiveTab?.Document ?? _emptyDocument;
        _externalChange = _confirmReload = false;
        _compareText = null;
        await SaveSessionAsync();
    }

    private async Task CloseFromContextAsync(TabCloseScope scope)
    {
        var context = _contextTab;
        HideTabContextMenu();
        if (context is null) return;
        var tabs = _tabs.Tabs.ToArray();
        var index = Array.IndexOf(tabs, context);
        var targets = scope switch
        {
            TabCloseScope.One => [context],
            TabCloseScope.Others => tabs.Where(tab => !ReferenceEquals(tab, context)).ToArray(),
            TabCloseScope.Right => tabs.Skip(index + 1).ToArray(),
            TabCloseScope.Saved => tabs.Where(tab => !tab.Document.IsDirty).ToArray(),
            _ => tabs
        };
        await CloseTabsAsync(targets);
    }

    private bool HasTabsRight => _contextTab is not null
        && Array.IndexOf(_tabs.Tabs.ToArray(), _contextTab) < _tabs.Tabs.Count - 1;

    private void ShowTabContextMenu(MouseEventArgs args, DocumentTab tab)
    {
        if (args.ShiftKey) return;
        _contextTab = tab;
        _tabContextX = args.ClientX;
        _tabContextY = args.ClientY;
        _showTabContextMenu = _positionTabContextMenu = true;
    }

    private void HideTabContextMenu() { _showTabContextMenu = false; _contextTab = null; }
    private void ToggleContextTabPin() { if (_contextTab is { } tab) TogglePin(tab); HideTabContextMenu(); }
    private void TogglePin(DocumentTab tab)
    {
        if (tab.IsPinned) tab.SetPreview(true); else _tabs.Promote(tab);
        _ = SaveSessionAsync();
    }

    private string TabAccessibleLabel(DocumentTab tab) => string.Join(", ", new[]
    {
        _tabs.GetDisplayName(tab), tab.Document.IsDirty ? "unsaved" : "saved",
        tab.IsPinned ? "pinned" : "preview", tab.Document.IsReadOnly ? "read-only" : null,
        tab.Document.IsDeletedOnDisk ? "missing" : null
    }.Where(value => value is not null));

    private async Task HandleTabMouseDownAsync(MouseEventArgs args, DocumentTab tab)
    {
        if (args.Button == 1) await CloseTabAsync(tab);
    }

    private void BeginTabDrag(DocumentTab tab) => _draggedTab = tab;
    private void PreviewTabDrop(DocumentTab destination)
    {
        if (_draggedTab is null || ReferenceEquals(_draggedTab, destination)) return;
        _tabs.Move(_draggedTab, Array.IndexOf(_tabs.Tabs.ToArray(), destination));
    }
    private void EndTabDrag() { _draggedTab = null; _ = SaveSessionAsync(); }

    private async Task ReorderFromEditorAsync(DragEventArgs args)
    {
        if (_draggedTab is null) return;
        var destination = await JS.InvokeAsync<int>("novaSharp.tabIndexAtX", _tabStrip, args.ClientX);
        _tabs.Move(_draggedTab, destination);
    }

    private async Task SaveAsync()
    {
        try { await _document.SaveAsync(); _status = "Saved"; _externalChange = false; }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or InvalidOperationException) { _status = ex.Message; }
    }

    private async Task SaveAsAsync()
    {
        var path = await Program.App.MainWindow.ShowSaveFileDialogAsync("Save C# file", _document.FilePath ?? "Untitled.cs", [new FileFilter("C# source", "*.cs")]);
        if (string.IsNullOrWhiteSpace(path)) return;
        try { await _document.SaveAsync(path); _status = "Saved"; _externalChange = false; }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException) { _status = ex.Message; }
    }

    private void RequestReload() { if (_document.IsDirty) _confirmReload = true; else _ = ReloadConfirmedAsync(); }
    private void CancelReload() => _confirmReload = false;
    private async Task ReloadConfirmedAsync() { _confirmReload = _externalChange = false; _compareText = null; await _document.ReloadAsync(); _status = _document.Error; }
    private void KeepBuffer() { _document.KeepBuffer(); _externalChange = false; _compareText = null; }
    private async Task CompareAsync() { if (_document.FilePath is not null && File.Exists(_document.FilePath)) _compareText = await File.ReadAllTextAsync(_document.FilePath); }
    private void ContentChanged(string value)
    {
        _document.Content = value;
        if (_tabs.ActiveTab is { IsPreview: true } tab) _tabs.Promote(tab);
        _status = null;
    }
    private void Undo() { _document.Undo(); _status = null; }
    private void Redo() { _document.Redo(); _status = null; }
    private void ToggleFind() => _showFind = !_showFind;
    private void ReplaceAll() => _document.ReplaceAll(_query, _replacement);
    private async Task ToggleWrap()
    {
        _wordWrap = !_wordWrap;
        var current = Program.Configuration.Current;
        await Program.Configuration.SaveUserAsync(current with { WordWrap = _wordWrap });
    }
    private void OnExternalChange() { _externalChange = true; _ = InvokeAsync(StateHasChanged); }
    private Task Run(string id) => _commands.ExecuteAsync(id);
    private void ToggleMenu() => _showMenu = !_showMenu;
    private void CloseMenu() => _showMenu = false;
    private async Task RunMenu(string id) { _showMenu = false; await Run(id); }
    private void ReloadMenu() { _showMenu = false; RequestReload(); }
    private async Task ToggleWrapMenu() { _showMenu = false; await ToggleWrap(); }
    private Task ToggleExplorerAsync() => _explorer?.ToggleCollapsedAsync() ?? Task.CompletedTask;
    private void ExplorerOpenChanged(bool open) { _explorerOpen = open; StateHasChanged(); }

    private void RegisterCommands()
    {
        _commands.Register(new("file.open", "Open", "Ctrl+O", () => !_document.IsDirty, _ => OpenFileAsync()));
        _commands.Register(new("file.save", "Save", "Ctrl+S", () => _document.IsDirty, _ => SaveAsync()));
        _commands.Register(new("file.saveAs", "Save As", "Ctrl+Shift+S", () => _document.FilePath is not null, _ => SaveAsAsync()));
        _commands.Register(new("edit.undo", "Undo", "Ctrl+Z", () => _document.CanUndo, _ => { Undo(); return Task.CompletedTask; }));
        _commands.Register(new("edit.redo", "Redo", "Ctrl+Y", () => _document.CanRedo, _ => { Redo(); return Task.CompletedTask; }));
        _commands.Register(new("edit.find", "Find", "Ctrl+F", () => true, _ => { _showFind = true; return Task.CompletedTask; }));
    }

    private async Task HandleKeyAsync(KeyboardEventArgs args)
    {
        if (!(args.CtrlKey || args.MetaKey)) return;
        switch (args.Key.ToLowerInvariant())
        {
            case "s" when args.ShiftKey: await Run("file.saveAs"); break;
            case "s": await Run("file.save"); break;
            case "o": await Run("file.open"); break;
            case "f": await Run("edit.find"); break;
            case "z" when args.ShiftKey: await Run("edit.redo"); break;
            case "z": await Run("edit.undo"); break;
            case "y": await Run("edit.redo"); break;
            case "pageup" when args.ShiftKey: MoveActiveTab(-1); break;
            case "pagedown" when args.ShiftKey: MoveActiveTab(1); break;
        }
    }

    private void MoveActiveTab(int offset)
    {
        if (_tabs.ActiveTab is not { } active) return;
        var index = Array.IndexOf(_tabs.Tabs.ToArray(), active);
        _tabs.Move(active, index + offset);
        _ = SaveSessionAsync();
    }

    private async Task RestoreSessionAsync()
    {
        var state = await _sessionPersistence.LoadAsync();
        DocumentTab? active = null;
        foreach (var entry in state.Tabs ?? [])
        {
            try
            {
                var tab = await _tabs.RestoreAsync(entry);
                if (PathEquals(entry.Path, state.ActivePath)) active = tab;
            }
            catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or ArgumentException)
            { _status = $"Some editors could not be restored: {ex.Message}"; }
        }
        active ??= _tabs.Tabs.LastOrDefault();
        _tabs.SetActive(active);
        Program.ActiveDocument = active?.Document ?? _emptyDocument;
        if (active is not null) active.Document.ExternalChangeDetected += OnExternalChange;
    }

    private Task SaveSessionAsync()
    {
        var tabs = _tabs.Tabs.Where(tab => tab.Document.FilePath is not null).Select(tab => new SessionTabState(
            tab.Document.FilePath!, tab.IsPreview, tab.ViewState.SelectionStart, tab.ViewState.SelectionEnd,
            tab.ViewState.ScrollTop, tab.ViewState.ScrollLeft)).ToArray();
        return _sessionPersistence.SaveAsync(new(1, _tabs.ActiveTab?.Document.FilePath, tabs));
    }

    private static bool PathEquals(string? left, string? right) => left is not null && right is not null
        && string.Equals(Path.GetFullPath(left), Path.GetFullPath(right), OperatingSystem.IsWindows()
            ? StringComparison.OrdinalIgnoreCase : StringComparison.Ordinal);

    private enum TabCloseScope { One, Others, Right, Saved, All }

    [JSInvokable]
    public Task CompletePhase4SmokeAsync(Phase4SmokeResult result) => Program.CompletePhase4SmokeAsync(result);

    public void Dispose()
    {
        _ = SaveSessionAsync();
        _document.ExternalChangeDetected -= OnExternalChange;
        if (ReferenceEquals(Program.ActiveDocument, _document)) Program.ActiveDocument = null;
        _tabs.Dispose();
        _emptyDocument.Dispose();
        _self?.Dispose();
    }
}
