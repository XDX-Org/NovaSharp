@using System.Collections.Frozen
@using Microsoft.JSInterop
@using NovaSharp.Commands
@using NovaSharp.Configuration
@using NovaSharp.Diagnostics
@using NovaSharp.Editing
@using NovaSharp.Platform
@using NovaSharp.Shell
@using NovaSharp.Solutions
@using NovaSharp.Text
@using NovaSharp.Verification
@using NovaSharp.Workspace
@using Photino.NET
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime

<main class="workbench">
    <header class="command-bar" role="region" aria-label="Global command bar">
        <div class="brand" aria-label="NovaSharp">
            <img src="workbench-assets/nova-mark.png" alt="" />
            <span>NovaSharp</span>
        </div>
        <nav class="global-menus" aria-label="Application menus">
            @foreach (var category in MenuCategories)
            {
                <CommandMenu Label="@category" AccessibleName="@($"{category} menu")"
                             Commands="@MenuCommands(category)" OnInvoke="InvokeAsync"
                             Open="@(_openCommandMenu == category)" OnOpen="() => OpenCommandMenu(category)"
                             OnClose="CloseCommandMenu" />
            }
        </nav>
        <CommandMenu Icon="SemanticIcon.Menu" AccessibleName="Application menu"
                     Commands="@PaletteCommands" OnInvoke="InvokeAsync" CssClass="global-overflow-menu"
                     Open="@(_openCommandMenu == OverflowMenuId)" OnOpen="() => OpenCommandMenu(OverflowMenuId)"
                     OnClose="CloseCommandMenu" />
        <div class="command-bar-actions" aria-label="File actions">
            <CommandButton CommandId="WorkbenchCommands.Open" Icon="SemanticIcon.OpenFile" OnInvoke="InvokeAsync" />
            <CommandButton CommandId="WorkbenchCommands.Save" Icon="SemanticIcon.Save" OnInvoke="InvokeAsync" />
        </div>
    </header>
    <div class="workbench-body">
        <div class="editor-workspace">
          <section class="editor-panel">
            <div class="editor-groups-root @(_status.IsComparing ? "hidden" : null) @(_draggedViewId is null && _draggedWorkspacePath is null ? null : "dragging")"
                 @ref="_editorGroupsRoot">
                <EditorGroupPane @key="_groups.Layout.Id" Node="_groups.Layout" Snapshot="_groups"
                                 OnGroupReady="GroupReadyAsync" OnActivate="ActivateTabAsync"
                                 OnPromote="PromoteTabAsync" OnClose="CloseGroupTabAsync"
                                 OnContextMenu="OpenTabContextAsync" OnDragStart="BeginTabDrag"
                                 OnDragEnd="EndTabDrag"
                                 OnDrop="DropTabAsync" OnEdgeDrop="DropTabAtEdgeAsync"
                                 OnResize="ResizeGroupsAsync" />
            </div>

            @if (_notifications.Count > 0)
            {
                <div class="notices">
                    @foreach (var notification in _notifications)
                    {
                        <div class="notice @Style(notification.Severity)" role="@Role(notification.Severity)">
                            <ShellIcon Name="@NoticeIcon(notification.Severity)" />
                            <span>@notification.Message</span>
                            @foreach (var action in notification.Actions)
                            {
                                <button type="button" @onclick="() => InvokeNotificationActionAsync(action)"
                                        disabled="@(action.DocumentId is null && !Workbench.Commands.IsEnabled(action.CommandId))">@action.Title</button>
                            }
                            <button type="button" class="dismiss" aria-label="Dismiss"
                                    @onclick="() => Workbench.Notifications.Dismiss(notification.Id)">
                                <ShellIcon Name="SemanticIcon.Close" />
                            </button>
                        </div>
                    }
                </div>
            }

            @if (_status.IsComparing)
            {
                <div class="editor-host comparison-host" @ref="_diffContainer"></div>
            }
          </section>
          @if (_panelVisible)
          {
              <section class="bottom-panel" aria-label="Bottom panel">
                  <header>
                      <strong>Panel</strong>
                      <span>Problems, output, terminal, and debug views arrive in their governing phases.</span>
                      <CommandButton CommandId="WorkbenchCommands.TogglePanel" Icon="SemanticIcon.Close" OnInvoke="InvokeAsync" />
                  </header>
              </section>
          }
        </div>
        <WorkspaceExplorer OpenFile="OpenWorkspaceFileAsync" PreviewFile="PreviewWorkspaceFileAsync"
                           OnDragStart="BeginWorkspaceDrag" OnDragEnd="EndWorkspaceDrag" />
        <ActivityRail OnInvoke="InvokeAsync" />
    </div>

    <footer class="status-bar" role="region" aria-label="Status">
        @if (_status.IsComparing)
        {
            <button type="button" class="status-item" @onclick="() => InvokeAsync(WorkbenchCommands.EndCompare)">Stop comparing</button>
        }
        @if (_status.IsOpen)
        {
            <button type="button" class="status-item" @onclick="() => InvokeAsync(WorkbenchCommands.ChooseLineEnding)">
                @LineEndingLabel(_status.LineEnding)@(_status.LineEndingsWereMixed ? " (mixed)" : null)
            </button>
            <button type="button" class="status-item" @onclick="() => InvokeAsync(WorkbenchCommands.ChooseEncoding)">
                @(_status.Encoding?.DisplayName ?? "Unknown")@(_status.DecodedWithFallback ? " (guessed)" : null)
            </button>
            @if (_status.IsReadOnly) { <span class="status-item badge">Read-only</span> }
        }
        @if (_groups.ActiveTab?.IsMissing == true) { <span class="status-item badge">Missing file</span> }
        @if (_contexts.Count > 1)
        {
            <label class="status-context">Project context
                <select aria-label="Active project context" value="@_contexts.FirstOrDefault(static context => context.IsActive)?.ProjectId.Id"
                        @onchange="SelectProjectContextAsync">
                    @foreach (var context in _contexts)
                    {
                        <option value="@context.ProjectId.Id">@context.ProjectName @context.TargetFramework</option>
                    }
                </select>
            </label>
        }
    </footer>

    @if (_lineEndingPickerOpen)
    {
        <div class="picker" role="dialog" aria-label="Line ending">
            <h2>Line ending</h2>
            <select @bind="_pickedLineEnding">
                <option value="@LineEndingStyle.Lf">LF — line feed</option>
                <option value="@LineEndingStyle.CrLf">CRLF — carriage return and line feed</option>
                <option value="@LineEndingStyle.Cr">CR — carriage return</option>
            </select>
            <div class="picker-actions">
                <button type="button" @onclick="SaveWithLineEndingAsync">Convert and save</button>
                <button type="button" @onclick="() => _lineEndingPickerOpen = false">Cancel</button>
            </div>
        </div>
    }

    @if (_encodingPickerOpen)
    {
        <div class="picker" role="dialog" aria-label="File encoding">
            <h2>File encoding</h2>
            <select @bind="_pickedEncodingId" size="12">
                <optgroup label="Favourites">
                    @foreach (var profile in Favorites) { <option value="@profile.Id">@EncodingLabel(profile)</option> }
                </optgroup>
                <optgroup label="All encodings">
                    @foreach (var profile in TextEncodings.All) { <option value="@profile.Id">@EncodingLabel(profile)</option> }
                </optgroup>
            </select>
            <p class="picker-hint">Reopening re-reads the file. Converting writes the editor text in the selected encoding.</p>
            <div class="picker-actions">
                <button type="button" @onclick="ReopenWithEncodingAsync" disabled="@_status.IsDirty">Reopen with</button>
                <button type="button" @onclick="SaveWithEncodingAsync">Convert and save</button>
                <button type="button" @onclick="() => _encodingPickerOpen = false">Cancel</button>
            </div>
        </div>
    }

    @if (_editorFontPickerOpen)
    {
        <div class="picker" role="dialog" aria-label="Editor font">
            <h2>Editor font</h2>
            <select @bind="_pickedEditorFont">
                <option value="@EditorFontPreference.Default">@EditorFonts.DisplayName(EditorFontPreference.Default)</option>
                <option value="@EditorFontPreference.FastMono">@EditorFonts.DisplayName(EditorFontPreference.FastMono)</option>
            </select>
            <p class="picker-hint">Applies to source editors and comparisons, and is saved in your user settings.</p>
            <div class="picker-actions">
                <button type="button" @onclick="SaveEditorFontAsync">Apply</button>
                <button type="button" @onclick="() => _editorFontPickerOpen = false">Cancel</button>
            </div>
        </div>
    }

    <CommandPalette Open="_commandPaletteOpen" Commands="PaletteCommands"
                    OnInvoke="InvokePaletteCommandAsync" OnClose="CloseCommandPalette" />
    @if (_tabContextOpen)
    {
        <ContextCommandMenu AccessibleName="Editor tab actions" Commands="TabContextCommands"
                            X="_tabContextX" Y="_tabContextY" OnInvoke="InvokeAsync" OnClose="CloseTabContext" />
    }
</main>

@code {
    private const string OverflowMenuId = "application";
    private static readonly string[] MenuCategories = ["File", "Workspace", "View"];
    private readonly List<IDisposable> _registrations = [];
    private ElementReference _diffContainer;
    private ElementReference _editorGroupsRoot;
    private IEditorHost? _host;
    private DocumentRegistry? _documents;
    private EditorGroupManager? _groupManager;
    private DocumentSession? _smokeSession;
    private DocumentTabsSnapshot _tabs = new([]);
    private DocumentStatus _status = new();
    private IReadOnlyList<Notification> _notifications = [];
    private bool _diffAttached;
    private bool _dragSurfaceAttached;
    private string? _draggedViewId;
    private string? _draggedWorkspacePath;
    private bool _encodingPickerOpen;
    private bool _lineEndingPickerOpen;
    private bool _editorFontPickerOpen;
    private bool _commandPaletteOpen;
    private bool _panelVisible;
    private bool _tabContextOpen;
    private string? _tabContextViewId;
    private string? _openCommandMenu;
    private double _tabContextX;
    private double _tabContextY;
    private string _pickedEncodingId = TextEncodings.Utf8.Id;
    private LineEndingStyle _pickedLineEnding = LineEndingStyle.Lf;
    private EditorFontPreference _pickedEditorFont = EditorFontPreference.Default;
    private FrozenDictionary<string, bool> _representable = FrozenDictionary<string, bool>.Empty;
    private IReadOnlyList<RoslynDocumentContext> _contexts = [];
    private DotNetObjectReference<EditorPanel>? _shellBridge;
    private EditorGroupsSnapshot _groups = EmptyGroups();

    private DocumentSession? Active => _documents?.ActiveDocument;
    private static IEnumerable<TextEncodingProfile> Favorites =>
        TextEncodings.Favorites.Select(TextEncodings.Find).OfType<TextEncodingProfile>();
    private IReadOnlyList<CommandDescriptor> PaletteCommands => Workbench.Commands.Commands;
    private IReadOnlyList<CommandDescriptor> MenuCommands(string category) => PaletteCommands
        .Where(command => command.ShowInPalette && command.Category == category)
        .ToArray();
    private IReadOnlyList<CommandDescriptor> TabContextCommands =>
        new[] { WorkbenchCommands.Close, WorkbenchCommands.CloseOthers, WorkbenchCommands.CloseRight, WorkbenchCommands.CloseSaved, WorkbenchCommands.PinTab }
            .Select(Workbench.Commands.Find).OfType<CommandDescriptor>().ToArray();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_dragSurfaceAttached)
        {
            await JSRuntime.InvokeVoidAsync("NovaEditorGroups.attachDragSurface", _editorGroupsRoot);
            _dragSurfaceAttached = true;
        }
        if (_status.IsComparing && !_diffAttached) await AttachComparisonAsync();
    }

    private async Task GroupReadyAsync((string GroupId, ElementReference Container) ready)
    {
        if (_host is null && ready.GroupId == EditorGroupManager.MainGroupId)
        {
            await StartAsync(ready.Container);
            return;
        }
        if (_groupManager is not null)
            await _groupManager.RegisterGroupAsync(ready.GroupId, ready.Container);
    }

    private async Task StartAsync(ElementReference editorContainer)
    {
        var host = new MonacoEditorHost(JSRuntime);
        Workbench.Notifications.Changed += OnNotificationsChanged;
        try
        {
            if (NativeSmokeTest.IsEnabled)
            {
                var session = Workbench.CreateSession(host);
                await host.InitializeAsync(editorContainer,
                    new EditorBridge(session.Replicate, session.RequestResync, InvokeAsync), CancellationToken.None);
                _host = host;
                _smokeSession = session;
                _shellBridge = DotNetObjectReference.Create(this);
                await JSRuntime.InvokeVoidAsync(
                    "NovaWorkbench.initialize", _shellBridge, Array.Empty<CommandDescriptor>(), WorkbenchCommands.ShowCommandPalette);
                await NativeSmokeTest.RunAsync(session, host);
                return;
            }

            var documents = Workbench.CreateDocumentRegistry(host);
            await host.InitializeAsync(editorContainer,
                new EditorBridge(documents.Replicate, documents.RequestResync, InvokeAsync), CancellationToken.None);
            _host = host;
            _documents = documents;
            Workbench.Documents = documents;
            documents.Changed += OnTabsChanged;
            Workbench.Configuration.Changed += OnConfigurationChanged;
            Workbench.Solutions.Changed += OnSolutionChanged;
            RegisterCommands();

            _shellBridge = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync(
                "NovaWorkbench.initialize", _shellBridge, Workbench.Commands.Commands, WorkbenchCommands.ShowCommandPalette);

            var unresolved = await host.RegisterCommandsAsync(Workbench.Commands.Commands, CancellationToken.None);
            if (unresolved.Count > 0)
                Workbench.Notifications.Raise("novasharp.commands.unresolvedKeybinding", NotificationSeverity.Warning,
                    $"These shortcuts could not be bound: {string.Join(", ", unresolved)}");

            await Workbench.LoadConfigurationAsync();
            await host.SetEditorFontAsync(Workbench.Configuration.Current.Settings.EditorFont, CancellationToken.None);
            await documents.RestoreAsync();
            _tabs = documents.Snapshot;
            var groups = new EditorGroupManager(host, documents, Workbench.WorkspacePersistence, Workbench.Notifications);
            groups.Changed += OnGroupsChanged;
            _groupManager = groups;
            await groups.RestoreAsync();
            _groups = groups.Snapshot;
            _status = documents.ActiveDocument?.Status ?? new();
            RefreshProjectContexts();
        }
        catch (Exception exception) when (exception is JSException or JSDisconnectedException)
        {
            Workbench.Notifications.Raise("novasharp.editor.startFailed", NotificationSeverity.Error,
                $"The editor could not start: {exception.Message}");
        }
        _notifications = Workbench.Notifications.Active;
        StateHasChanged();
    }

    private void RegisterCommands()
    {
        void Register(string id, Func<CancellationToken, Task> handler, Func<bool>? enabled = null) =>
            _registrations.Add(Workbench.Commands.Register(WorkbenchCommands.Describe(id), handler, enabled));

        Register(WorkbenchCommands.Open, _ => OpenFileAsync(), () => !_status.IsBusy && !_status.IsComparing);
        Register(WorkbenchCommands.Save, _ => SaveAsync(), () => _status.IsOpen && !_status.IsBusy);
        Register(WorkbenchCommands.SaveAs, _ => SaveAsAsync(), () => _status.IsOpen && !_status.IsBusy);
        Register(WorkbenchCommands.Reload, _ => ReloadAsync(), () => _status.IsOpen && !_status.IsBusy);
        Register(WorkbenchCommands.Compare, _ => BeginCompareAsync(), () => _status.IsOpen && !_status.IsComparing);
        Register(WorkbenchCommands.EndCompare, _ => EndCompareAsync(), () => _status.IsComparing);
        Register(WorkbenchCommands.KeepEditorText, token => Active?.ResolveExternalChangeAsync(ExternalChangeChoice.Keep, token) ?? Task.CompletedTask, () => _status.IsOpen);
        Register(WorkbenchCommands.ChooseEncoding, _ => ToggleEncodingPickerAsync(), () => _status.IsOpen);
        Register(WorkbenchCommands.ChooseLineEnding, _ => { ToggleLineEndingPicker(); return Task.CompletedTask; }, () => _status.IsOpen);
        Register(WorkbenchCommands.Close, token => CloseKindAsync(DocumentCloseKind.One, token), () => _groups.ActiveTab is not null);
        Register(WorkbenchCommands.CloseOthers, token => CloseKindAsync(DocumentCloseKind.Others, token), () => _groups.ActiveGroup.Tabs.Count > 1);
        Register(WorkbenchCommands.CloseRight, token => CloseKindAsync(DocumentCloseKind.Right, token), () => ActiveIndex >= 0 && ActiveIndex < _groups.ActiveGroup.Tabs.Count - 1);
        Register(WorkbenchCommands.CloseSaved, token => CloseKindAsync(DocumentCloseKind.Saved, token), () => _groups.ActiveGroup.Tabs.Any(tab => !tab.IsDirty));
        Register(WorkbenchCommands.CloseAll, token => CloseKindAsync(DocumentCloseKind.All, token), () => _groups.ActiveGroup.Tabs.Count > 0);
        Register(WorkbenchCommands.MoveTabLeft, token => MoveActiveAsync(-1, token), () => ActiveIndex > 0);
        Register(WorkbenchCommands.MoveTabRight, token => MoveActiveAsync(1, token), () => ActiveIndex >= 0 && ActiveIndex < _groups.ActiveGroup.Tabs.Count - 1);
        Register(WorkbenchCommands.PreviousTab, token => CycleAsync(-1, token), () => _groups.ActiveGroup.Tabs.Count > 1);
        Register(WorkbenchCommands.NextTab, token => CycleAsync(1, token), () => _groups.ActiveGroup.Tabs.Count > 1);
        Register(WorkbenchCommands.PinTab, token => _groups.ActiveTab is { } tab ? _documents!.PromoteAsync(tab.DocumentId, token) : Task.CompletedTask, () => _groups.ActiveTab?.IsPreview == true);
        Register(WorkbenchCommands.ShowCommandPalette, _ => { ShowCommandPalette(); return Task.CompletedTask; });
        Register(WorkbenchCommands.TogglePanel, _ => { _panelVisible = !_panelVisible; StateHasChanged(); return Task.CompletedTask; });
        Register(WorkbenchCommands.ChooseEditorFont, _ => { ToggleEditorFontPicker(); return Task.CompletedTask; });
        Register(WorkbenchCommands.SplitEditorLeft, token => _groupManager?.SplitAsync(EditorSplitDirection.Left, token) ?? Task.CompletedTask, CanSplit);
        Register(WorkbenchCommands.SplitEditorRight, token => _groupManager?.SplitAsync(EditorSplitDirection.Right, token) ?? Task.CompletedTask, CanSplit);
        Register(WorkbenchCommands.SplitEditorUp, token => _groupManager?.SplitAsync(EditorSplitDirection.Up, token) ?? Task.CompletedTask, CanSplit);
        Register(WorkbenchCommands.SplitEditorDown, token => _groupManager?.SplitAsync(EditorSplitDirection.Down, token) ?? Task.CompletedTask, CanSplit);
        Register(WorkbenchCommands.FocusPreviousGroup, token => _groupManager?.FocusRelativeAsync(-1, token) ?? Task.CompletedTask, () => _groups.Groups.Count > 1);
        Register(WorkbenchCommands.FocusNextGroup, token => _groupManager?.FocusRelativeAsync(1, token) ?? Task.CompletedTask, () => _groups.Groups.Count > 1);
        Register(WorkbenchCommands.MoveEditorToNextGroup, token => _groupManager?.TransferActiveToRelativeGroupAsync(false, token) ?? Task.CompletedTask, () => _groups.Groups.Count > 1 && _groups.ActiveTab is not null);
        Register(WorkbenchCommands.CopyEditorToNextGroup, token => _groupManager?.TransferActiveToRelativeGroupAsync(true, token) ?? Task.CompletedTask, () => _groups.Groups.Count > 1 && _groups.ActiveTab is not null);
        Register(WorkbenchCommands.CloseEditorGroup, token => CloseActiveGroupAsync(token), () => _groups.Groups.Count > 1);
        Register(WorkbenchCommands.DistributeEditorGroups, token => _groupManager?.DistributeEvenlyAsync(token) ?? Task.CompletedTask, () => _groups.Groups.Count > 1);

        bool CanSplit() => _groups.ActiveTab is not null && !_status.IsComparing;
    }

    [JSInvokable]
    public Task InvokeShellCommandAsync(string commandId) => InvokeAsync(commandId);

    [JSInvokable]
    public void DismissCommandMenusAsync()
    {
        if (_openCommandMenu is null) return;
        CloseCommandMenu();
        StateHasChanged();
    }

    private void ShowCommandPalette()
    {
        CloseCommandMenu();
        _commandPaletteOpen = true;
        _encodingPickerOpen = false;
        _lineEndingPickerOpen = false;
        _editorFontPickerOpen = false;
        StateHasChanged();
    }

    private void CloseCommandPalette() => _commandPaletteOpen = false;
    private void OpenCommandMenu(string menu) => _openCommandMenu = menu;
    private void CloseCommandMenu() => _openCommandMenu = null;

    private async Task InvokePaletteCommandAsync(string commandId)
    {
        _commandPaletteOpen = false;
        await InvokeAsync(commandId);
    }

    private async Task InvokeAsync(string commandId)
    {
        var result = await Workbench.Commands.InvokeAsync(commandId);
        if (result.Outcome is CommandOutcome.Failed or CommandOutcome.Unknown)
            Workbench.Notifications.Raise($"novasharp.commands.failed:{commandId}", NotificationSeverity.Error,
                result.Message ?? $"{commandId} failed.");
    }

    private async Task InvokeNotificationActionAsync(NotificationAction action)
    {
        if (action.DocumentId is { } id)
        {
            var tab = _groups.Groups.Values.SelectMany(group => group.Tabs)
                .FirstOrDefault(tab => tab.DocumentId == id);
            if (tab is not null)
            {
                var group = _groups.Groups.Values.First(candidate => candidate.Tabs.Contains(tab));
                await ActivateTabAsync(new(group.Id, tab.ViewId));
            }
        }
        await InvokeAsync(action.CommandId);
    }

    private void OnTabsChanged(DocumentTabsSnapshot tabs) => _ = InvokeAsync(() =>
    {
        var wasComparing = _status.IsComparing;
        _tabs = tabs;
        _status = _documents?.ActiveDocument?.Status ?? new();
        RefreshProjectContexts();
        if (wasComparing && !_status.IsComparing) _diffAttached = false;
        StateHasChanged();
    });

    private void OnGroupsChanged(EditorGroupsSnapshot groups) => _ = InvokeAsync(() =>
    {
        _groups = groups;
        _status = _documents?.ActiveDocument?.Status ?? new();
        RefreshProjectContexts();
        StateHasChanged();
    });

    private void OnSolutionChanged(SolutionWorkspaceSnapshot snapshot) => _ = InvokeAsync(() =>
    {
        var previous = _contexts;
        RefreshProjectContexts();
        if (_contexts.SequenceEqual(previous)) return;
        StateHasChanged();
    });

    private void RefreshProjectContexts() => _contexts = Active?.DocumentUri is { } uri
        ? Workbench.Solutions.GetDocumentContexts(uri)
        : [];

    private async Task SelectProjectContextAsync(ChangeEventArgs args)
    {
        if (Active?.DocumentUri is not { } uri || args.Value is not string id) return;
        var context = _contexts.FirstOrDefault(item => item.ProjectId.Id.ToString() == id);
        if (context is null) return;
        await Workbench.Solutions.SetActiveContextAsync(uri, context.ProjectId);
        RefreshProjectContexts();
    }

    private void OnNotificationsChanged(IReadOnlyList<Notification> notifications) => _ = InvokeAsync(() =>
    {
        _notifications = notifications;
        StateHasChanged();
    });

    private void OnConfigurationChanged(SettingsResolution resolution) => _ = InvokeAsync(async () =>
    {
        _pickedEditorFont = resolution.Settings.EditorFont;
        if (_host is not null)
            await _host.SetEditorFontAsync(resolution.Settings.EditorFont, CancellationToken.None);
        StateHasChanged();
    });

    private async Task OpenFileAsync()
    {
        if (_documents is null) return;
        var files = await Program.App.MainWindow.ShowOpenFileAsync(
            title: "Open file",
            multiSelect: false,
            filters: [("C# source", ["cs"]), ("All files", ["*"])]);
        if (files is [var path])
        {
            await EndCompareAsync();
            if (_groupManager is not null) await _groupManager.OpenPinnedAsync(path);
        }
    }

    private async Task OpenWorkspaceFileAsync(string path)
    {
        await EndCompareAsync();
        if (_groupManager is not null) await _groupManager.OpenPinnedAsync(path);
    }

    private async Task PreviewWorkspaceFileAsync(string path)
    {
        await EndCompareAsync();
        if (_groupManager is not null) await _groupManager.OpenPreviewAsync(path);
    }

    private async Task ActivateTabAsync(EditorGroupTabEvent tab)
    {
        await EndCompareAsync();
        if (_groupManager is not null)
        {
            await _groupManager.ActivateAsync(tab.GroupId, tab.ViewId);
            _tabs = _documents!.Snapshot;
            _status = _documents.ActiveDocument?.Status ?? new();
        }
    }

    private Task PromoteTabAsync(EditorGroupTabEvent tab)
    {
        var documentId = _groups.Groups[tab.GroupId].Tabs.First(candidate => candidate.ViewId == tab.ViewId).DocumentId;
        return _documents?.PromoteAsync(documentId) ?? Task.CompletedTask;
    }

    private async Task OpenTabContextAsync((EditorGroupTabEvent Tab, MouseEventArgs Mouse) context)
    {
        await ActivateTabAsync(context.Tab);
        _tabContextViewId = context.Tab.ViewId;
        _tabContextX = context.Mouse.ClientX;
        _tabContextY = context.Mouse.ClientY;
        _tabContextOpen = true;
    }

    private void CloseTabContext()
    {
        _tabContextOpen = false;
        _tabContextViewId = null;
    }

    private void BeginTabDrag(EditorGroupTabEvent tab)
    {
        _draggedViewId = tab.ViewId;
    }

    private void EndTabDrag() => _draggedViewId = null;

    private void BeginWorkspaceDrag(WorkspaceNode node)
    {
        _draggedWorkspacePath = node.Kind is WorkspaceNodeKind.SupportedFile or WorkspaceNodeKind.UnknownFile
            ? node.Path
            : null;
    }

    private void EndWorkspaceDrag() => _draggedWorkspacePath = null;

    private async Task DropTabAsync(EditorGroupDropEvent drop)
    {
        if (_groupManager is null) return;
        var viewId = _draggedViewId;
        var workspacePath = _draggedWorkspacePath
            ?? await JSRuntime.InvokeAsync<string?>("NovaEditorGroups.takeDroppedWorkspaceFile", _editorGroupsRoot);
        _draggedViewId = null;
        _draggedWorkspacePath = null;
        if (viewId is not null)
        {
            if (drop.Copy) await _groupManager.CopyViewAsync(viewId, drop.TargetGroupId, drop.TargetIndex);
            else await _groupManager.MoveViewAsync(viewId, drop.TargetGroupId, drop.TargetIndex);
        }
        else if (workspacePath is not null)
        {
            await _groupManager.OpenPinnedInGroupAsync(workspacePath, drop.TargetGroupId, drop.TargetIndex);
        }
    }

    private async Task DropTabAtEdgeAsync(EditorGroupEdgeDropEvent drop)
    {
        if (_groupManager is null) return;
        var viewId = _draggedViewId;
        var workspacePath = _draggedWorkspacePath
            ?? await JSRuntime.InvokeAsync<string?>("NovaEditorGroups.takeDroppedWorkspaceFile", _editorGroupsRoot);
        _draggedViewId = null;
        _draggedWorkspacePath = null;
        if (viewId is not null)
            await _groupManager.SplitViewAsync(viewId, drop.TargetGroupId, drop.Direction, drop.Copy);
        else if (workspacePath is not null)
            await _groupManager.OpenPinnedAtEdgeAsync(workspacePath, drop.TargetGroupId, drop.Direction);
    }

    private Task ResizeGroupsAsync(EditorSplitResizeEvent resize) =>
        _groupManager?.ResizeAsync(resize.SplitId, resize.Ratio) ?? Task.CompletedTask;

    private Task CloseGroupTabAsync(EditorGroupTabEvent tab) => CloseViewsAsync([tab.ViewId]);

    private Task CloseKindAsync(DocumentCloseKind kind, CancellationToken token)
    {
        var group = _groups.ActiveGroup;
        var activeIndex = group.Tabs.ToList().FindIndex(tab => tab.ViewId == group.ActiveViewId);
        IEnumerable<EditorGroupTabSnapshot> selected = kind switch
        {
            DocumentCloseKind.One => group.Tabs.Where(tab => tab.ViewId == group.ActiveViewId),
            DocumentCloseKind.Others => group.Tabs.Where(tab => tab.ViewId != group.ActiveViewId),
            DocumentCloseKind.Right => group.Tabs.Skip(activeIndex + 1),
            DocumentCloseKind.Saved => group.Tabs.Where(tab => !tab.IsDirty),
            DocumentCloseKind.All => group.Tabs,
            _ => [],
        };
        return CloseViewsAsync(selected.Select(tab => tab.ViewId).ToArray(), token);
    }

    private async Task CloseViewsAsync(IReadOnlyList<string> viewIds, CancellationToken token = default)
    {
        if (_groupManager is null || viewIds.Count == 0) return;
        var candidates = _groups.Groups.Values.SelectMany(group => group.Tabs)
            .Where(tab => viewIds.Contains(tab.ViewId, StringComparer.Ordinal)).ToArray();
        var dirty = candidates.Where(tab => tab.IsDirty && _groupManager.ViewCount(tab.DocumentId) == 1).ToArray();
        if (dirty.Length > 0)
        {
            var list = string.Join("\n", dirty.Select(tab => $"• {tab.Label}"));
            var answer = await Program.App.MainWindow.ShowMessageAsync("NovaSharp",
                $"Close and discard changes in these documents?\n\n{list}",
                PhotinoDialogButtons.YesNo, PhotinoDialogIcon.Warning);
            if (answer != PhotinoDialogResult.Yes) return;
        }
        await EndCompareAsync();
        foreach (var viewId in viewIds)
            await _groupManager.CloseViewAsync(viewId, discardDirty: true, token);
    }

    private async Task CloseActiveGroupAsync(CancellationToken token)
    {
        if (_groupManager is null) return;
        var dirty = _groups.ActiveGroup.Tabs
            .Where(tab => tab.IsDirty && _groupManager.ViewCount(tab.DocumentId) == 1).ToArray();
        if (dirty.Length > 0)
        {
            var list = string.Join("\n", dirty.Select(tab => $"• {tab.Label}"));
            var answer = await Program.App.MainWindow.ShowMessageAsync("NovaSharp",
                $"Close this group and discard changes in these documents?\n\n{list}",
                PhotinoDialogButtons.YesNo, PhotinoDialogIcon.Warning);
            if (answer != PhotinoDialogResult.Yes) return;
        }
        await EndCompareAsync();
        await _groupManager.CloseActiveGroupAsync(discardDirty: true, token);
    }

    private Task MoveActiveAsync(int offset, CancellationToken token) =>
        _groups.ActiveTab is { } tab
            ? _groupManager!.MoveViewAsync(tab.ViewId, _groups.ActiveGroupId,
                _groups.ActiveGroup.Tabs.ToList().FindIndex(candidate => candidate.ViewId == tab.ViewId)
                    + (offset < 0 ? -1 : 2), token)
            : Task.CompletedTask;

    private async Task CycleAsync(int offset, CancellationToken token)
    {
        var group = _groups.ActiveGroup;
        if (group.Tabs.Count == 0) return;
        var current = group.Tabs.ToList().FindIndex(tab => tab.ViewId == group.ActiveViewId);
        var tab = group.Tabs[(current + offset + group.Tabs.Count) % group.Tabs.Count];
        await _groupManager!.ActivateAsync(group.Id, tab.ViewId, token);
    }

    private int ActiveIndex => _groups.ActiveGroup.Tabs.ToList().FindIndex(tab => tab.ViewId == _groups.ActiveGroup.ActiveViewId);

    private async Task SaveAsync()
    {
        if (Active is not { } session) return;
        var result = await session.SaveAsync();
        if (result?.Status != DocumentSaveStatus.ExternallyChanged) return;
        var answer = await Program.App.MainWindow.ShowMessageAsync("NovaSharp",
            $"{_status.DisplayName} changed on disk. Overwrite it with the editor text?",
            PhotinoDialogButtons.YesNo, PhotinoDialogIcon.Warning);
        if (answer == PhotinoDialogResult.Yes) await session.SaveAsync(overwriteExternalChange: true);
    }

    private async Task SaveAsAsync()
    {
        if (Active is not { } session) return;
        var path = await Program.App.MainWindow.ShowSaveFileAsync("Save as", filters: [("C# source", ["cs"]), ("All files", ["*"])]);
        if (string.IsNullOrWhiteSpace(path)) return;
        var existing = _tabs.Tabs.FirstOrDefault(tab => !tab.IsActive && Workbench.Paths.IsSamePath(tab.Path, path));
        if (existing is not null)
        {
            Workbench.Notifications.Raise("novasharp.documents.saveAsOpen", NotificationSeverity.Warning,
                $"{existing.Label} is already open in another tab.");
            var view = _groups.Groups.Values.SelectMany(group => group.Tabs)
                .First(tab => tab.DocumentId == existing.Id);
            var group = _groups.Groups.Values.First(candidate => candidate.Tabs.Contains(view));
            await ActivateTabAsync(new(group.Id, view.ViewId));
            return;
        }
        await EndCompareAsync();
        await session.SaveAsAsync(path);
    }

    private async Task ReloadAsync()
    {
        if (Active is not { } session) return;
        if (_status.IsDirty)
        {
            var answer = await Program.App.MainWindow.ShowMessageAsync("NovaSharp",
                $"Reload {_status.DisplayName} and discard its unsaved changes?",
                PhotinoDialogButtons.YesNo, PhotinoDialogIcon.Warning);
            if (answer != PhotinoDialogResult.Yes) return;
        }
        await EndCompareAsync();
        await session.ReloadAsync();
    }

    private Task BeginCompareAsync() => Active?.SetComparingAsync(true) ?? Task.CompletedTask;

    private async Task AttachComparisonAsync()
    {
        if (Active is not { } session || _host is null) return;
        _diffAttached = true;
        var original = await session.ReadFileTextAsync();
        if (original is null) { _diffAttached = false; await session.SetComparingAsync(false); return; }
        await _host.BeginCompareAsync(_diffContainer, original, CancellationToken.None);
    }

    private async Task EndCompareAsync()
    {
        if (_host is null || !_status.IsComparing) return;
        await _host.EndCompareAsync(CancellationToken.None);
        _diffAttached = false;
        if (Active is { } session) await session.SetComparingAsync(false);
    }

    private void ToggleLineEndingPicker()
    {
        _pickedLineEnding = _status.LineEnding;
        _lineEndingPickerOpen = !_lineEndingPickerOpen;
        _encodingPickerOpen = false;
        _editorFontPickerOpen = false;
    }

    private async Task SaveWithLineEndingAsync()
    {
        _lineEndingPickerOpen = false;
        if (Active is { } session) await session.SaveWithLineEndingAsync(_pickedLineEnding);
    }

    private async Task ToggleEncodingPickerAsync()
    {
        _lineEndingPickerOpen = false;
        _editorFontPickerOpen = false;
        _encodingPickerOpen = !_encodingPickerOpen;
        if (!_encodingPickerOpen || Active is not { } session) return;
        _pickedEncodingId = _status.Encoding?.Id ?? TextEncodings.Utf8.Id;
        var text = session.Replica?.Snapshot().Text ?? string.Empty;
        _representable = await Workbench.RunInBackgroundAsync(
            _ => Task.FromResult(EncodingCompatibility.Evaluate(TextEncodings.All, text)));
    }

    private async Task ReopenWithEncodingAsync()
    {
        _encodingPickerOpen = false;
        if (Active is { } session && TextEncodings.Find(_pickedEncodingId) is { } encoding)
            await session.ReloadAsync(encoding);
    }

    private async Task SaveWithEncodingAsync()
    {
        _encodingPickerOpen = false;
        if (Active is { } session && TextEncodings.Find(_pickedEncodingId) is { } encoding)
            await session.SaveWithEncodingAsync(encoding);
    }

    private void ToggleEditorFontPicker()
    {
        _pickedEditorFont = Workbench.Configuration.Current.Settings.EditorFont;
        _editorFontPickerOpen = !_editorFontPickerOpen;
        _encodingPickerOpen = false;
        _lineEndingPickerOpen = false;
    }

    private async Task SaveEditorFontAsync()
    {
        _editorFontPickerOpen = false;
        var resolution = await Workbench.Configuration.SetUserEditorFontAsync(_pickedEditorFont);
        if (_host is not null)
            await _host.SetEditorFontAsync(resolution.Settings.EditorFont, CancellationToken.None);
    }

    private string EncodingLabel(TextEncodingProfile profile) =>
        _representable.TryGetValue(profile.Id, out var ok) && !ok ? $"Cannot represent — {profile.DisplayName}" : profile.DisplayName;
    private static string LineEndingLabel(LineEndingStyle style) => style switch { LineEndingStyle.CrLf => "CRLF", LineEndingStyle.Cr => "CR", _ => "LF" };
    private static string? Style(NotificationSeverity severity) => severity switch { NotificationSeverity.Error => "error", NotificationSeverity.Warning => "conflict", _ => null };
    private static string Role(NotificationSeverity severity) => severity == NotificationSeverity.Information ? "status" : "alert";
    private static SemanticIcon NoticeIcon(NotificationSeverity severity) => severity switch
    {
        NotificationSeverity.Error => SemanticIcon.Error,
        NotificationSeverity.Warning => SemanticIcon.Warning,
        _ => SemanticIcon.Information,
    };

    private static EditorGroupsSnapshot EmptyGroups()
    {
        var group = new EditorGroupSnapshot(EditorGroupManager.MainGroupId, [], null, true);
        return new EditorGroupsSnapshot(
            new EditorGroupNodeSnapshot(EditorGroupManager.MainGroupId),
            new Dictionary<string, EditorGroupSnapshot>(StringComparer.Ordinal)
            {
                [EditorGroupManager.MainGroupId] = group,
            },
            EditorGroupManager.MainGroupId);
    }

    public async ValueTask DisposeAsync()
    {
        Workbench.Notifications.Changed -= OnNotificationsChanged;
        Workbench.Configuration.Changed -= OnConfigurationChanged;
        try { await JSRuntime.InvokeVoidAsync("NovaWorkbench.dispose"); }
        catch (JSDisconnectedException) { }
        if (_dragSurfaceAttached)
        {
            try { await JSRuntime.InvokeVoidAsync("NovaEditorGroups.detachDragSurface", _editorGroupsRoot); }
            catch (JSDisconnectedException) { }
            _dragSurfaceAttached = false;
        }
        _shellBridge?.Dispose();
        _shellBridge = null;
        foreach (var registration in _registrations) registration.Dispose();
        _registrations.Clear();
        if (_groupManager is not null)
        {
            _groupManager.Changed -= OnGroupsChanged;
            await _groupManager.DisposeAsync();
            _groupManager = null;
        }
        if (_documents is not null)
        {
            _documents.Changed -= OnTabsChanged;
            Workbench.Solutions.Changed -= OnSolutionChanged;
            await _documents.DisposeAsync();
            if (ReferenceEquals(Workbench.Documents, _documents)) Workbench.Documents = null;
            _documents = null;
        }
        if (_smokeSession is not null) { await _smokeSession.DisposeAsync(); _smokeSession = null; }
        if (_host is not null) { await _host.DisposeAsync(); _host = null; }
    }
}
