@if (Node.Items.Length > 0)
{
    <details class="project-node" open="@(Node.Kind is ProjectNodeKind.Solution or ProjectNodeKind.Project)">
        <summary class="tree-row" title="@Node.Path"
                 data-file-path="@(Node.Kind is ProjectNodeKind.Project or ProjectNodeKind.Solution ? Node.Path : null)"
                 @ondblclick="OpenAsync"
                 @oncontextmenu="ShowContextMenuAsync" @oncontextmenu:preventDefault @oncontextmenu:stopPropagation>
            <span class="tree-toggle @IconClass" aria-hidden="true">@Icon</span>
            <span class="tree-name">@Node.Name</span>
            @if (Node.Detail is not null) { <span class="project-detail">@Node.Detail</span> }
        </summary>
        <div role="group">
            @foreach (var child in Node.Items)
            {
                <ProjectTreeNodeView Node="child" FileOpened="FileOpened" ContextRequested="ContextRequested" />
            }
        </div>
    </details>
}
else
{
    <button class="tree-row project-leaf" title="@Node.Path"
            data-file-path="@(Node.Kind == ProjectNodeKind.File ? Node.Path : null)"
            disabled="@(Node.Path is null || Node.Kind == ProjectNodeKind.GeneratedFile)" @onclick="OpenAsync"
            @oncontextmenu="ShowContextMenuAsync" @oncontextmenu:preventDefault @oncontextmenu:stopPropagation>
        <span class="tree-toggle @IconClass" aria-hidden="true">@Icon</span>
        <span class="tree-name">@Node.Name</span>
    </button>
}

@code {
    [Parameter, EditorRequired] public ProjectNode Node { get; set; } = null!;
    [Parameter] public EventCallback<string> FileOpened { get; set; }
    [Parameter] public EventCallback<ProjectNodeContextRequest> ContextRequested { get; set; }
    private string Icon => Node.Kind switch
    {
        ProjectNodeKind.Solution => "SLN", ProjectNodeKind.Project => "C#",
        ProjectNodeKind.Folder when Node.Name == "Dependencies" => "◇", ProjectNodeKind.Folder => "📁",
        ProjectNodeKind.File => ExplorerFileIcons.Text(Node.Name), ProjectNodeKind.GeneratedFile => "G#", ProjectNodeKind.ProjectReference => "↗",
        ProjectNodeKind.Analyzer => "A", _ => "◇"
    };
    private string IconClass => Node.Kind switch
    {
        ProjectNodeKind.Solution => "file-icon solution", ProjectNodeKind.Project => "file-icon csharp",
        ProjectNodeKind.File => $"file-icon {ExplorerFileIcons.CssClass(Node.Name)}", ProjectNodeKind.GeneratedFile => "file-icon csharp",
        ProjectNodeKind.Folder => "folder-icon", ProjectNodeKind.Analyzer => "file-icon props",
        _ => "file-icon assembly"
    };
    private Task OpenAsync() => Node is { Kind: ProjectNodeKind.File or ProjectNodeKind.Project or ProjectNodeKind.Solution, Path: { } path }
        ? FileOpened.InvokeAsync(path) : Task.CompletedTask;
    private Task ShowContextMenuAsync(MouseEventArgs args) => Node.Path is null ? Task.CompletedTask
        : ContextRequested.InvokeAsync(new(Node, args.ClientX, args.ClientY));
}
