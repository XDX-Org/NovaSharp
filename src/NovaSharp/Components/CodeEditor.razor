@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="code-editor @(WordWrap ? "word-wrap" : null) @(SemanticPending ? "semantic-pending" : null)"
     data-language="@LanguageInfo.LanguageId" @ref="_root">
    @if (_outlineOpen)
    {
        <div class="outline-popup language-popup" role="dialog" aria-label="Document outline">
            @foreach (var symbol in _symbols)
            {
                <button @onclick="() => NavigateSymbolAsync(symbol)"><span>@symbol.Name</span><small>@symbol.Kind</small></button>
            }
        </div>
    }
    <div class="presentation" aria-hidden="true">
        @if (WordWrap)
        {
            @foreach (var line in Lines) { <SourceLineView Line="line" Diagnostics="DiagnosticsFor(line)" @key="line.Number" /> }
        }
        else
        {
            <Virtualize TItem="EditorLine" Items="@Lines" Context="line" ItemSize="20" OverscanCount="32">
                <SourceLineView Line="line" Diagnostics="DiagnosticsFor(line)" />
            </Virtualize>
        }
    </div>
    <textarea class="editor-input" aria-label="File contents" autocomplete="off" autocorrect="off"
              autocapitalize="off" spellcheck="false" wrap="off" value="@Value"></textarea>
    <div class="diagnostic-overview" aria-hidden="true">
        @foreach (var diagnostic in _diagnostics)
        {
            <span class="overview-mark @diagnostic.Severity.ToString().ToLowerInvariant()"
                  style="top:@OverviewTop(diagnostic)"></span>
        }
    </div>
    <div class="diagnostic-accessibility" aria-label="Editor diagnostics">
        @foreach (var diagnostic in _diagnostics.Where(item => item.Severity != LanguageDiagnosticSeverity.Hidden))
        {
            <button title="Navigate to diagnostic" @onclick="() => NavigateDiagnosticAsync(diagnostic)">
                @diagnostic.Severity @diagnostic.Id at line @(diagnostic.StartLine + 1), column @(diagnostic.StartColumn + 1): @diagnostic.Message
            </button>
        }
    </div>
    @if (ProjectLoading)
    {
        <div class="language-state" role="status">@LanguageInfo.DisplayName services loading…</div>
    }
    else if (!LanguageInfo.IsAvailable)
    {
        <div class="language-state" role="status">@LanguageInfo.Status</div>
    }
    @if (_completion is { Items.Count: > 0 })
    {
        <div class="language-popup completion-popup" role="listbox" style="@PopupStyle">
            @for (var index = 0; index < _completion.Items.Count; index++)
            {
                var item = _completion.Items[index];
                <button class="@(index == _selectedCompletion ? "selected" : null)" role="option"
                        data-commit="@(new string(item.CommitCharacters.ToArray()))"
                        aria-selected="@(index == _selectedCompletion)" @onmouseenter="() => FocusCompletionAsync(index)"
                        @onclick="() => CommitCompletionAsync(item)">
                    <span>@item.DisplayText</span><small>@item.Kind</small>
                </button>
            }
            @if (SelectedCompletion?.Detail is { } detail)
            {
                <div class="language-detail"><MarkdownView Content="@detail" /></div>
            }
        </div>
    }
    @if (_signature is { Signatures.Count: > 0 })
    {
        <div class="language-popup signature-popup" style="@PopupStyle" role="status">
            <span>@(_signature.ActiveSignature + 1)/@_signature.Signatures.Count</span>
            <code>@_signature.Signatures[_signature.ActiveSignature]</code>
            <small>parameter @(_signature.ActiveParameter + 1)</small>
        </div>
    }
    @if (_hover is { Sections.Count: > 0 })
    {
        <div class="language-popup hover-popup" style="@HoverPopupStyle" role="tooltip">
            @for (var index = 0; index < _hover.Sections.Count; index++)
            {
                var section = _hover.Sections[index];
                @if (section.StartsWith("Diagnostic|", StringComparison.Ordinal))
                {
                    var parts = section.Split('|', 4);
                    <div class="hover-diagnostic @parts[1].ToLowerInvariant()">
                        <strong>@parts[1]@if (!string.IsNullOrWhiteSpace(parts[2])) { <code>@parts[2]</code> }</strong>
                        <span>@parts[3]</span>
                    </div>
                }
                else if (section.StartsWith("DiagnosticSource|", StringComparison.Ordinal))
                {
                    <div class="hover-diagnostic-source">Source: @section[17..]</div>
                }
                else
                {
                    <div class="@(IsFirstSemanticSection(index) && !section.Contains('\n') ? "hover-signature" : section.StartsWith("Project:", StringComparison.Ordinal) ? "hover-context" : "hover-description")"><MarkdownView Content="@section" /></div>
                }
            }
        </div>
    }
    @if (_navigationTargets.Count > 0)
    {
        <div class="navigation-popup language-popup" style="@PopupStyle" role="dialog" aria-label="Navigation results">
            <span class="visually-hidden" aria-live="polite">@_navigationTargets.Count navigation results</span>
            @foreach (var target in _navigationTargets)
            {
                <button @onclick="() => NavigateAsync(target)"><span>@target.DisplayText</span><small>@Path.GetFileName(target.DocumentPath):@(target.Line + 1)</small>@if (target.Preview is not null) { <code>@target.Preview</code> }</button>
            }
        </div>
    }
    @if (_codeActions.Count > 0)
    {
        <div class="code-actions-popup navigation-popup language-popup" style="@PopupStyle" role="menu" aria-label="Code actions">
            @foreach (var action in _codeActions)
            {
                <button role="menuitem" @onclick="() => ApplyCodeActionAsync(action)"><span>@action.Title</span><small>@action.Kind</small></button>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Value { get; set; } = string.Empty;
    [Parameter, EditorRequired] public EventCallback<string> ValueChanged { get; set; }
    [Parameter, EditorRequired] public EditorDocumentState Document { get; set; } = null!;
    [Parameter, EditorRequired] public ILanguageProvider LanguageProvider { get; set; } = null!;
    [Parameter] public IReadOnlyList<LanguageDiagnostic> Diagnostics { get; set; } = [];
    [Parameter] public long LanguageAnalysisRevision { get; set; }
    [Parameter] public string? ProjectContext { get; set; }
    [Parameter] public bool ProjectLoading { get; set; }
    [Parameter] public bool SuggestionsEnabled { get; set; } = true;
    [Parameter] public bool SemanticHighlighting { get; set; } = true;
    [Parameter] public bool WordWrap { get; set; }
    [Parameter, EditorRequired] public EditorViewState ViewState { get; set; } = null!;
    [Parameter] public EventCallback ViewStateChanged { get; set; }
    [Parameter] public EventCallback<EditorLanguageCommand> LanguageCommand { get; set; }
    private readonly LatestLanguageRequest _completionRequest = new();
    private readonly LatestLanguageRequest _signatureRequest = new();
    private readonly LatestLanguageRequest _hoverRequest = new();
    private readonly LatestLanguageRequest _semanticRequest = new();
    private readonly LatestLanguageRequest _diagnosticRequest = new();
    private ElementReference _root;
    private IJSObjectReference? _module;
    private DotNetObjectReference<CodeEditor>? _self;
    private CompletionResult? _completion;
    private SignatureResult? _signature;
    private HoverResult? _hover;
    private IReadOnlyList<SemanticSpan> _semanticSpans = [];
    private IReadOnlyList<SymbolEntry> _symbols = [];
    private IReadOnlyList<NavigationTarget> _navigationTargets = [];
    private IReadOnlyList<LanguageDiagnostic> _diagnostics = [];
    private IReadOnlyList<CodeActionEntry> _codeActions = [];
    private IReadOnlyList<EditorLine> _lines = [];
    private int[] _lineStarts = [0];
    private CancellationTokenSource? _presentationCancellation;
    private CancellationTokenSource? _semanticRefreshCancellation;
    private CancellationTokenSource? _diagnosticRefreshCancellation;
    private readonly CancellationTokenSource _languageStartupCancellation = new();
    private string? _linesValue;
    private string _semanticValue = string.Empty;
    private string? _languageReadyKey;
    private int _semanticRevision, _renderedSemanticRevision, _presentationGeneration;
    private long _semanticDocumentVersion = -1;
    private long _observedLanguageAnalysisRevision = -1;
    private int _selectedCompletion;
    private bool _outlineOpen;
    private bool _semanticReady;
    private bool _scrollCompletionAfterRender;
    private bool _refreshLanguageAfterRender;
    private bool _synchronizeViewStateAfterRender;
    private string? _renderedValue, _locallyEditedValue;
    private string _formatDiagnostic = "Not started";
    private double _popupX = 72, _popupY = 24;
    private double _hoverPopupX = 72, _hoverPopupY = 24;
    private IExtendedLanguageProvider ExtendedProvider => (IExtendedLanguageProvider)LanguageProvider;
    private LanguageProviderInfo LanguageInfo => Document.FilePath is { } path
        ? ExtendedProvider.GetInfo(path) : new("text", "Text", LanguageCapabilities.None, false, "Language services unavailable");
    private ICollection<EditorLine> Lines => (ICollection<EditorLine>)_lines;
    private bool SemanticPending => !_semanticReady && SemanticHighlighting
        && (ProjectLoading || Has(LanguageCapabilities.SemanticTokens));
    private void QueuePresentation()
    {
        if (_semanticValue != Value)
        {
            _semanticSpans = RemapSemanticSpans(_semanticValue, Value, _semanticSpans);
            _semanticValue = Value;
            _semanticRevision++;
        }
        if (_linesValue == Value && _renderedSemanticRevision == _semanticRevision) return;
        _presentationCancellation?.Cancel();
        _presentationCancellation?.Dispose();
        _presentationCancellation = new();
        var generation = ++_presentationGeneration;
        var value = Value;
        var semanticSpans = _semanticValue == value ? _semanticSpans : [];
        var semanticRevision = _semanticRevision;
        _ = BuildPresentationAsync(value, semanticSpans, semanticRevision, generation, _presentationCancellation.Token);
    }

    private async Task BuildPresentationAsync(string value, IReadOnlyList<SemanticSpan> semanticSpans,
        int semanticRevision, int generation,
        CancellationToken cancellationToken)
    {
        try
        {
            var presentation = await Task.Run(() =>
                (Lines: CSharpTokenizer.Tokenize(value, semanticSpans).ToArray(), Starts: BuildLineStarts(value)), cancellationToken);
            var updated = presentation.Lines;
            cancellationToken.ThrowIfCancellationRequested();
            await InvokeAsync(() =>
            {
                if (generation != _presentationGeneration || cancellationToken.IsCancellationRequested) return;
                if (_lines.Count == updated.Length)
                    for (var index = 0; index < updated.Length; index++)
                        if (_lines[index].Text == updated[index].Text && _lines[index].Spans.SequenceEqual(updated[index].Spans))
                            updated[index] = _lines[index];
                _lines = updated;
                _lineStarts = presentation.Starts;
                _linesValue = value;
                _renderedSemanticRevision = semanticRevision;
                StateHasChanged();
            });
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
    }

    protected override void OnParametersSet()
    {
        if (!_semanticReady && Document.SemanticPresentation is { } cached
            && cached.Version == Document.Version && cached.Text == Value)
        {
            _semanticSpans = cached.Spans;
            _semanticValue = cached.Text;
            _semanticDocumentVersion = cached.Version;
            _semanticReady = true;
            _semanticRevision++;
        }
        if (_renderedValue is not null && Value != _renderedValue && Value != _locallyEditedValue)
        {
            ViewState.ApplyTextChange(_renderedValue, Value);
            _synchronizeViewStateAfterRender = true;
        }
        _renderedValue = Value;
        _locallyEditedValue = null;
        if (Document.FilePath is { } diagnosticPath)
            _diagnostics = Diagnostics.Where(item => string.Equals(Path.GetFullPath(item.DocumentPath),
                Path.GetFullPath(diagnosticPath), OperatingSystem.IsWindows()
                    ? StringComparison.OrdinalIgnoreCase : StringComparison.Ordinal)).ToArray();
        QueuePresentation();
        var info = LanguageInfo;
        var readyKey = !ProjectLoading && Document.FilePath is { } path && info.IsAvailable
            ? $"{path}|{info.DisplayName}|{info.Status}|{info.Capabilities}" : null;
        if (readyKey is not null && readyKey != _languageReadyKey) _refreshLanguageAfterRender = true;
        if (readyKey is not null && LanguageAnalysisRevision != _observedLanguageAnalysisRevision)
            _refreshLanguageAfterRender = true;
        _observedLanguageAnalysisRevision = LanguageAnalysisRevision;
        _languageReadyKey = readyKey;
    }
    private string PopupStyle => $"left:{_popupX}px;top:{_popupY}px";
    private string HoverPopupStyle => $"left:{_hoverPopupX}px;top:{_hoverPopupY}px";
    private string OverviewTop(LanguageDiagnostic diagnostic) => $"{Math.Clamp((diagnostic.StartLine + .5) / Math.Max(1, Lines.Count) * 100, 0, 99).ToString(System.Globalization.CultureInfo.InvariantCulture)}%";
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./editor.js");
            _self = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("createEditor", _root, WordWrap, _self, ViewState.SelectionStart,
                ViewState.SelectionEnd, ViewState.ScrollTop, ViewState.ScrollLeft);
            _ = AwaitLanguageReadyAsync(_languageStartupCancellation.Token);
            if (Program.Phase15Solution is not null) _ = RunPhase15SmokeAsync();
            else if (Program.Phase8Solution is not null) _ = RunPhase8SmokeAsync();
            else if (Program.Phase7Solution is not null) _ = RunPhase7SmokeAsync();
            if (Program.Phase2SmokeFile is not null)
            {
                var result = await _module.InvokeAsync<EditorSmokeResult>("runSmokeChecks", _root);
                await Program.CompleteSmokeAsync(result);
            }
        }
        if (_refreshLanguageAfterRender && _module is not null && _languageReadyKey is not null)
        {
            _refreshLanguageAfterRender = false;
            _ = RefreshSemanticAsync();
            _ = RefreshDiagnosticsAsync();
        }
        else if (!firstRender && _module is not null)
        {
            if (_synchronizeViewStateAfterRender)
            {
                _synchronizeViewStateAfterRender = false;
                await _module.InvokeVoidAsync("setEditorSelection", _root, ViewState.SelectionStart, ViewState.SelectionEnd);
            }
            await _module.InvokeVoidAsync("fitLanguagePopups", _root);
            if (_scrollCompletionAfterRender)
            {
                _scrollCompletionAfterRender = false;
                await _module.InvokeVoidAsync("scrollSelectedCompletionIntoView", _root);
            }
        }
    }

    [JSInvokable]
    public async Task InputChanged(string value, int caret, string? trigger)
    {
        _semanticRefreshCancellation?.Cancel();
        _diagnosticRefreshCancellation?.Cancel();
        ViewState.SetSelection(caret, caret, value.Length);
        _locallyEditedValue = value;
        await ValueChanged.InvokeAsync(value);
        if (ProjectLoading || Document.FilePath is null) return;
        if (SuggestionsEnabled && Has(LanguageCapabilities.Completion)
            && (trigger is "." or " " or "<" or "@" or ":" or "-" || trigger?.Length == 1 && char.IsLetterOrDigit(trigger[0])))
            await RequestCompletionAsync(caret, false);
        else CloseCompletion();
        if (Has(LanguageCapabilities.SignatureHelp) && trigger is "(" or ",") await RequestSignatureAsync(caret);
        else if (trigger == ")") _signature = null;
        _hover = null;
        _ = RefreshSemanticAsync();
        _ = RefreshDiagnosticsAsync();
    }

    [JSInvokable]
    public async Task EditorCommand(string command, int caret)
    {
        switch (command)
        {
            case "completion" when Has(LanguageCapabilities.Completion): await RequestCompletionAsync(caret, true); break;
            case "signature" when Has(LanguageCapabilities.SignatureHelp): await RequestSignatureAsync(caret); break;
            case "hover" when Has(LanguageCapabilities.Hover) && (IsHoverable(caret) || DiagnosticAt(caret) is not null):
                await RequestHoverAsync(caret); break;
            case "hover": _hover = null; break;
            case "hover-close": _hover = null; break;
            case "completion-next": MoveCompletion(1); break;
            case "completion-previous": MoveCompletion(-1); break;
            case "completion-accept" when SelectedCompletion is { } completion:
                await CommitCompletionAsync(completion); break;
            case "escape": _completion = null; _signature = null; _hover = null; break;
            case "format" when Has(LanguageCapabilities.Formatting): await FormatAsync(); break;
            case "definition" when Has(LanguageCapabilities.Navigation): await RequestNavigationAsync(caret, "definition"); break;
            case "type-definition" when Has(LanguageCapabilities.Navigation): await RequestNavigationAsync(caret, "type-definition"); break;
            case "implementation" when Has(LanguageCapabilities.Navigation): await RequestNavigationAsync(caret, "implementation"); break;
            case "references" when Has(LanguageCapabilities.Navigation): await RequestNavigationAsync(caret, "references"); break;
            case "peek" when Has(LanguageCapabilities.Navigation): await RequestNavigationAsync(caret, "peek"); break;
            case "outline" when Has(LanguageCapabilities.Symbols):
                if (!_outlineOpen && _symbols.Count == 0)
                    _symbols = await ExtendedProvider.GetDocumentSymbolsAsync(Request(Value.Length), default);
                _outlineOpen = !_outlineOpen;
                break;
            case "rename" when Has(LanguageCapabilities.Rename):
                await LanguageCommand.InvokeAsync(new(command, caret)); break;
            case "back": case "forward":
                await LanguageCommand.InvokeAsync(new(command, caret)); break;
            case "code-actions" when Has(LanguageCapabilities.CodeActions):
                _codeActions = await ExtendedProvider.GetCodeActionsAsync(Request(caret), default);
                await UpdateAnchorAsync(caret); break;
        }
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public int CompletionItemCount() => _completion?.Items.Count ?? 0;

    [JSInvokable]
    public bool LanguageReady() => !ProjectLoading && Document.FilePath is not null
        && Has(LanguageCapabilities.Completion);

    [JSInvokable]
    public string CompletionDiagnostic() => _completionRequest.LastError?.ToString()
        ?? $"{_completionRequest.Status}; {_completion?.Items.Count ?? 0} items; document version {Document.Version}";

    [JSInvokable]
    public string FormatDiagnostic() => _formatDiagnostic;

    private LanguageRequest Request(int position, TextRange? range = null) =>
        new(Document.FilePath!, ProjectContext, Document.Version, Math.Clamp(position, 0, Value.Length), range);
    private bool Has(LanguageCapabilities capability) => LanguageInfo.IsAvailable
        && LanguageInfo.Capabilities.HasFlag(capability);

    private async Task RunPhase7SmokeAsync()
    {
        await Task.Yield();
        var result = await _module!.InvokeAsync<Phase7SmokeResult>("runPhase7Smoke", _root);
        await Program.CompletePhase7SmokeAsync(result);
    }
    private async Task RunPhase8SmokeAsync()
    {
        await Task.Yield();
        var result = await _module!.InvokeAsync<Phase8SmokeResult>("runPhase8Smoke", _root);
        await Program.CompletePhase8SmokeAsync(result);
    }
    private async Task RunPhase15SmokeAsync()
    {
        await Task.Yield();
        var result = await _module!.InvokeAsync<Phase15SmokeResult>("runPhase15Smoke", _root);
        await Program.CompletePhase15SmokeAsync(result);
    }

    private async Task RequestCompletionAsync(int caret, bool explicitInvocation)
    {
        var version = Document.Version;
        var completion = await _completionRequest.RunAsync(
            token => LanguageProvider.GetCompletionsAsync(Request(caret), explicitInvocation, token), version);
        var prefix = CompletionPrefix(Value, caret);
        _completion = completion is not null && prefix.Length > 0
            ? new(completion.Items.Where(item => item.FilterText.StartsWith(prefix, StringComparison.OrdinalIgnoreCase)
                || item.DisplayText.StartsWith(prefix, StringComparison.OrdinalIgnoreCase)).ToArray())
            : completion;
        _selectedCompletion = 0;
        await UpdateAnchorAsync(caret);
        await InvokeAsync(StateHasChanged);
    }

    private static string CompletionPrefix(string value, int caret)
    {
        caret = Math.Clamp(caret, 0, value.Length);
        var start = caret;
        while (start > 0 && (char.IsLetterOrDigit(value[start - 1]) || value[start - 1] == '_')) start--;
        return value[start..caret];
    }

    private async Task FocusCompletionAsync(int index)
    {
        if (_completion is not { } completion || index < 0 || index >= completion.Items.Count) return;
        _selectedCompletion = index;
        var item = completion.Items[index];
        var detail = await LanguageProvider.GetCompletionDetailsAsync(Request(ViewState.SelectionStart), item.Id, default);
        if (detail.SourceVersion != Document.Version || detail.Value is null || !ReferenceEquals(_completion, completion)) return;
        var items = completion.Items.ToArray();
        items[index] = detail.Value;
        _completion = new(items);
    }

    private async Task CommitCompletionAsync(CompletionEntry item, char? commitCharacter = null)
    {
        if (_module is null) return;
        var response = await LanguageProvider.GetCompletionEditAsync(Request(ViewState.SelectionStart), item.Id,
            commitCharacter, default);
        if (response.SourceVersion != Document.Version || response.Value is not { } edit) return;
        if (!item.IsSnippet && edit.NewPosition is null && item.Kind is "Method" or "Function" or "Constructor"
            && !edit.NewText.Contains('(')
            && (edit.Replacement.Start + edit.Replacement.Length >= Value.Length
                || Value[edit.Replacement.Start + edit.Replacement.Length] != '('))
            edit = edit with { NewText = edit.NewText + "()", NewPosition = edit.Replacement.Start + edit.NewText.Length + 1 };
        _completion = null;
        await _module.InvokeVoidAsync("applyEditorEdit", _root, edit.Replacement.Start, edit.Replacement.Length,
            edit.NewText, edit.NewPosition);
        if (edit.Command is not null && Document.FilePath is { } path)
            await ExtendedProvider.ExecuteCommandAsync(path, edit.Command, default);
    }

    private async Task RequestSignatureAsync(int caret)
    {
        var version = Document.Version;
        _signature = await _signatureRequest.RunAsync(
            token => LanguageProvider.GetSignatureHelpAsync(Request(caret), token), version);
        await UpdateAnchorAsync(caret);
    }

    private async Task RequestHoverAsync(int caret)
    {
        var diagnostic = DiagnosticAt(caret);
        HoverResult? semantic = null;
        if (IsHoverable(caret))
        {
            var version = Document.Version;
            semantic = await _hoverRequest.RunAsync(token => LanguageProvider.GetHoverAsync(Request(caret), token), version);
        }
        if (diagnostic is not null)
        {
            var sections = new List<string>
            {
                $"Diagnostic|{diagnostic.Severity}|{diagnostic.Id}|{diagnostic.Message}",
                $"DiagnosticSource|{diagnostic.Source}"
            };
            if (semantic is not null) sections.AddRange(semantic.Sections);
            _hover = new(diagnostic.Range, sections);
        }
        else _hover = semantic;
        await UpdateAnchorAsync(caret, hover: true);
    }

    private LanguageDiagnostic? DiagnosticAt(int caret) => _diagnostics
            .Where(item => caret >= item.Range.Start && caret < item.Range.Start + Math.Max(1, item.Range.Length))
            .OrderBy(item => item.Range.Length)
            .ThenByDescending(item => item.Severity)
            .FirstOrDefault();

    private bool IsFirstSemanticSection(int index) => !_hover!.Sections.Take(index)
        .Any(section => !section.StartsWith("Diagnostic|", StringComparison.Ordinal)
            && !section.StartsWith("DiagnosticSource|", StringComparison.Ordinal));

    private bool IsHoverable(int position)
    {
        if (_linesValue != Value || position < 0 || position > Value.Length || _lines.Count == 0) return false;
        var lineIndex = Array.BinarySearch(_lineStarts, position);
        if (lineIndex < 0) lineIndex = ~lineIndex - 1;
        lineIndex = Math.Clamp(lineIndex, 0, _lines.Count - 1);
        var column = position - _lineStarts[lineIndex];
        var span = _lines[lineIndex].Spans.FirstOrDefault(item => column >= item.Start && column < item.Start + item.Length);
        return span.Kind is not TokenKind.String and not TokenKind.Comment;
    }

    private static int[] BuildLineStarts(string text)
    {
        var starts = new List<int> { 0 };
        for (var index = 0; index < text.Length; index++)
        {
            if (text[index] == '\r')
            {
                if (index + 1 < text.Length && text[index + 1] == '\n') index++;
                starts.Add(index + 1);
            }
            else if (text[index] == '\n') starts.Add(index + 1);
        }
        return starts.ToArray();
    }

    private static IReadOnlyList<SemanticSpan> RemapSemanticSpans(string oldValue, string newValue,
        IReadOnlyList<SemanticSpan> spans)
    {
        var prefix = 0;
        while (prefix < oldValue.Length && prefix < newValue.Length && oldValue[prefix] == newValue[prefix]) prefix++;
        var oldSuffix = oldValue.Length;
        var newSuffix = newValue.Length;
        while (oldSuffix > prefix && newSuffix > prefix && oldValue[oldSuffix - 1] == newValue[newSuffix - 1])
        {
            oldSuffix--;
            newSuffix--;
        }
        var delta = newSuffix - oldSuffix;
        return spans.Where(span => span.Start + span.Length <= prefix || span.Start >= oldSuffix)
            .Select(span => span.Start >= oldSuffix ? span with { Start = span.Start + delta } : span)
            .Where(span => span.Start >= 0 && span.Start + span.Length <= newValue.Length)
            .ToArray();
    }

    private async Task RefreshSemanticAsync()
    {
        if (ProjectLoading || Document.FilePath is null || !SemanticHighlighting || !Has(LanguageCapabilities.SemanticTokens)) return;
        if (_semanticReady && _semanticDocumentVersion == Document.Version && _semanticValue == Value) return;
        _semanticRefreshCancellation?.Cancel();
        _semanticRefreshCancellation?.Dispose();
        _semanticRefreshCancellation = new();
        var cancellationToken = _semanticRefreshCancellation.Token;
        var version = Document.Version;
        var value = Value;
        try { await Task.Delay(100, cancellationToken); }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { return; }
        var spans = await _semanticRequest.RunAsync(
            token => LanguageProvider.GetSemanticSpansAsync(Request(value.Length), token), version, cancellationToken);
        if (cancellationToken.IsCancellationRequested || Document.Version != version || Value != value) return;
        if (spans is not null)
        {
            _semanticSpans = spans;
            _semanticValue = value;
            _semanticDocumentVersion = version;
            _semanticReady = true;
            Document.AcceptSemanticPresentation(value, spans);
            _semanticRevision++;
            await InvokeAsync(QueuePresentation);
        }
        var symbols = await ExtendedProvider.GetDocumentSymbolsAsync(Request(Value.Length), cancellationToken);
        if (Document.Version == version) _symbols = symbols;
    }

    private async Task AwaitLanguageReadyAsync(CancellationToken cancellationToken)
    {
        try
        {
            for (var attempt = 0; attempt < 60 && !cancellationToken.IsCancellationRequested; attempt++)
            {
                if (!ProjectLoading && Document.FilePath is not null && SemanticHighlighting
                    && Has(LanguageCapabilities.SemanticTokens))
                {
                    await InvokeAsync(RefreshSemanticAsync);
                    if (_semanticSpans.Count > 0) return;
                }
                await Task.Delay(500, cancellationToken);
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
    }

    private async Task RequestNavigationAsync(int caret, string command)
    {
        var provider = ExtendedProvider;
        var request = Request(caret);
        IReadOnlyList<NavigationTarget> targets = command switch
        {
            "type-definition" => await provider.GetDefinitionsAsync(request, true, default),
            "implementation" => await provider.GetImplementationsAsync(request, default),
            "references" => await provider.FindReferencesAsync(request, default),
            _ => await provider.GetDefinitionsAsync(request, false, default)
        };
        if (targets.Count == 1 && command != "peek") await NavigateAsync(targets[0]);
        else
        {
            _navigationTargets = targets;
            if (targets.Count == 0) await LanguageCommand.InvokeAsync(new("navigation-empty", caret));
            await UpdateAnchorAsync(caret);
        }
    }

    private Task NavigateAsync(NavigationTarget target)
    {
        _navigationTargets = [];
        return LanguageCommand.InvokeAsync(new("navigate", ViewState.SelectionStart, target));
    }

    private Task NavigateSymbolAsync(SymbolEntry symbol)
    {
        _outlineOpen = false;
        return LanguageCommand.InvokeAsync(new("navigate", ViewState.SelectionStart,
            new(symbol.DocumentPath, symbol.Range, symbol.Line, symbol.Column, symbol.Name,
                symbol.ProjectName, NavigationKind.Definition)));
    }
    private Task NavigateDiagnosticAsync(LanguageDiagnostic diagnostic) => LanguageCommand.InvokeAsync(new("navigate",
        ViewState.SelectionStart, new(diagnostic.DocumentPath, diagnostic.Range, diagnostic.StartLine,
            diagnostic.StartColumn, diagnostic.Message, diagnostic.ProjectName ?? "", NavigationKind.Reference)));
    private async Task ApplyCodeActionAsync(CodeActionEntry action)
    {
        _codeActions = [];
        if (action.Edit is not null)
            await LanguageCommand.InvokeAsync(new("workspace-edit", ViewState.SelectionStart, Edit: action.Edit));
        else if (action.Command is not null && Document.FilePath is { } path)
            await ExtendedProvider.ExecuteCommandAsync(path, action.Command, default);
    }

    private async Task RefreshDiagnosticsAsync()
    {
        if (ProjectLoading || Document.FilePath is null || !Has(LanguageCapabilities.Diagnostics)) return;
        _diagnosticRefreshCancellation?.Cancel();
        _diagnosticRefreshCancellation?.Dispose();
        _diagnosticRefreshCancellation = new();
        var cancellationToken = _diagnosticRefreshCancellation.Token;
        var version = Document.Version;
        try { await Task.Delay(150, cancellationToken); }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { return; }
        var diagnostics = await _diagnosticRequest.RunAsync(
            token => LanguageProvider.GetDiagnosticsAsync(Request(Value.Length), token), version, cancellationToken);
        if (cancellationToken.IsCancellationRequested) return;
        if (diagnostics is not null)
        {
            _diagnostics = diagnostics;
            await InvokeAsync(StateHasChanged);
        }
    }
    private IReadOnlyList<LanguageDiagnostic> DiagnosticsFor(EditorLine line) => _diagnostics
        .Where(item => item.StartLine <= line.Number - 1 && (item.EndLine < 0 ? item.StartLine : item.EndLine) >= line.Number - 1)
        .ToArray();

    private async Task FormatAsync()
    {
        if (_module is null || Document.FilePath is null) return;
        try
        {
            _formatDiagnostic = "Requesting";
            TextRange? range = ViewState.SelectionStart == ViewState.SelectionEnd ? null
                : new TextRange(ViewState.SelectionStart, ViewState.SelectionEnd - ViewState.SelectionStart);
            var response = await LanguageProvider.FormatAsync(Request(ViewState.SelectionStart, range), default);
            if (response.SourceVersion == Document.Version && response.Value is { } formatted)
            {
                _formatDiagnostic = formatted.Text == Value ? "Provider returned unchanged text" : "Applied";
                await _module.InvokeVoidAsync("replaceEditorText", _root, formatted.Text,
                    formatted.SelectionStart, formatted.SelectionLength);
            }
            else _formatDiagnostic = $"Stale or empty response at document version {Document.Version}";
        }
        catch (Exception exception) { _formatDiagnostic = exception.ToString(); }
    }

    private async Task UpdateAnchorAsync(int caret, bool hover = false)
    {
        if (_module is null) return;
        var anchor = await _module.InvokeAsync<double[]>("getEditorAnchor", _root, caret);
        if (anchor.Length != 2) return;
        if (hover) { _hoverPopupX = anchor[0]; _hoverPopupY = anchor[1]; }
        else { _popupX = anchor[0]; _popupY = anchor[1]; }
    }

    private void MoveCompletion(int delta)
    {
        if (_completion is not { Items.Count: > 0 }) return;
        _selectedCompletion = (_selectedCompletion + delta + _completion.Items.Count) % _completion.Items.Count;
        _scrollCompletionAfterRender = true;
        _ = FocusCompletionAsync(_selectedCompletion);
    }
    private CompletionEntry? SelectedCompletion => _completion is { Items.Count: > 0 } completion
        ? completion.Items[Math.Clamp(_selectedCompletion, 0, completion.Items.Count - 1)]
        : null;
    private void CloseCompletion() { _completion = null; _selectedCompletion = 0; }

    [JSInvokable]
    public Task SelectionChanged(int start, int end)
    {
        ViewState.SetSelection(start, end, Value.Length);
        return ViewStateChanged.InvokeAsync();
    }

    [JSInvokable]
    public Task ScrollChanged(double top, double left)
    {
        ViewState.SetScroll(top, left);
        return ViewStateChanged.InvokeAsync();
    }

    [JSInvokable]
    public Task ViewportChanged(int start, int end, double top, double left)
    {
        ViewState.SetSelection(start, end, Value.Length);
        ViewState.SetScroll(top, left);
        return ViewStateChanged.InvokeAsync();
    }

    public async ValueTask DisposeAsync()
    {
        _completionRequest.Dispose(); _signatureRequest.Dispose(); _hoverRequest.Dispose(); _semanticRequest.Dispose();
        _semanticRefreshCancellation?.Cancel(); _semanticRefreshCancellation?.Dispose();
        _diagnosticRefreshCancellation?.Cancel(); _diagnosticRefreshCancellation?.Dispose();
        _languageStartupCancellation.Cancel(); _languageStartupCancellation.Dispose();
        _diagnosticRequest.Dispose();
        _presentationCancellation?.Cancel();
        _presentationCancellation?.Dispose();
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("disposeEditor", _root); }
            catch (JSDisconnectedException) { }
            await _module.DisposeAsync();
        }
        _self?.Dispose();
    }
}

@code { public sealed record EditorLanguageCommand(string Command, int Position, NavigationTarget? Target = null, WorkspaceEdit? Edit = null); }
