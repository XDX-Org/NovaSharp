@using Microsoft.JSInterop
@using NovaSharp.Commands
@using NovaSharp.Platform
@using NovaSharp.Shell
@using NovaSharp.Solutions
@using NovaSharp.Workspace
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime

<aside class="explorer @(_draggedNode is null ? null : "workspace-dragging")" style="width: @(_snapshot.SidebarWidth)px" aria-label="Explorer" @ref="_explorer"
       hidden="@(!_snapshot.SidebarVisible)">
        <header class="explorer-header">
            <strong>Explorer</strong>
            <button type="button" title="Open solution or project" aria-label="Open solution or project" @onclick="OpenSolutionAsync"><ShellIcon Name="SemanticIcon.Solution" /></button>
            <button type="button" title="Open folder" aria-label="Open folder" @onclick="OpenFolderAsync"><ShellIcon Name="SemanticIcon.FolderOpen" /></button>
            <button type="button" title="Refresh" aria-label="Refresh Explorer" disabled="@(!_snapshot.IsOpen)" @onclick="RefreshAsync"><ShellIcon Name="SemanticIcon.Refresh" /></button>
            <button type="button" title="Collapse all folders" aria-label="Collapse all folders" disabled="@(!_snapshot.IsOpen)" @onclick="CollapseAllAsync"><ShellIcon Name="SemanticIcon.CollapseAll" /></button>
            <button type="button" title="Close Explorer" aria-label="Close Explorer" @onclick="ToggleAsync"><ShellIcon Name="SemanticIcon.Close" /></button>
        </header>
        @if (_snapshot.Root is null)
        {
            <button type="button" class="open-folder" @onclick="OpenFolderAsync">Open Folder</button>
        }
        else
        {
            <div class="explorer-view">
                <select aria-label="Explorer view" @bind="_view">
                    <option value="@ExplorerView.Folder">Folder view</option>
                    <option value="@ExplorerView.Solution" disabled="@(_solution.State == SolutionLoadState.Closed)">Solution view</option>
                </select>
            </div>
            <div class="workspace-path" title="@_snapshot.RootPath">@_snapshot.RootPath</div>
            <div class="workspace-tree">
                @if (_view == ExplorerView.Solution && _solution.State != SolutionLoadState.Closed)
                {
                    <SolutionTree @ref="_solutionTree" Snapshot="_solution" OpenFile="OpenFile" CancelLoad="CancelSolutionLoadAsync" />
                }
                else
                {
                    <div role="tree" aria-label="Workspace files">
                        <WorkspaceTreeNode Node="_snapshot.Root" SelectedId="_snapshot.SelectedId"
                            OnSelect="SelectAsync" OnPreview="PreviewAsync" OnActivate="ActivateAsync" OnExpand="ExpandAsync" OnCollapse="CollapseAsync"
                            OnRename="BeginRename" OnDelete="DeleteAsync" OnContextMenu="OpenContextMenuAsync"
                            OnDragStart="BeginDragAsync" OnDragEnd="EndDragAsync" OnDrop="DropAsync" />
                    </div>
                }
            </div>
        }
        <div class="explorer-resizer" role="separator" aria-label="Resize Explorer" aria-orientation="vertical"
             aria-valuenow="@_snapshot.SidebarWidth" tabindex="0"
             @ref="_resizer" @onkeydown="ResizeKeyDownAsync"></div>
</aside>

@if (_contextNode is { } contextNode)
{
    <div class="context-menu-scrim" @onclick="CloseContextMenu"
         @oncontextmenu="CloseContextMenu" @oncontextmenu:preventDefault></div>
    <div class="context-command-menu" role="menu" aria-label="@($"Actions for {contextNode.Name}")" tabindex="-1"
         @ref="_contextMenu" style="--context-x:@(_contextX)px; --context-y:@(_contextY)px"
         @onclick:stopPropagation @onkeydown="ContextMenuKeyDownAsync">
        @if (contextNode.Kind == WorkspaceNodeKind.Directory)
        {
            <button type="button" role="menuitem" @onclick="() => BeginCreate(contextNode, false)"><ShellIcon Name="SemanticIcon.AddFile" /><span>New file</span></button>
            <button type="button" role="menuitem" @onclick="() => BeginCreate(contextNode, true)"><ShellIcon Name="SemanticIcon.AddFolder" /><span>New folder</span></button>
        }
        @if (contextNode != _snapshot.Root)
        {
            <button type="button" role="menuitem" @onclick="() => BeginMove(contextNode)"><ShellIcon Name="SemanticIcon.Move" /><span>Move</span></button>
            <button type="button" role="menuitem" @onclick="() => BeginRename(contextNode)"><ShellIcon Name="SemanticIcon.Rename" /><span>Rename</span></button>
            <button type="button" role="menuitem" @onclick="() => DeleteAsync(contextNode)"><ShellIcon Name="SemanticIcon.Trash" /><span>Delete</span></button>
        }
    </div>
}

@if (_dialogMode is not null)
{
    <div class="workspace-dialog" role="dialog" aria-modal="true" aria-label="@DialogTitle">
        <h2>@DialogTitle</h2>
        <label>@DialogLabel <input @bind="_dialogValue" @onkeydown="DialogKeyDownAsync" autofocus /></label>
        <div class="picker-actions">
            <button type="button" @onclick="ApplyDialogAsync">Apply</button>
            <button type="button" @onclick="CancelDialog">Cancel</button>
        </div>
    </div>
}

@code {
    private enum ExplorerView { Folder, Solution }

    [Parameter] public EventCallback<string> OpenFile { get; set; }
    [Parameter] public EventCallback<string> PreviewFile { get; set; }
    [Parameter] public EventCallback<WorkspaceNode> OnDragStart { get; set; }
    [Parameter] public EventCallback OnDragEnd { get; set; }

    private readonly List<IDisposable> _registrations = [];
    private WorkspaceSnapshot _snapshot = Workbench.Explorer.Snapshot;
    private SolutionWorkspaceSnapshot _solution = Workbench.Solutions.Snapshot;
    private ExplorerView _view = ExplorerView.Folder;
    private SolutionTree? _solutionTree;
    private string? _dialogMode;
    private string _dialogValue = string.Empty;
    private WorkspaceNode? _dialogNode;
    private WorkspaceNode? _contextNode;
    private double _contextX;
    private double _contextY;
    private ElementReference _contextMenu;
    private bool _focusContextMenu;
    private bool _started;
    private bool _restoreFocus;
    private ElementReference _explorer;
    private ElementReference _resizer;
    private DotNetObjectReference<WorkspaceExplorer>? _selfReference;
    private WorkspaceNode? _draggedNode;

    protected override void OnInitialized()
    {
        Workbench.Explorer.Changed += OnChanged;
        Workbench.Explorer.Relocated += OnRelocatedAsync;
        Workbench.Solutions.Changed += OnSolutionChanged;
        _solution = Workbench.Solutions.Snapshot;
        if (_solution.State != SolutionLoadState.Closed) _view = ExplorerView.Solution;
        RegisterCommands();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusContextMenu)
        {
            _focusContextMenu = false;
            await _contextMenu.FocusAsync();
        }
        if (_restoreFocus)
        {
            _restoreFocus = false;
            await JSRuntime.InvokeVoidAsync("NovaWorkspace.restoreFocus");
        }
        if (!firstRender || _started) return;
        _started = true;
        _selfReference = DotNetObjectReference.Create(this);
        await JSRuntime.InvokeVoidAsync("NovaWorkspace.attachDragSurface", _explorer);
        await JSRuntime.InvokeVoidAsync("NovaWorkspace.attachResizer", _resizer, _selfReference);
        Workbench.Explorer.SetIgnoredPaths(Workbench.Configuration.Current.Settings.WorkspaceIgnoredPaths);
        await Workbench.Explorer.RestoreAsync();
        if (Workbench.Explorer.Snapshot.RootPath is { } root)
        {
            Workbench.Configuration.SetWorkspaceRoot(root);
            await Workbench.LoadConfigurationAsync();
            Workbench.Explorer.SetIgnoredPaths(Workbench.Configuration.Current.Settings.WorkspaceIgnoredPaths);
            await DiscoverSolutionAsync(root);
        }
    }

    private void RegisterCommands()
    {
        void Register(string id, Func<CancellationToken, Task> handler, Func<bool>? enabled = null) =>
            _registrations.Add(Workbench.Commands.Register(WorkbenchCommands.Describe(id), handler, enabled));
        Register(WorkbenchCommands.OpenWorkspace, _ => OpenFolderAsync());
        Register(WorkbenchCommands.CloseWorkspace, token => CloseFolderAsync(token), () => _snapshot.IsOpen);
        Register(WorkbenchCommands.RefreshWorkspace, token => RefreshAsync(token), () => _snapshot.IsOpen);
        Register(WorkbenchCommands.ToggleExplorer, _ => ToggleAsync());
        Register(WorkbenchCommands.RevealActiveFile, token => RevealAsync(token), () => _snapshot.IsOpen && Workbench.ActiveDocument?.Status.IsOpen == true);
        Register(WorkbenchCommands.OpenSolution, _ => OpenSolutionAsync());
        Register(WorkbenchCommands.ReloadSolution, token => Workbench.Solutions.ReloadAsync(token), () => _solution.Path is not null);
        Register(WorkbenchCommands.CancelSolutionLoad, token => Workbench.Solutions.CancelLoadAsync(token),
            () => _solution.State == SolutionLoadState.Loading);
        Register(WorkbenchCommands.CloseSolution, token => Workbench.Solutions.CloseAsync(token), () => _solution.Path is not null);
    }

    private Task CancelSolutionLoadAsync() =>
        Workbench.Commands.InvokeAsync(WorkbenchCommands.CancelSolutionLoad, CancellationToken.None);

    private async Task OpenFolderAsync()
    {
        var folders = await Program.App.MainWindow.ShowOpenFolderAsync("Open folder", _snapshot.RootPath ?? string.Empty, false);
        if (folders is not [var root]) return;
        await Workbench.Explorer.OpenAsync(root);
        Workbench.Configuration.SetWorkspaceRoot(root);
        await Workbench.LoadConfigurationAsync();
        Workbench.Explorer.SetIgnoredPaths(Workbench.Configuration.Current.Settings.WorkspaceIgnoredPaths);
        await DiscoverSolutionAsync(root);
    }

    private async Task OpenSolutionAsync()
    {
        var files = await Program.App.MainWindow.ShowOpenFileAsync(
            title: "Open solution or project",
            multiSelect: false,
            filters: [(".NET solution or C# project", ["sln", "slnx", "csproj"])]);
        if (files is [var path]) await Workbench.Solutions.OpenAsync(path);
    }

    private async Task DiscoverSolutionAsync(string root)
    {
        if (await Workbench.SolutionDiscovery.DiscoverAsync(root) is { } path)
            await Workbench.Solutions.OpenAsync(path);
    }

    private async Task CloseFolderAsync(CancellationToken cancellationToken)
    {
        await Workbench.Explorer.CloseAsync(cancellationToken);
        await Workbench.Solutions.CloseAsync(cancellationToken);
        Workbench.Configuration.SetWorkspaceRoot(null);
        await Workbench.LoadConfigurationAsync(cancellationToken);
    }

    private Task RefreshAsync() => RefreshAsync(CancellationToken.None);
    private async Task RefreshAsync(CancellationToken token)
    {
        if (_snapshot.RootPath is not null)
            await Workbench.Explorer.ExpandAsync(_snapshot.RootPath, cancellationToken: token);
        await Workbench.Solutions.ReloadAsync(token);
    }
    private Task CollapseAllAsync() => _view == ExplorerView.Solution && _solutionTree is not null
        ? _solutionTree.CollapseAllAsync()
        : Workbench.Explorer.CollapseAllAsync();

    private Task ToggleAsync() => Workbench.Explorer.SetSidebarAsync(!_snapshot.SidebarVisible, _snapshot.SidebarWidth);

    private Task RevealAsync(CancellationToken token) => Workbench.ActiveDocument?.Status.Path is { Length: > 0 } path
        ? Workbench.Explorer.RevealAsync(path, token)
        : Task.CompletedTask;

    private Task SelectAsync(WorkspaceNode node) => Workbench.Explorer.SelectAsync(node.Path);
    private Task ExpandAsync(WorkspaceNode node) => Workbench.Explorer.ExpandAsync(node.Path);
    private Task CollapseAsync(WorkspaceNode node) => Workbench.Explorer.CollapseAsync(node.Path);

    private async Task BeginDragAsync(WorkspaceNode node)
    {
        _draggedNode = node;
        await OnDragStart.InvokeAsync(node);
    }

    private async Task EndDragAsync()
    {
        _draggedNode = null;
        await OnDragEnd.InvokeAsync();
    }

    private async Task DropAsync(WorkspaceNode target)
    {
        var source = _draggedNode;
        if (source is null || target.Kind != WorkspaceNodeKind.Directory || source.Id == target.Id) return;
        await Workbench.Explorer.MoveAsync(source.Path, target.Path);
        await EndDragAsync();
    }

    private async Task ActivateAsync(WorkspaceNode node)
    {
        if (SolutionDiscovery.IsSupported(node.Path))
        {
            await Workbench.Solutions.OpenAsync(node.Path);
            return;
        }
        await OpenFile.InvokeAsync(node.Path);
        await Workbench.Explorer.RevealAsync(node.Path);
    }

    private async Task PreviewAsync(WorkspaceNode node)
    {
        if (SolutionDiscovery.IsSupported(node.Path))
        {
            await Workbench.Solutions.OpenAsync(node.Path);
            return;
        }
        await PreviewFile.InvokeAsync(node.Path);
        await Workbench.Explorer.RevealAsync(node.Path);
    }

    private void BeginCreate(WorkspaceNode parent, bool directory)
    {
        CloseContextMenu();
        _dialogMode = directory ? "create-folder" : "create-file";
        _dialogValue = string.Empty;
        _dialogNode = parent;
    }

    private void BeginRename(WorkspaceNode? node)
    {
        CloseContextMenu();
        if (node is null || node == _snapshot.Root) return;
        _dialogMode = "rename";
        _dialogValue = node.Name;
        _dialogNode = node;
    }

    private void BeginMove(WorkspaceNode node)
    {
        CloseContextMenu();
        _dialogMode = "move";
        _dialogValue = string.Empty;
        _dialogNode = node;
    }

    private async Task ApplyDialogAsync()
    {
        var mode = _dialogMode;
        var node = _dialogNode;
        var value = _dialogValue;
        CancelDialog();
        if (node is null) return;
        if (mode == "create-file") await Workbench.Explorer.CreateAsync(node.Path, value, false);
        else if (mode == "create-folder") await Workbench.Explorer.CreateAsync(node.Path, value, true);
        else if (mode == "rename") await Workbench.Explorer.RenameAsync(node.Path, value);
        else if (mode == "move" && _snapshot.RootPath is { } root)
        {
            try
            {
                var target = Workbench.Paths.ResolveWorkspaceRelativePath(root, value);
                await Workbench.Explorer.MoveAsync(node.Path, target);
            }
            catch (ArgumentException exception)
            {
                Workbench.Notifications.Raise("novasharp.workspace.move", NovaSharp.Diagnostics.NotificationSeverity.Error, exception.Message);
            }
        }
    }

    private async Task DeleteAsync(WorkspaceNode? node)
    {
        CloseContextMenu();
        if (node is null || node == _snapshot.Root) return;
        var answer = await Program.App.MainWindow.ShowMessageAsync(
            "NovaSharp", $"Delete {node.Name}? This cannot be undone.",
            Photino.NET.PhotinoDialogButtons.YesNo, Photino.NET.PhotinoDialogIcon.Warning);
        if (answer == Photino.NET.PhotinoDialogResult.Yes) await Workbench.Explorer.DeleteAsync(node.Path);
    }

    [JSInvokable]
    public Task CommitSidebarWidthAsync(int width) => Workbench.Explorer.SetSidebarAsync(true, width);

    private async Task ResizeKeyDownAsync(KeyboardEventArgs args)
    {
        var width = args.Key switch
        {
            "ArrowLeft" when _snapshot.SidebarWidth <= int.MaxValue - 10 => _snapshot.SidebarWidth + 10,
            "ArrowLeft" => int.MaxValue,
            "ArrowRight" => Math.Max(0, _snapshot.SidebarWidth - 10),
            _ => _snapshot.SidebarWidth,
        };
        if (width != _snapshot.SidebarWidth) await Workbench.Explorer.SetSidebarAsync(true, width);
    }

    private Task OpenContextMenuAsync((WorkspaceNode Node, MouseEventArgs Args) request)
    {
        _contextNode = request.Node;
        _contextX = request.Args.ClientX;
        _contextY = request.Args.ClientY;
        _focusContextMenu = true;
        return Task.CompletedTask;
    }

    private void CloseContextMenu() => _contextNode = null;
    private Task ContextMenuKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Escape") CloseContextMenu();
        return Task.CompletedTask;
    }

    private async Task DialogKeyDownAsync(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs args)
    {
        if (args.Key == "Enter") await ApplyDialogAsync();
        else if (args.Key == "Escape") CancelDialog();
    }

    private void CancelDialog()
    {
        _dialogMode = null;
        _dialogNode = null;
        _dialogValue = string.Empty;
    }

    private string DialogTitle => _dialogMode switch
    {
        "create-file" => "Create file",
        "create-folder" => "Create folder",
        "rename" => "Rename item",
        _ => "Move item",
    };
    private string DialogLabel => _dialogMode == "move" ? "Destination folder, relative to the workspace" : "Name";

    private void OnChanged(WorkspaceSnapshot snapshot) => _ = InvokeAsync(async () =>
    {
        if (_snapshot.SidebarVisible && !snapshot.SidebarVisible)
            await JSRuntime.InvokeVoidAsync("NovaWorkspace.rememberFocus");
        else if (!_snapshot.SidebarVisible && snapshot.SidebarVisible)
            _restoreFocus = true;
        _snapshot = snapshot;
        StateHasChanged();
    });

    private void OnSolutionChanged(SolutionWorkspaceSnapshot snapshot) => _ = InvokeAsync(() =>
    {
        if (snapshot.Version <= _solution.Version) return;
        var previous = _solution.State;
        _solution = Workbench.Solutions.Snapshot;
        if (_solution.State == SolutionLoadState.Closed) _view = ExplorerView.Folder;
        else if (previous == SolutionLoadState.Closed) _view = ExplorerView.Solution;
        StateHasChanged();
    });

    private async Task OnRelocatedAsync(WorkspaceRelocation relocation)
    {
        if (Workbench.Documents is { } documents) await documents.RelocateAsync(relocation);
    }

    public async ValueTask DisposeAsync()
    {
        Workbench.Explorer.Changed -= OnChanged;
        Workbench.Explorer.Relocated -= OnRelocatedAsync;
        Workbench.Solutions.Changed -= OnSolutionChanged;
        foreach (var registration in _registrations) registration.Dispose();
        _registrations.Clear();
        try
        {
            await JSRuntime.InvokeVoidAsync("NovaWorkspace.detachDragSurface", _explorer);
            await JSRuntime.InvokeVoidAsync("NovaWorkspace.detachResizer");
        }
        catch (JSDisconnectedException) { }
        _selfReference?.Dispose();
        _selfReference = null;
    }
}
