@implements IAsyncDisposable
@using Microsoft.AspNetCore.Components.Web
@inject IJSRuntime JS

@if (!_state.SidebarCollapsed)
{
<aside @ref="_explorer" class="explorer @(ProjectSystem?.State.Path is not null ? "has-view-switch" : null)" style="width:@_state.SidebarWidth.ToString(System.Globalization.CultureInfo.InvariantCulture)px" aria-label="Explorer" @onclick="HideContextMenu">
    <header class="explorer-header">
        <strong>Explorer</strong>
        <span class="explorer-actions">
            @if (!ShowSolution)
            {
                <button @onclick="OpenFolderAsync" title="Open folder" aria-label="Open folder">＋</button>
                <button @onclick="RefreshAsync" disabled="@(_workspace.RootPath is null)" title="Refresh" aria-label="Refresh">↻</button>
                <button @onclick="RevealAsync" disabled="@(Document.FilePath is null || !_workspace.Contains(Document.FilePath))" title="Reveal active file" aria-label="Reveal active file">◎</button>
            }
        </span>
    </header>
        @if (ProjectSystem?.State.Path is not null)
        {
            <div class="explorer-view-switch">
                <select aria-label="Explorer view" value="@SelectedView" @onchange="ChangeViewAsync">
                    <option value="solution">Solution</option>
                    @foreach (var folder in SolutionFolders)
                    {
                        <option value="@folder.Path">@folder.Name</option>
                    }
                </select>
            </div>
        }
        @if (ShowSolution)
        {
            <SolutionExplorer ProjectSystem="ProjectSystem!" FileOpened="FileOpened" />
        }
        else
        {
          @if (_workspace.RootPath is null)
          {
            <div class="explorer-empty"><button @onclick="OpenFolderAsync">Open Folder</button></div>
          }
          else
          {
            <div class="workspace-title" title="@_workspace.RootPath">@_workspace.RootPath</div>
            @if (_editMode is not null)
            {
                <div class="modal-backdrop" @onclick="CancelEdit">
                    <form class="modal-dialog" role="dialog" aria-modal="true" aria-labelledby="edit-title"
                          @onclick:stopPropagation @onsubmit="CommitEditAsync" @onsubmit:preventDefault>
                        <h2 id="edit-title">@EditTitle</h2>
                        <label class="modal-field">
                            <span>Name</span>
                            <input aria-label="@_editMode" @bind="_editName" autofocus />
                        </label>
                        @if (_editMode == "Move item")
                        {
                            <label class="modal-field">
                                <span>Destination folder (relative to workspace)</span>
                                <input aria-label="Destination folder" @bind="_moveDestination" />
                            </label>
                        }
                        <div class="modal-actions">
                            <button type="submit">@EditAction</button>
                            <button type="button" @onclick="CancelEdit">Cancel</button>
                        </div>
                    </form>
                </div>
            }
            @if (_deletePending is not null)
            {
                <div class="modal-backdrop" @onclick="CancelDelete">
                    <div class="modal-dialog" role="alertdialog" aria-modal="true" aria-labelledby="delete-title" @onclick:stopPropagation>
                        <h2 id="delete-title">Delete @_deletePending.Name?</h2>
                        <p>This action cannot be undone.</p>
                        <div class="modal-actions">
                            <button class="danger" @onclick="ConfirmDeleteAsync">Delete</button>
                            <button @onclick="CancelDelete">Cancel</button>
                        </div>
                    </div>
                </div>
            }
            @if (_error is not null) { <div class="explorer-error" role="alert">@_error <button @onclick="ClearError">×</button></div> }
            <div class="tree" role="tree" aria-label="Workspace files" @onkeydown="HandleKeyAsync" @onkeydown:preventDefault
                 @oncontextmenu="ShowRootContextMenu">
                <Virtualize Items="_visible" Context="row" ItemSize="20" OverscanCount="8">
                    <div class="tree-row @(IsSelected(row.Entry) ? "selected" : null)" role="treeitem"
                         data-file-path="@(row.Entry.IsDirectory ? null : row.Entry.Path)"
                         aria-level="@(row.Depth + 1)" aria-expanded="@(row.Entry.IsDirectory ? _expanded.Contains(row.Entry.Path) : null)"
                         tabindex="@(IsSelected(row.Entry) ? 0 : -1)" style="padding-left:@(5 + row.Depth * 12)px"
                         @onclick="args => RowClickAsync(row.Entry, args)"
                         @oncontextmenu="args => ShowContextMenu(args, row.Entry)" @oncontextmenu:stopPropagation>
                        @if (row.Entry.IsDirectory)
                        {
                            <span class="tree-toggle folder-icon" aria-hidden="true">
                                <span>@(_expanded.Contains(row.Entry.Path) ? "▾" : "▸")</span><span>📁</span>
                            </span>
                        }
                        else { <span class="tree-toggle file-icon @IconClass(row.Entry)">@Icon(row.Entry)</span> }
                        <span class="tree-name" title="@row.Entry.Path">@row.Entry.Name</span>
                    </div>
                </Virtualize>
            </div>
            @if (_showContextMenu)
            {
                <div class="context-menu-dismiss" @onclick="HideContextMenu"
                     @oncontextmenu="HideContextMenu" @oncontextmenu:preventDefault></div>
                <div @ref="_contextMenu" class="explorer-context-menu" role="menu" @onclick:stopPropagation
                     @oncontextmenu:preventDefault @oncontextmenu:stopPropagation>
                    <button role="menuitem" @onclick='() => BeginCreate(false)'>New file</button>
                    <button role="menuitem" @onclick='() => BeginCreate(true)'>New folder</button>
                    <hr />
                    <button role="menuitem" @onclick="BeginRename" disabled="@(_selected is null || IsRoot(_selected.Path))">Rename <kbd>F2</kbd></button>
                    <button role="menuitem" @onclick="BeginMove" disabled="@(_selected is null || IsRoot(_selected.Path))">Move <kbd>Ctrl+M</kbd></button>
                    <button role="menuitem" @onclick="BeginDelete" disabled="@(_selected is null || IsRoot(_selected.Path))">Delete <kbd>Del</kbd></button>
                    <hr />
                    <button role="menuitem" @onclick="CloseWorkspaceAsync">Close workspace</button>
                    <hr />
                    <div class="context-menu-hint">Browser options <kbd>Shift+Right-click</kbd></div>
                </div>
            }
          }
        }
    <div class="explorer-resizer" role="separator" aria-label="Resize Explorer" aria-orientation="vertical" title="Drag to resize Explorer"></div>
</aside>
}

@code {
    [Parameter, EditorRequired] public EditorDocumentState Document { get; set; } = null!;
    [Parameter] public EventCallback<string> FileOpened { get; set; }
    [Parameter] public EventCallback<string> FilePreviewed { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public RoslynProjectSystem? ProjectSystem { get; set; }
    private readonly WorkspaceService _workspace = new(Program.Configuration.Current.ExplorerIgnoredNames);
    private readonly Dictionary<string, IReadOnlyList<WorkspaceEntry>> _children = new();
    private readonly HashSet<string> _expanded = new(StringComparer.Ordinal);
    private readonly List<TreeRow> _visible = [];
    private ElementReference _explorer;
    private ElementReference _contextMenu;
    private DotNetObjectReference<WorkspaceExplorer>? _self;
    private WorkspacePersistence _persistence = null!;
    private WorkspaceRestoreState _state = new();
    private string? _presentedSolution;
    private string? _selectedFolder;
    private WorkspaceEntry? _selected, _deletePending;
    private string? _editMode, _error;
    private string _editName = "", _moveDestination = "";
    private string EditTitle => _editMode switch { "New file name" => "New file", "New folder name" => "New folder", "Move item" => "Move item", _ => "Rename item" };
    private string EditAction => _editMode switch { "New name" => "Rename", "Move item" => "Move", _ => "Create" };
    private bool _showContextMenu;
    private bool _solutionView;
    private bool _positionContextMenu;
    private bool _phase3SmokeStarted;
    private double _contextX, _contextY;
    private bool ShowSolution => _solutionView && ProjectSystem?.State.Path is not null;
    private string SelectedView => ShowSolution ? "solution" : _selectedFolder ?? "solution";
    private IReadOnlyList<FolderOption> SolutionFolders
    {
        get
        {
            if (ProjectSystem?.State.Path is not { } solutionPath) return [];
            var solutionRoot = Path.GetDirectoryName(solutionPath)!;
            var paths = new[] { solutionRoot }.Concat(ProjectSystem.CurrentSolution?.Projects
                .Select(project => Path.GetDirectoryName(project.FilePath)).Where(path => path is not null).Select(path => path!) ?? []);
            return paths.Distinct(PathComparer).Select(path => new FolderOption(path,
                PathComparer.Equals(path, solutionRoot) ? $"Files — {Path.GetFileName(solutionRoot)}" : Path.GetFileName(path))).ToArray();
        }
    }

    protected override void OnParametersSet()
    {
        if (ProjectSystem?.State.Path == _presentedSolution) return;
        _presentedSolution = ProjectSystem?.State.Path;
        _solutionView = _presentedSolution is not null;
        _selectedFolder = null;
    }

    private async Task ChangeViewAsync(ChangeEventArgs args)
    {
        HideContextMenu();
        var value = args.Value?.ToString();
        if (value == "solution") { _solutionView = true; _selectedFolder = null; return; }
        if (value is null || !SolutionFolders.Any(folder => PathComparer.Equals(folder.Path, value))) return;
        _solutionView = false;
        _selectedFolder = value;
        await OpenFolderCoreAsync(value);
    }

    protected override async Task OnInitializedAsync()
    {
        var path = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData), "NovaSharp", "workspace-state.json");
        _persistence = new(path);
        _state = await _persistence.LoadAsync();
        if (Program.Phase6Solution is not null) _state = _state with { SidebarCollapsed = false };
        await OpenChanged.InvokeAsync(!_state.SidebarCollapsed);
        _workspace.Changed += OnWorkspaceChanged;
        _workspace.Error += OnWorkspaceError;
        _workspace.RescanRequired += OnWorkspaceRescanRequired;
        var restorePath = Program.Phase3Workspace ?? _state.WorkspacePath;
        if (restorePath is not null && Directory.Exists(restorePath))
        {
            try { _workspace.Open(restorePath); await RestoreAsync(); }
            catch (Exception ex) { _error = ex.Message; }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_state.SidebarCollapsed)
        {
            _self ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("novaSharp.initExplorerResize", _explorer, _self);
        }
        if (_showContextMenu && _positionContextMenu)
        {
            _positionContextMenu = false;
            await JS.InvokeVoidAsync("novaSharp.positionContextMenu", _contextMenu, _contextX, _contextY);
        }
        if (!_phase3SmokeStarted && Program.Phase3Workspace is not null && _visible.Count > 0)
        {
            _phase3SmokeStarted = true;
            await JS.InvokeVoidAsync("novaSharp.runPhase3Smoke", _explorer, _self);
        }
    }

    private async Task OpenFolderAsync()
    {
        var folders = await Program.App.MainWindow.ShowOpenFolderDialogAsync("Open workspace", _workspace.RootPath, false);
        if (folders is not [var path]) return;
        try { await OpenFolderCoreAsync(path); }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or ArgumentException) { _error = ex.Message; }
    }

    private async Task OpenFolderCoreAsync(string path)
    {
        _workspace.Open(path); _children.Clear(); _expanded.Clear();
        await LoadAsync(_workspace.RootPath!); Rebuild(); await SaveStateAsync();
    }

    private async Task RestoreAsync()
    {
        await LoadAsync(_workspace.RootPath!);
        foreach (var path in _state.ExpandedPaths ?? [])
            if (_workspace.Contains(path) && Directory.Exists(path)) { _expanded.Add(path); await LoadAsync(path); }
        Rebuild();
    }

    private async Task LoadAsync(string path)
    {
        try { _children[path] = await _workspace.GetChildrenAsync(path); }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException) { _error = ex.Message; }
    }

    private async Task ToggleAsync(WorkspaceEntry entry)
    {
        if (!_expanded.Remove(entry.Path)) { await LoadAsync(entry.Path); _expanded.Add(entry.Path); }
        Rebuild(); await SaveStateAsync();
    }

    private async Task ActivateAsync(WorkspaceEntry entry)
    {
        Select(entry);
        if (entry.IsDirectory) await ToggleAsync(entry);
        else if (entry.Kind != WorkspaceEntryKind.SymbolicLink) await FileOpened.InvokeAsync(entry.Path);
    }

    private async Task RefreshAsync()
    {
        if (_workspace.RootPath is null) return;
        foreach (var path in _children.Keys.ToArray()) if (Directory.Exists(path)) await LoadAsync(path); else _children.Remove(path);
        Rebuild();
    }

    private async Task RevealAsync()
    {
        if (Document.FilePath is null || !_workspace.Contains(Document.FilePath)) return;
        var directory = Path.GetDirectoryName(Document.FilePath);
        while (directory is not null && _workspace.Contains(directory))
        {
            await LoadAsync(directory); _expanded.Add(directory);
            if (string.Equals(directory, _workspace.RootPath, StringComparison.Ordinal)) break;
            directory = Path.GetDirectoryName(directory);
        }
        Rebuild();
        _selected = _visible.Select(row => row.Entry).FirstOrDefault(entry => string.Equals(entry.Path, Document.FilePath, StringComparison.Ordinal));
        await SaveStateAsync();
    }

    private void Rebuild()
    {
        _visible.Clear();
        if (_workspace.RootPath is null) return;
        var root = new WorkspaceEntry(_workspace.RootPath, Path.GetFileName(_workspace.RootPath), _workspace.RootPath, WorkspaceEntryKind.Folder);
        _selected ??= root;
        AddVisible(root, 0);
    }

    private void AddVisible(WorkspaceEntry entry, int depth)
    {
        _visible.Add(new(entry, depth));
        if (!_expanded.Contains(entry.Path) || !_children.TryGetValue(entry.Path, out var children)) return;
        foreach (var child in children) AddVisible(child, depth + 1);
    }

    private async Task SelectAsync(WorkspaceEntry entry)
    {
        _selected = entry; _showContextMenu = false;
        if (!entry.IsDirectory && entry.Kind != WorkspaceEntryKind.SymbolicLink)
            await FilePreviewed.InvokeAsync(entry.Path);
    }
    private async Task RowClickAsync(WorkspaceEntry entry, MouseEventArgs args)
    {
        Select(entry);
        if (entry.IsDirectory)
            await ToggleAsync(entry);
        else if (entry.Kind != WorkspaceEntryKind.SymbolicLink)
        {
            if (args.Detail >= 2) await FileOpened.InvokeAsync(entry.Path);
            else await FilePreviewed.InvokeAsync(entry.Path);
        }
    }
    private void Select(WorkspaceEntry entry) { _selected = entry; _showContextMenu = false; }
    private bool IsSelected(WorkspaceEntry entry) => _selected?.Id == entry.Id;
    private bool IsRoot(string path) => string.Equals(path, _workspace.RootPath, StringComparison.Ordinal);
    private string ParentForCreate() => _selected?.IsDirectory == true ? _selected.Path : Path.GetDirectoryName(_selected?.Path ?? _workspace.RootPath!)!;
    private void BeginCreate(bool folder) { _showContextMenu = false; _editMode = folder ? "New folder name" : "New file name"; _editName = ""; _deletePending = null; }
    private void BeginRename() { _showContextMenu = false; if (_selected is null || IsRoot(_selected.Path)) return; _editMode = "New name"; _editName = _selected.Name; _deletePending = null; }
    private void BeginMove() { _showContextMenu = false; if (_selected is null || IsRoot(_selected.Path)) return; _editMode = "Move item"; _editName = _selected.Name; _moveDestination = "."; _deletePending = null; }
    private void CancelEdit() { _editMode = null; _editName = _moveDestination = ""; }
    private void BeginDelete() { _showContextMenu = false; if (_selected is not null && !IsRoot(_selected.Path)) _deletePending = _selected; _editMode = null; }
    private void CancelDelete() => _deletePending = null;
    private void ClearError() => _error = null;
    private void HideContextMenu() => _showContextMenu = false;

    private void ShowContextMenu(MouseEventArgs args, WorkspaceEntry entry)
    {
        if (args.ShiftKey) return;
        _selected = entry;
        ShowContextMenu(args.ClientX, args.ClientY);
    }

    private void ShowRootContextMenu(MouseEventArgs args)
    {
        if (args.ShiftKey) return;
        if (_workspace.RootPath is null) return;
        _selected = _visible.FirstOrDefault()?.Entry;
        ShowContextMenu(args.ClientX, args.ClientY);
    }

    private void ShowContextMenu(double x, double y)
    {
        _contextX = x;
        _contextY = y;
        _showContextMenu = true;
        _positionContextMenu = true;
        _editMode = null;
        _deletePending = null;
    }

    private async Task CommitEditAsync()
    {
        try
        {
            if (_editMode == "New file name") _selected = EntryFor(_workspace.CreateFile(ParentForCreate(), _editName));
            else if (_editMode == "New folder name") _selected = EntryFor(_workspace.CreateFolder(ParentForCreate(), _editName), true);
            else if (_selected is not null)
            {
                var oldPath = _selected.Path;
                var parent = _editMode == "Move item"
                    ? Path.GetFullPath(Path.Combine(_workspace.RootPath!, _moveDestination))
                    : Path.GetDirectoryName(oldPath)!;
                var newPath = _workspace.Move(oldPath, parent, _editName);
                Document.Relocate(oldPath, newPath); _selected = EntryFor(newPath, _selected.IsDirectory);
            }
            CancelEdit(); await RefreshAsync();
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or ArgumentException or InvalidOperationException) { _error = ex.Message; }
    }

    private async Task ConfirmDeleteAsync()
    {
        try { _workspace.Delete(_deletePending!.Path); _deletePending = null; _selected = null; await RefreshAsync(); }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or InvalidOperationException) { _error = ex.Message; }
    }

    private WorkspaceEntry EntryFor(string path, bool folder = false) => new(path, Path.GetFileName(path), path,
        folder ? WorkspaceEntryKind.Folder : WorkspaceEntryKind.SupportedFile);

    private async Task HandleKeyAsync(KeyboardEventArgs args)
    {
        if (_visible.Count == 0) return;
        var index = Math.Max(0, _visible.FindIndex(row => IsSelected(row.Entry)));
        switch (args.Key)
        {
            case "ArrowDown": _selected = _visible[Math.Min(_visible.Count - 1, index + 1)].Entry; break;
            case "ArrowUp": _selected = _visible[Math.Max(0, index - 1)].Entry; break;
            case "ArrowRight" when _selected?.IsDirectory == true && !_expanded.Contains(_selected.Path): await ToggleAsync(_selected); break;
            case "ArrowRight" when index + 1 < _visible.Count && _visible[index + 1].Depth > _visible[index].Depth: _selected = _visible[index + 1].Entry; break;
            case "ArrowLeft" when _selected?.IsDirectory == true && _expanded.Contains(_selected.Path): await ToggleAsync(_selected); break;
            case "ArrowLeft":
                var depth = _visible[index].Depth;
                for (var parent = index - 1; parent >= 0; parent--)
                    if (_visible[parent].Depth < depth) { _selected = _visible[parent].Entry; break; }
                break;
            case "Home": _selected = _visible[0].Entry; break;
            case "End": _selected = _visible[^1].Entry; break;
            case "Enter" when _selected is not null: await ActivateAsync(_selected); break;
            case "F2": BeginRename(); break;
            case "m" when args.CtrlKey || args.MetaKey: BeginMove(); break;
            case "Delete": BeginDelete(); break;
            case "ContextMenu": ShowContextMenu(WidthForKeyboardMenu(), 72); break;
            case "F10" when args.ShiftKey: ShowContextMenu(WidthForKeyboardMenu(), 72); break;
            case "Escape": HideContextMenu(); break;
        }
    }

    private double WidthForKeyboardMenu() => Math.Max(200, _state.SidebarWidth + 44);

    private async void OnWorkspaceChanged(string? parent)
    {
        if (parent is null || !_children.ContainsKey(parent)) return;
        await InvokeAsync(async () => { await LoadAsync(parent); Rebuild(); StateHasChanged(); });
    }

    private void OnWorkspaceError(string message) => _ = InvokeAsync(() => { _error = message; StateHasChanged(); });
    private void OnWorkspaceRescanRequired() => _ = InvokeAsync(RefreshAsync);
    private async Task CloseWorkspaceAsync() { _workspace.Close(); _children.Clear(); _expanded.Clear(); _visible.Clear(); _selected = null; await SaveStateAsync(); }
    public async Task ToggleCollapsedAsync()
    {
        _state = _state with { SidebarCollapsed = !_state.SidebarCollapsed };
        await SaveStateAsync();
        await OpenChanged.InvokeAsync(!_state.SidebarCollapsed);
    }
    [JSInvokable]
    public async Task ExplorerResized(double width)
    {
        _state = _state with { SidebarWidth = Math.Clamp(width, 180, 800) };
        await SaveStateAsync();
    }
    [JSInvokable]
    public Task CompletePhase3SmokeAsync(Phase3SmokeResult result)
    {
        var document = Program.ActiveDocument;
        var verified = result with
        {
            RenamePreservedDirtySelection = result.RenamePreservedDirtySelection
                && document is { IsDirty: true }
                && string.Equals(Path.GetFileName(document.FilePath), "renamed.cs", StringComparison.Ordinal)
        };
        return Program.CompletePhase3SmokeAsync(verified);
    }
    private Task SaveStateAsync() => _persistence.SaveAsync(_state with { WorkspacePath = _workspace.RootPath, ExpandedPaths = _expanded.ToArray() });
    private static string Icon(WorkspaceEntry entry) => FileKind(entry) switch
    {
        ".cs" => "C#",
        ".js" => "JS",
        ".css" => "CSS",
        ".html" or ".htm" => "HTML",
        ".json" => "{}",
        ".md" or ".markdown" => "MD",
        "git" => "GIT",
        ".props" => "MSB",
        ".sln" => "SLN",
        ".slnx" => "SLNX",
        ".razor" => "RZ",
        ".dll" => "⚙",
        ".exe" or ".com" => "🖥︎",
        ".csproj" => "CSP",
        ".xml" => "<>",
        ".pdb" => "PDB",
        ".yml" or ".yaml" => "YML",
        "none" => "FILE",
        _ => entry.Kind == WorkspaceEntryKind.SymbolicLink ? "↗" : "▧"
    };
    private static string IconClass(WorkspaceEntry entry) => FileKind(entry) switch
    {
        ".cs" => "csharp",
        ".js" => "javascript",
        ".css" => "stylesheet",
        ".html" or ".htm" => "html",
        ".json" => "json",
        ".md" or ".markdown" => "markdown",
        "git" => "git",
        ".props" => "props",
        ".sln" or ".slnx" => "solution",
        ".razor" => "razor",
        ".dll" => "assembly",
        ".exe" or ".com" => "executable",
        ".csproj" => "csproj",
        ".xml" => "xml",
        ".pdb" => "symbols",
        ".yml" or ".yaml" => "yaml",
        "none" => "extensionless",
        _ => "generic"
    };
    private static string FileKind(WorkspaceEntry entry)
    {
        var name = entry.Name.ToLowerInvariant();
        if (name is ".gitignore" or ".gitattributes" or ".gitmodules" or ".gitkeep") return "git";
        var extension = Path.GetExtension(name);
        return extension.Length == 0 ? "none" : extension;
    }
    private sealed record TreeRow(WorkspaceEntry Entry, int Depth);
    private sealed record FolderOption(string Path, string Name);
    private static StringComparer PathComparer => OperatingSystem.IsWindows()
        ? StringComparer.OrdinalIgnoreCase : StringComparer.Ordinal;

    public async ValueTask DisposeAsync()
    {
        _workspace.Changed -= OnWorkspaceChanged; _workspace.Error -= OnWorkspaceError; _workspace.RescanRequired -= OnWorkspaceRescanRequired;
        await SaveStateAsync(); _workspace.Dispose(); _self?.Dispose();
    }
}
