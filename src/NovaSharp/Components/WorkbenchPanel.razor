    private async Task OfferWorkspaceSolutionAsync(string root)
    {
        root = Path.GetFullPath(root);
        var locatorGroup = Guid.NewGuid();
        await _globalPersistence.SaveAsync(new(2, new("group", locatorGroup, Tabs: []), locatorGroup,
            WorkspacePath: root));
        _persistence = new(WorkspaceStatePath(root));
        _buildConfigurationStore = BuildConfigurationStoreFor(root);
        WorkbenchLayoutState? savedWorkspace = null;
        if (OpenDocuments.Count == 0 && File.Exists(WorkspaceStatePath(root)))
        {
            savedWorkspace = await _persistence.LoadAsync();
            await _workspace.RestoreAsync(savedWorkspace);
            _lastNonEmptyLayout = HasTabs(savedWorkspace.Root) ? savedWorkspace : null;
        }
        if (_projectSystem.State.Path is not null) return;
        var candidates = new[] { "*.slnx", "*.sln" }
            .SelectMany(pattern => Directory.EnumerateFiles(root, pattern, SearchOption.TopDirectoryOnly))
            .Take(2).ToArray();
        if (candidates.Length == 0)
            candidates = Directory.EnumerateFiles(root, "*.csproj", SearchOption.TopDirectoryOnly).Take(2).ToArray();
        if (candidates is not [var path]) return;
        savedWorkspace ??= File.Exists(WorkspaceStatePath(root)) ? await _persistence.LoadAsync() : null;
        if (savedWorkspace?.SolutionPath is { } accepted && PathsEqual(accepted, path))
        {
            await LoadSolutionAsync(path);
            return;
        }
        var result = await Program.App.MainWindow.ShowMessageDialogAsync("Load solution",
            $"Load {Path.GetFileName(path)}?", DialogButtons.YesNo, DialogIcon.Question);
        if (result != DialogResult.Yes) return;
        await LoadSolutionAsync(path);
    }

    private async Task LoadSolutionAsync(string path)
    {
        _languageProvider.Diagnostics.Clear();
        await _projectSystem.OpenAsync(path);
        if (_projectSystem.State.Path is null) return;
        _persistedSolutionPath = Path.GetFullPath(path);
        var root = Path.GetDirectoryName(_persistedSolutionPath)!;
        var locatorGroup = Guid.NewGuid();
        await _globalPersistence.SaveAsync(new(2, new("group", locatorGroup, Tabs: []), locatorGroup,
            SolutionPath: _persistedSolutionPath, WorkspacePath: root));
        _persistence = new(WorkspaceStatePath(root));
        _buildConfigurationStore = BuildConfigurationStoreFor(root);
        WorkbenchLayoutState? savedWorkspace = null;
        if (File.Exists(WorkspaceStatePath(root)))
        {
            savedWorkspace = await _persistence.LoadAsync();
            _startupProject = (savedWorkspace.StartupProject ?? savedWorkspace.BuildProjectPath) is { } savedProject
                ? StartupProjects.FirstOrDefault(candidate => PathsEqual(candidate, savedProject)) : null;
        }
        if (_languageServers.Count > 0) await ReplaceLanguageServersAsync();
        if (StartupProject is { } project)
        {
            _startupProject = project;
            await RestoreBuildConfigurationAsync(project);
            RestoreActiveBuildConfiguration(savedWorkspace, project);
        }
        await SaveLayoutAsync();
    }

