    private async Task HandleKeyAsync(KeyboardEventArgs args)
    {
        var gesture = string.Join('+', new[] { args.CtrlKey ? "Ctrl" : null, args.AltKey ? "Alt" : null,
            args.ShiftKey ? "Shift" : null, args.MetaKey ? "Meta" : null, NormalizeGestureKey(args.Key) }.Where(value => value is not null));
        var configured = _commands.Commands.FirstOrDefault(command => string.Equals(
            Program.Configuration.Current.Keybindings?.GetValueOrDefault(command.Id, command.Keybinding ?? "") ?? command.Keybinding,
            gesture, StringComparison.OrdinalIgnoreCase));
        if (configured is not null) { await _commands.ExecuteAsync(configured.Id); return; }
        if (!(args.CtrlKey || args.MetaKey)) return;
        switch (args.Key.ToLowerInvariant())
        {
            case "p" when args.ShiftKey: OpenCommandPalette(); break;
            case "p": OpenQuickOpen(); break;
            case "f" when args.ShiftKey: if (!_searchOpen) ToggleSearch(); break;
            case "o": await OpenFileAsync(); break;
            case "s" when args.ShiftKey: await SaveAsAsync(); break;
            case "s": await SaveAsync(); break;
            case "f": _showFind = true; break;
            case "t": OpenWorkspaceSymbols(); break;
            case "z" when args.ShiftKey: Redo(); break;
            case "z": Undo(); break;
            case "y": Redo(); break;
            case "\\": Split(SplitDirection.Right); break;
            case "arrowleft" when args.AltKey && args.ShiftKey: Split(SplitDirection.Left); break;
            case "arrowright" when args.AltKey && args.ShiftKey: Split(SplitDirection.Right); break;
            case "arrowup" when args.AltKey && args.ShiftKey: Split(SplitDirection.Up); break;
            case "arrowdown" when args.AltKey && args.ShiftKey: Split(SplitDirection.Down); break;
            case "arrowleft" when args.AltKey: await FocusDirectionAsync("left"); break;
            case "arrowright" when args.AltKey: await FocusDirectionAsync("right"); break;
            case "arrowup" when args.AltKey: await FocusDirectionAsync("up"); break;
            case "arrowdown" when args.AltKey: await FocusDirectionAsync("down"); break;
            case "=" when args.ShiftKey: Equalize(); break;
            case "]" when args.AltKey: await TransferToNextAsync(args.ShiftKey); break;
            case "`": await ToggleTerminalAsync(); break;
        }
    }
    private static string NormalizeGestureKey(string key) => key.Length == 1 ? key.ToUpperInvariant() : key switch
    {
        " " => "Space",
        _ => char.ToUpperInvariant(key[0]) + key[1..]
    };

