    private async Task UpdateQuickAccessAsync(string query)
    {
        _quickAccessQuery = query; _quickAccessSelected = 0;
        if (_quickAccessCommands) { _quickAccessItems = _quickAccess.FindCommands(query); return; }
        if (WorkspaceRoot is not { } root) return;
        _quickAccessCancellation?.Cancel(); _quickAccessCancellation?.Dispose();
        _quickAccessCancellation = new(); var cancellationToken = _quickAccessCancellation.Token;
        _quickAccessBusy = true;
        try { _quickAccessItems = await _quickAccess.FindFilesAsync(root, query,
            Program.Configuration.Current.ExplorerIgnoredNames, cancellationToken: cancellationToken); }
        catch (OperationCanceledException) { }
        finally { if (!cancellationToken.IsCancellationRequested) _quickAccessBusy = false; }
    }
