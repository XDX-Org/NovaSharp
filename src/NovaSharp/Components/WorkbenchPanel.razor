    private void SyncProjectDocuments()
    {
        var current = _workspace.Layout.Groups.SelectMany(group => group.Tabs).Select(tab => tab.Document).ToHashSet();
        foreach (var document in _projectDocuments.Except(current).ToArray())
        {
            _projectSystem.Untrack(document);
            _projectDocuments.Remove(document);
        }
        foreach (var document in current)
            if (_projectDocuments.Add(document)) _projectSystem.Track(document);
        _ = SyncLanguageDocumentsAsync();
    }

    private async Task SyncLanguageDocumentsAsync()
    {
        await _languageSync.WaitAsync();
        try
        {
            var current = OpenDocuments.Where(document => document.FilePath is not null).ToHashSet();
            foreach (var document in _languageDocuments.Except(current).ToArray())
            {
                var coordinator = CoordinatorFor(document.FilePath!);
                if (coordinator is not null) await coordinator.CloseAsync(document);
                _languageDocuments.Remove(document);
            }
            foreach (var document in current)
                if (!_languageDocuments.Contains(document) && CoordinatorFor(document.FilePath!) is { } coordinator)
                {
                    await coordinator.OpenAsync(document);
                    _languageDocuments.Add(document);
                }
        }
        finally { _languageSync.Release(); }
    }

