    private async Task ContentEditedAsync()
    {
        _status = null;
        StateHasChanged();
        await SaveLayoutAsync();
        _recoverySave?.Cancel();
        _recoverySave?.Dispose();
        _recoverySave = new();
        var token = _recoverySave.Token;
        var path = _document.FilePath;
        var content = _document.Content;
        if (path is null || content is null || !_document.IsDirty) return;
        _ = Task.Run(async () =>
        {
            try { await Task.Delay(500, token); await _recovery.CaptureRecoveryAsync(path, content, token); }
            catch (OperationCanceledException) { }
        }, token);
    }
