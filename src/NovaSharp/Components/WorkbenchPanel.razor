        bool resultsStreamed, bool replacePreview, string? error = null) =>
        Program.CompletePhase9SmokeAsync(new(quickOpenVisible, duplicateFilesVisible, searchVisible,
            resultsStreamed, replacePreview, error));

    [JSInvokable]
    public async Task<bool> RunPhase11TerminalSmokeAsync()
    {
        if (_terminal.ActiveSession is not { State: TerminalSessionState.Running } session) return false;
        session.Resize(80, 24);
        await session.SendAsync(System.Text.Encoding.UTF8.GetBytes("printf 'NOVASHARP_PHASE11_OK\\n'; exit 7\r"));
        for (var attempt = 0; attempt < 100; attempt++)
        {
            if (session.Transcript.Chunks.Any(chunk => System.Text.Encoding.UTF8.GetString(chunk.Data)
                .Contains("NOVASHARP_PHASE11_OK", StringComparison.Ordinal))) return true;
            await Task.Delay(50);
        }
        return false;
    }

    [JSInvokable]
    public Task CompletePhase11SmokeAsync(bool terminalPresent, bool inputRoundTrip, bool resizeValid,
        bool processExited, string? error = null) =>
        Program.CompletePhase11SmokeAsync(new(terminalPresent, inputRoundTrip, resizeValid, processExited, error));

    [JSInvokable]
    public void CancelEditorDrag() => _workspace.CancelDrag();

    [JSInvokable]
    public void BeginPointerTabDrag(string id)
    {
        if (Guid.TryParse(id, out var tabId) && _workspace.Layout.Groups
            .SelectMany(group => group.Tabs).FirstOrDefault(tab => tab.Id == tabId) is { } tab)
            _workspace.BeginDrag(tab);
    }

    [JSInvokable]
    public void BeginExplorerFileDrag(string path)
    {
        _explorerFileDrag = path;
        StateHasChanged();
    }

    [JSInvokable]
    public void CancelExplorerFileDrag()
    {
        _explorerFileDrag = null;
        StateHasChanged();
    }

    [JSInvokable]
    public async Task DropExplorerFile(string groupId, string? direction)
    {
        var path = _explorerFileDrag;
        _explorerFileDrag = null;
        if (path is null || !Guid.TryParse(groupId, out var targetId)) { StateHasChanged(); return; }
        if (Enum.TryParse<SplitDirection>(direction, true, out var split))
            targetId = _workspace.Split(targetId, split)?.Id ?? targetId;
        await _workspace.OpenAsync(path, groupId: targetId);
        await ActiveChangedAsync();
    }

    [JSInvokable]
    public async Task DropPointerTab(string groupId, int? index, string? direction, bool copy)
    {
        if (!Guid.TryParse(groupId, out var targetId)) { _workspace.CancelDrag(); return; }
        var split = Enum.TryParse<SplitDirection>(direction, true, out var parsed) ? parsed : (SplitDirection?)null;
        await _workspace.DropAsync(targetId, index, split, copy);
        await ActiveChangedAsync();
    }

    [JSInvokable]
    public async Task FocusEditorGroup(string id)
    {
        if (Guid.TryParse(id, out var groupId) && _workspace.Focus(groupId))
        {
            TrackActiveDocument();
            await SaveLayoutAsync();
        }
    }

    public void Dispose()
    {
        _recoverySave?.Cancel();
        _recoverySave?.Dispose();
        if (_debugSession is not null) _debugSession.DisposeAsync().AsTask().GetAwaiter().GetResult();
        CloseQuickAccess();
        Task.Run(() => SaveLayoutAsync()).GetAwaiter().GetResult();
        _workspace.Changed -= WorkspaceChanged;
        _projectSystem.Changed -= ProjectSystemChanged;
        _languageProvider.Diagnostics.Changed -= DiagnosticsChanged;
        _buildRun.Changed -= BuildChanged;
        _buildRun.Output.Changed -= BuildChanged;
        UntrackActiveDocument();
        _workspace.Dispose();
        _emptyDocument.Dispose();
        _self?.Dispose();
        _projectSystem.DisposeAsync().AsTask().GetAwaiter().GetResult();
        _buildRun.DisposeAsync().AsTask().GetAwaiter().GetResult();
        _terminal.DisposeAsync().AsTask().GetAwaiter().GetResult();
        Task.WhenAll(_languageCoordinators.Values.Select(coordinator => coordinator.DisposeAsync().AsTask())).GetAwaiter().GetResult();
        Task.WhenAll(_languageServers.Select(server => server.Manager.DisposeAsync().AsTask())).GetAwaiter().GetResult();
        _languageSync.Dispose();
        if (Program.ConfirmWorkbenchClose == ConfirmClose) Program.ConfirmWorkbenchClose = null;
    }

    private bool ConfirmClose()
    {
        var confirmed = CanClose();
        if (confirmed) Task.Run(() => SaveLayoutAsync()).GetAwaiter().GetResult();
        return confirmed;
    }

    private bool CanClose()
    {
        var dirty = _workspace.Layout.Groups.SelectMany(group => group.Tabs).Where(tab => tab.Document.IsDirty)
            .DistinctBy(tab => tab.Document).ToArray();
        if (dirty.Length == 0 && !_terminal.HasRunningSessions) return true;
        if (dirty.Length == 0)
        {
            var terminalResult = Program.App.MainWindow.ShowMessageDialogAsync("Running terminals",
                "Terminate all live terminal processes and close NovaSharp?", DialogButtons.YesNo, DialogIcon.Warning)
                .GetAwaiter().GetResult();
            return terminalResult == DialogResult.Yes;
        }
        var names = string.Join(Environment.NewLine, dirty.Select(tab => $"• {tab.Document.DisplayName}"));
        var result = Program.App.MainWindow.ShowMessageDialogAsync("Unsaved changes",
            $"Save these files before closing?{Environment.NewLine}{Environment.NewLine}{names}",
            DialogButtons.YesNoCancel, DialogIcon.Warning).GetAwaiter().GetResult();
        if (result == DialogResult.No) return ConfirmTerminalShutdown();
        if (result != DialogResult.Yes) return false;
        try { foreach (var tab in dirty) tab.Document.SaveAsync().GetAwaiter().GetResult(); return ConfirmTerminalShutdown(); }
        catch { return false; }
    }

    private bool ConfirmTerminalShutdown()
    {
        if (!_terminal.HasRunningSessions) return true;
        return Program.App.MainWindow.ShowMessageDialogAsync("Running terminals",
            "Terminate all live terminal processes and close NovaSharp?", DialogButtons.YesNo, DialogIcon.Warning)
            .GetAwaiter().GetResult() == DialogResult.Yes;
    }

