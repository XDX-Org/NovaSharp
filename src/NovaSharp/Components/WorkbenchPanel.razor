    public void Dispose()
    {
        CloseQuickAccess();
        _ = SaveLayoutAsync();
        _workspace.Changed -= WorkspaceChanged;
        _projectSystem.Changed -= ProjectSystemChanged;
        _languageProvider.Diagnostics.Changed -= DiagnosticsChanged;
        _buildRun.Changed -= BuildChanged;
        _buildRun.Output.Changed -= BuildChanged;
        UntrackActiveDocument();
        _workspace.Dispose();
        _emptyDocument.Dispose();
        _self?.Dispose();
        _projectSystem.DisposeAsync().AsTask().GetAwaiter().GetResult();
        _buildRun.DisposeAsync().AsTask().GetAwaiter().GetResult();
        _terminal.DisposeAsync().AsTask().GetAwaiter().GetResult();
        if (Program.ConfirmWorkbenchClose == ConfirmClose) Program.ConfirmWorkbenchClose = null;
    }

    private bool ConfirmClose()
    {
        var dirty = _workspace.Layout.Groups.SelectMany(group => group.Tabs).Where(tab => tab.Document.IsDirty)
            .DistinctBy(tab => tab.Document).ToArray();
        if (dirty.Length == 0 && !_terminal.HasRunningSessions) return true;
        if (dirty.Length == 0)
        {
            var terminalResult = Program.App.MainWindow.ShowMessageDialogAsync("Running terminals",
                "Terminate all live terminal processes and close NovaSharp?", DialogButtons.YesNo, DialogIcon.Warning)
                .GetAwaiter().GetResult();
            return terminalResult == DialogResult.Yes;
        }
        var names = string.Join(Environment.NewLine, dirty.Select(tab => $"• {tab.Document.DisplayName}"));
        var result = Program.App.MainWindow.ShowMessageDialogAsync("Unsaved changes",
            $"Save these files before closing?{Environment.NewLine}{Environment.NewLine}{names}",
            DialogButtons.YesNoCancel, DialogIcon.Warning).GetAwaiter().GetResult();
        if (result == DialogResult.No) return ConfirmTerminalShutdown();
        if (result != DialogResult.Yes) return false;
        try { foreach (var tab in dirty) tab.Document.SaveAsync().GetAwaiter().GetResult(); return ConfirmTerminalShutdown(); }
        catch { return false; }
    }

    private bool ConfirmTerminalShutdown()
    {
        if (!_terminal.HasRunningSessions) return true;
        return Program.App.MainWindow.ShowMessageDialogAsync("Running terminals",
            "Terminate all live terminal processes and close NovaSharp?", DialogButtons.YesNo, DialogIcon.Warning)
            .GetAwaiter().GetResult() == DialogResult.Yes;
    }

