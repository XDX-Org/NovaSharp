    private async Task HandleLanguageCommandAsync(CodeEditor.EditorLanguageCommand command)
    {
        switch (command.Command)
        {
            case "navigate" when command.Target is not null: await NavigateToAsync(command.Target); break;
            case "rename": _renamePosition = command.Position; _renameName = ""; break;
            case "back": await NavigateBackAsync(); break;
            case "forward": await NavigateForwardAsync(); break;
            case "workspace-edit" when command.Edit is not null:
                _pendingWorkspaceEdit = command.Edit; _editPreview = _workspaceEdits.Preview(command.Edit); break;
            case "navigation-empty": _status = "No navigation results."; break;
        }
    }

    private NavigationState? CaptureNavigation() => ActiveTab?.Document.FilePath is { } path
        ? new(_workspace.Layout.FocusedGroupId, path, ActiveTab.ViewState.SelectionStart,
            ActiveTab.ViewState.SelectionEnd, ActiveTab.ViewState.ScrollTop, ActiveTab.ViewState.ScrollLeft) : null;

    private void RecordNavigation(NavigationState state)
    {
        if (_restoringNavigation) return;
        if (_navigationIndex >= 0 && _navigationHistory[_navigationIndex] == state) return;
        if (_navigationIndex < _navigationHistory.Count - 1)
            _navigationHistory.RemoveRange(_navigationIndex + 1, _navigationHistory.Count - _navigationIndex - 1);
        _navigationHistory.Add(state);
        if (_navigationHistory.Count > 100) _navigationHistory.RemoveAt(0);
        _navigationIndex = _navigationHistory.Count - 1;
    }

    private async Task NavigateToAsync(NavigationTarget target)
    {
        if (CaptureNavigation() is { } current) RecordNavigation(current);
        await RestoreNavigationAsync(new(_workspace.Layout.FocusedGroupId, target.DocumentPath,
            target.Range.Start, target.Range.Start + target.Range.Length, 0, 0));
        var context = _projectSystem.GetContexts(target.DocumentPath).FirstOrDefault(item => item.Name == target.ProjectName);
        if (context.Id is not null) _projectSystem.SelectContext(target.DocumentPath, context.Id);
        if (CaptureNavigation() is { } destination) RecordNavigation(destination);
        _status = $"{target.Kind}: {target.DisplayText}";
    }

    private async Task RestoreNavigationAsync(NavigationState state)
    {
        _restoringNavigation = true;
        try
        {
            var existing = _workspace.Layout.Groups.SelectMany(group => group.Tabs.Select(tab => (group, tab)))
                .FirstOrDefault(item => string.Equals(item.tab.Document.FilePath, state.DocumentPath,
                    OperatingSystem.IsWindows() ? StringComparison.OrdinalIgnoreCase : StringComparison.Ordinal));
            DocumentTab? tab;
            if (existing.tab is not null)
            {
                existing.group.Activate(existing.tab); _workspace.Focus(existing.group.Id); tab = existing.tab;
            }
            else tab = await _workspace.OpenAsync(state.DocumentPath, groupId:
                _workspace.Layout.Groups.Any(group => group.Id == state.GroupId) ? state.GroupId : null);
            if (tab is null) return;
            tab.ViewState.Restore(state.SelectionStart, state.SelectionEnd, state.ScrollTop, state.ScrollLeft,
                tab.Document.Content?.Length ?? 0);
            TrackActiveDocument();
            await SaveLayoutAsync();
        }
        finally { _restoringNavigation = false; }
    }

    private async Task NavigateBackAsync()
    {
        if (!CanNavigateBack) return;
        await RestoreNavigationAsync(_navigationHistory[--_navigationIndex]);
    }
    private async Task NavigateForwardAsync()
    {
        if (!CanNavigateForward) return;
        await RestoreNavigationAsync(_navigationHistory[++_navigationIndex]);
    }

