@using PhotinoEx.Core.Models
@using Microsoft.AspNetCore.Components.Web
@using NovaSharp.LanguageServers
@implements IDisposable
@inject IJSRuntime JS

<main @ref="_workbench" class="@WorkbenchClass" @onkeydown="HandleKeyAsync">
    <header class="toolbar">
        <div class="navigation-controls" aria-label="Navigation history">
            <button title="Back (Alt+Left)" aria-label="Back" disabled="@(!CanNavigateBack)" @onclick="NavigateBackAsync">←</button>
            <button title="Forward (Alt+Right)" aria-label="Forward" disabled="@(!CanNavigateForward)" @onclick="NavigateForwardAsync">→</button>
        </div>
        <nav class="menu-bar" aria-label="Application menu">
            @if (_openMenu is not null) { <div class="menu-dismiss" @onclick="CloseMenu"
                @oncontextmenu="CloseMenu" @oncontextmenu:preventDefault></div> }
            <div class="main-menu" @onmouseenter='() => SwitchMenu("file")'>
                <button class="menu-trigger" @onclick='() => ToggleMenu("file")' aria-expanded="@(_openMenu == "file")">File</button>
                @if (_openMenu == "file")
                {
                <div class="menu-popup" role="menu" @onclick:stopPropagation>
                    <button role="menuitem" @onclick="OpenFileAsync">Open <kbd>Ctrl+O</kbd></button>
                    <button role="menuitem" @onclick="OpenQuickOpen">Quick Open <kbd>Ctrl+P</kbd></button>
                    <button role="menuitem" @onclick="OpenSolutionAsync">Open Solution</button>
                    <button role="menuitem" @onclick="CloseSolutionAsync" disabled="@(_projectSystem.State.Path is null)">Close Solution</button>
                    <button role="menuitem" @onclick="SaveAsync" disabled="@(!_document.IsDirty)">Save <kbd>Ctrl+S</kbd></button>
                    <button role="menuitem" @onclick="SaveAsAsync" disabled="@(_document.FilePath is null)">Save As</button>
                </div>
                }
            </div>
            <div class="main-menu" @onmouseenter='() => SwitchMenu("edit")'>
                <button class="menu-trigger" @onclick='() => ToggleMenu("edit")' aria-expanded="@(_openMenu == "edit")">Edit</button>
                @if (_openMenu == "edit")
                {
                <div class="menu-popup" role="menu" @onclick:stopPropagation>
                    <button role="menuitem" @onclick="Undo" disabled="@(!_document.CanUndo)">Undo <kbd>Ctrl+Z</kbd></button>
                    <button role="menuitem" @onclick="Redo" disabled="@(!_document.CanRedo)">Redo <kbd>Ctrl+Y</kbd></button>
                    <hr />
                    <button role="menuitem" @onclick="ToggleFind">Find <kbd>Ctrl+F</kbd></button>
                    <button role="menuitem" @onclick="ToggleSearch">Search workspace <kbd>Ctrl+Shift+F</kbd></button>
                    <button role="menuitem" @onclick="OpenCommandPalette">Command palette <kbd>Ctrl+Shift+P</kbd></button>
                    <button role="menuitem" @onclick="ToggleSuggestionsAsync">Suggestions <span>@(_suggestions ? "On" : "Off")</span></button>
                </div>
                }
            </div>
            <div class="main-menu" @onmouseenter='() => SwitchMenu("view")'>
                <button class="menu-trigger" @onclick='() => ToggleMenu("view")' aria-expanded="@(_openMenu == "view")">View</button>
                @if (_openMenu == "view")
                {
                <div class="menu-popup" role="menu" @onclick:stopPropagation>
                    <button role="menuitem" @onclick="ToggleExplorerAsync">Explorer</button>
                    <button role="menuitem" @onclick="ToggleTerminalAsync">Terminal <kbd>Ctrl+`</kbd></button>
                    <button role="menuitem" @onclick="ToggleWrapAsync">Word wrap <span>@(_wordWrap ? "On" : "Off")</span></button>
                    <button role="menuitem" @onclick="OpenWorkspaceSymbols">Workspace symbols <kbd>Ctrl+T</kbd></button>
                    <button role="menuitem" @onclick="OpenSettings">Settings</button>
                </div>
                }
            </div>
            <div class="main-menu" @onmouseenter='() => SwitchMenu("run")'>
                <button class="menu-trigger" @onclick='() => ToggleMenu("run")' aria-expanded="@(_openMenu == "run")">Run</button>
                @if (_openMenu == "run")
                {
                <div class="menu-popup" role="menu" @onclick:stopPropagation>
                    <button role="menuitem" @onclick="() => StartBuildAsync(BuildOperation.Build)" disabled="@(StartupProject is null)">Build <kbd>Ctrl+Shift+B</kbd></button>
                    <button role="menuitem" @onclick="() => StartBuildAsync(BuildOperation.Rebuild)" disabled="@(StartupProject is null)">Rebuild</button>
                    <button role="menuitem" @onclick="() => StartBuildAsync(BuildOperation.Clean)" disabled="@(StartupProject is null)">Clean</button>
                    <button role="menuitem" @onclick="() => StartBuildAsync(BuildOperation.Restore)" disabled="@(StartupProject is null)">Restore</button>
                    <button role="menuitem" @onclick="() => StartBuildAsync(BuildOperation.Run)" disabled="@(StartupProject is null)">Run <kbd>Ctrl+F5</kbd></button>
                    <button role="menuitem" @onclick="RestartRunAsync" disabled="@(_buildRun.ActiveTask?.Request.Operation != BuildOperation.Run)">Restart</button>
                    <button role="menuitem" @onclick="StopBuild" disabled="@(_buildRun.ActiveTask is null)">Stop</button>
                </div>
                }
            </div>
            <div class="main-menu" @onmouseenter='() => SwitchMenu("groups")'>
                <button class="menu-trigger" @onclick='() => ToggleMenu("groups")' aria-expanded="@(_openMenu == "groups")">Groups</button>
                @if (_openMenu == "groups")
                {
                <div class="menu-popup" role="menu" @onclick:stopPropagation>
                    <button role="menuitem" @onclick="() => Split(SplitDirection.Left)">Split left</button>
                    <button role="menuitem" @onclick="() => Split(SplitDirection.Right)">Split right <kbd>Ctrl+\</kbd></button>
                    <button role="menuitem" @onclick="() => Split(SplitDirection.Up)">Split up</button>
                    <button role="menuitem" @onclick="() => Split(SplitDirection.Down)">Split down</button>
                    <button role="menuitem" @onclick="Equalize" disabled="@(_workspace.Layout.Groups.Count < 2)">Distribute evenly</button>
                    <button role="menuitem" @onclick="() => TransferToNextAsync(false)" disabled="@(ActiveTab is null)">Move view to next group</button>
                    <button role="menuitem" @onclick="() => TransferToNextAsync(true)" disabled="@(ActiveTab is null)">Copy view to next group</button>
                    <button role="menuitem" @onclick="FocusNext" disabled="@(_workspace.Layout.Groups.Count < 2)">Focus next group</button>
                    <button role="menuitem" @onclick='() => FocusDirectionAsync("left")' disabled="@(_workspace.Layout.Groups.Count < 2)">Focus left</button>
                    <button role="menuitem" @onclick='() => FocusDirectionAsync("right")' disabled="@(_workspace.Layout.Groups.Count < 2)">Focus right</button>
                    <button role="menuitem" @onclick='() => FocusDirectionAsync("up")' disabled="@(_workspace.Layout.Groups.Count < 2)">Focus up</button>
                    <button role="menuitem" @onclick='() => FocusDirectionAsync("down")' disabled="@(_workspace.Layout.Groups.Count < 2)">Focus down</button>
                </div>
                }
            </div>
        </nav>
        @if (StartupProjects.Count > 0)
        {
            <div class="build-controls" aria-label="Build and run settings">
                <div class="startup-project" title="Startup project">
                    <span class="startup-project-icon" aria-hidden="true">▶</span>
                    <span class="startup-project-name">@Path.GetFileNameWithoutExtension(StartupProject)</span>
                    <span class="startup-project-detail">@_buildConfiguration</span>
                    @if (!string.IsNullOrEmpty(_targetFramework))
                    {
                        <span class="startup-project-detail">@_targetFramework</span>
                    }
                </div>
                <button title="Open Build Configurator" aria-label="Build Configurator" @onclick="OpenBuildConfigurator">Configure…</button>
                <div class="build-actions">
                    <button title="Build startup project (Ctrl+Shift+B)" aria-label="Build startup project" @onclick="() => StartBuildAsync(BuildOperation.Build)">Build</button>
                    <button class="run-action" title="Run without debugging (Ctrl+F5)" aria-label="Run startup project" @onclick="() => StartBuildAsync(BuildOperation.Run)">Run</button>
                    <button title="Start debugging (F5)" aria-label="Start debugging" @onclick="StartDebugAsync">Debug</button>
                    <button class="stop-action" title="Stop build or run" aria-label="Stop build or run" disabled="@(_buildRun.ActiveTask is null)" @onclick="StopBuild">■</button>
                </div>
            </div>
        }
    </header>
    @if (_showFind)
    {
        <div class="findbar">
            <input aria-label="Find" @bind="_query" @bind:event="oninput" />
            <input aria-label="Replace" @bind="_replacement" />
            <span>@_document.Find(_query).Count matches</span>
            <button @onclick="ReplaceAll">Replace all</button>
            <button @onclick="ToggleFind" aria-label="Close find">×</button>
        </div>
    }
    @if (_externalChange)
    {
        <div class="conflict" role="alert">
            <span>@(_document.IsDeletedOnDisk ? "The file was deleted outside NovaSharp." : "The file changed outside NovaSharp.")</span>
            <button @onclick="ReloadAsync">Reload disk version</button>
            <button @onclick="KeepBuffer">Keep editor version</button>
        </div>
    }
    <div class="workbench-body">
        <div class="editor-area">
            <EditorGroupLayoutView @key="_workspace.Layout.Root.Id" Node="_workspace.Layout.Root" Workspace="_workspace" WordWrap="_wordWrap"
                                   ProjectSystem="_projectSystem" LanguageProvider="_languageProvider"
                                   Diagnostics="_languageProvider.Diagnostics.Entries"
                                   LanguageAnalysisRevision="_languageAnalysisRevision"
                                   SuggestionsEnabled="_suggestions" SemanticHighlighting="Program.Configuration.Current.SemanticHighlighting"
                                   ExternalDragActive="_explorerFileDrag is not null"
                                   ActiveChanged="ActiveChangedAsync" ContentEdited="ContentEditedAsync"
                                   CloseRequested="CloseRequestedAsync" LanguageCommand="HandleLanguageCommandAsync" />
            <ProblemsPanel Open="_problemsOpen" Diagnostics="_languageProvider.Diagnostics.Entries"
                           Activated="OpenProblemAsync" />
            <OutputPanel Open="_outputOpen" Task="_buildRun.Tasks.LastOrDefault()" Entries="_buildRun.Output.Entries"
                         Activated="OpenOutputAsync" Input="SendProcessInputAsync" Copy="CopyOutputAsync"
                         Export="ExportOutputAsync" Clear="_buildRun.Output.Clear" />
            <TerminalPanel Open="_terminalOpen" Service="_terminal" WorkingDirectory="@(Program.Phase11Workspace ?? WorkspaceRoot)"
                           ConfirmClose="ConfirmTerminalCloseAsync" />
            <DebugPanel Open="_debugOpen" Session="_debugSession" Stopped="StopDebugAsync" Restarted="RestartDebugAsync"
                        RunToCursorRequested="RunDebugToCursorAsync" />
        </div>
        <SearchPanel @ref="_searchPanel" Open="_searchOpen" RootPath="WorkspaceRoot" OpenDocuments="OpenDocuments"
                     Activated="OpenSearchMatchAsync" PreviewRequested="PreviewSearchReplace"
                     Close="ToggleSearch" />
        <WorkspaceExplorer @ref="_explorer" Document="_document" ProjectSystem="_projectSystem" FileOpened="OpenWorkspaceFileAsync"
                           FilePreviewed="PreviewWorkspaceFileAsync" OpenChanged="ExplorerOpenChanged"
                           WorkspaceOpened="OfferWorkspaceSolutionAsync" />
        <nav class="activity-bar" aria-label="Tool windows">
            <button class="@(_explorerOpen ? "active" : null)" @onclick="ToggleExplorerAsync" aria-label="Explorer"
                    title="Explorer" aria-pressed="@_explorerOpen">
                <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M3 5.5h6l2 2h10v11H3z" /></svg>
            </button>
            <button class="@(_problemsOpen ? "active" : null)" @onclick="ToggleProblems" aria-label="Problems"
                    title="Problems" aria-pressed="@_problemsOpen">
                <span class="activity-problems" aria-hidden="true">!</span>
                @if (_languageProvider.Diagnostics.Entries.Count > 0) { <small>@_languageProvider.Diagnostics.Entries.Count</small> }
            </button>
            <button class="@(_searchOpen ? "active" : null)" @onclick="ToggleSearch" aria-label="Search"
                    title="Search" aria-pressed="@_searchOpen"><span aria-hidden="true">⌕</span></button>
            <button class="@(_outputOpen ? "active" : null)" @onclick="ToggleOutput" aria-label="Output"
                    title="Output" aria-pressed="@_outputOpen"><span aria-hidden="true">›_</span></button>
            <button class="@(_terminalOpen ? "active" : null)" @onclick="ToggleTerminalAsync" aria-label="Terminal"
                    title="Terminal" aria-pressed="@_terminalOpen"><span aria-hidden="true">⌘</span></button>
        </nav>
    </div>
    <footer class="statusbar">
        @if (ActiveContexts.Count > 1)
        {
            <select aria-label="Active project context" value="@ActiveContextId" @onchange="SelectContext">
                @foreach (var context in ActiveContexts) { <option value="@context.Id.Id">@context.Name</option> }
            </select>
        }
        <div class="language-server-indicators" aria-label="Language servers">
            <ServerStatusIndicator Label="C#" Status="ServerStatus(LanguageServerKind.RoslynRazor)" />
            <ServerStatusIndicator Label="Razor" Status="ServerStatus(LanguageServerKind.RoslynRazor)" />
            <ServerStatusIndicator Label="HTML" Status="ServerStatus(LanguageServerKind.Html)" />
            <ServerStatusIndicator Label="CSS" Status="ServerStatus(LanguageServerKind.Css)" />
        </div>
    </footer>
    @if (_buildConfiguratorOpen)
    {
        <div class="modal-backdrop" @onclick="CloseBuildConfigurator">
            <form class="modal-dialog build-configurator" role="dialog" aria-modal="true" aria-labelledby="build-configurator-title" @onclick:stopPropagation @onsubmit="ApplyBuildConfigurator">
                <h2 id="build-configurator-title">Build Configurator</h2>
                <label>Startup project<select value="@_configuredProject" @onchange="ConfigureProjectChanged">@foreach (var project in StartupProjects) { <option value="@project">@Path.GetFileNameWithoutExtension(project)</option> }</select></label>
                <label>Configuration<select @bind="_configuredConfiguration">@foreach (var configuration in _availableConfigurations) { <option>@configuration</option> }</select></label>
                <label>Target framework<select @bind="_configuredFramework">@foreach (var framework in _availableFrameworks) { <option>@framework</option> }</select></label>
                <label>Launch profile<select @bind="_configuredProfile"><option value="">None</option>@foreach (var profile in _availableProfiles) { <option value="@profile.Name">@profile.Name</option> }</select></label>
                <label>Arguments<input @bind="_configuredArguments" /></label>
                <label>Working directory<span class="path-picker"><input @bind="_configuredWorkingDirectory" /><button type="button" title="Select working directory" aria-label="Select working directory" @onclick="SelectWorkingDirectoryAsync"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M1.5 3.5h5l1.4 1.6h6.6v7.4h-13z" /></svg></button></span></label>
                <p><strong>Preview:</strong> dotnet run --project @Path.GetFileName(_configuredProject) --configuration @_configuredConfiguration --framework @_configuredFramework</p>
                <div class="modal-actions"><button type="submit">Apply</button><button type="button" @onclick="CloseBuildConfigurator">Cancel</button></div>
            </form>
        </div>
    }
    @if (_settingsOpen)
    {
        <div class="modal-backdrop" @onclick="CloseSettings">
            <form class="modal-dialog settings-dialog" role="dialog" aria-modal="true" aria-labelledby="settings-title" @onclick:stopPropagation @onsubmit="SaveSettingsAsync">
                <h2 id="settings-title">Settings</h2>
                <label class="settings-field"><span>Scope</span><select @bind="_settingsScope"><option value="User">User</option><option value="Workspace" disabled="@(WorkspaceRoot is null)">Workspace</option></select></label>
                <label class="settings-field"><span>Theme</span><select @bind="_settingsTheme"><option>Rider Dark</option><option>Light</option></select></label>
                <label class="settings-field"><span>Zoom (%)</span><input type="number" min="50" max="200" step="10" @bind="_settingsZoom" /></label>
                <div class="settings-switches">
                    <label class="settings-switch"><span>Reduced motion</span><input type="checkbox" @bind="_settingsReducedMotion" /><span class="switch-track" aria-hidden="true"></span></label>
                    <label class="settings-switch"><span>High contrast</span><input type="checkbox" @bind="_settingsHighContrast" /><span class="switch-track" aria-hidden="true"></span></label>
                    <label class="settings-switch"><span>Editor ligatures</span><input type="checkbox" @bind="_settingsLigatures" /><span class="switch-track" aria-hidden="true"></span></label>
                </div>
                <label class="settings-field"><span>Popup location</span><select @bind="_settingsPopupPlacement"><option value="Contextual">Follow caret or pointer</option><option value="TopLeft">Top left</option><option value="TopCenter">Top center</option><option value="TopRight">Top right</option><option value="LeftCenter">Left center</option><option value="RightCenter">Right center</option><option value="BottomLeft">Bottom left</option><option value="BottomCenter">Bottom center</option><option value="BottomRight">Bottom right</option></select></label>
                <fieldset class="settings-keybindings"><legend>Keyboard shortcuts</legend>
                    @foreach (var command in _commands.Commands.Where(item => item.Keybinding is not null))
                    {
                        <label><span>@command.Title</span><input aria-label="Shortcut for @command.Title" value="@SettingKeybinding(command)" @onchange="args => SetKeybinding(command.Id, args.Value?.ToString() ?? string.Empty)" /></label>
                    }
                </fieldset>
                <div class="modal-actions"><button type="submit">Save</button><button type="button" @onclick="CloseSettings">Cancel</button></div>
            </form>
        </div>
    }
    @if (_renamePosition is not null)
    {
        <div class="modal-backdrop" @onclick="CancelRename">
            <form class="modal-dialog" role="dialog" aria-modal="true" aria-labelledby="rename-title"
                  @onclick:stopPropagation @onsubmit="PreviewRenameAsync" @onsubmit:preventDefault>
                <h2 id="rename-title">Rename symbol</h2>
                <label class="modal-field"><span>New name</span><input @bind="_renameName" autofocus /></label>
                <div class="modal-actions"><button type="submit">Preview</button><button type="button" @onclick="CancelRename">Cancel</button></div>
            </form>
        </div>
    }
    @if (_editPreview is not null)
    {
        <div class="modal-backdrop" @onclick="CancelEditPreview">
            <div class="modal-dialog edit-preview" role="dialog" aria-modal="true" aria-labelledby="preview-title" @onclick:stopPropagation>
                <h2 id="preview-title">@_editPreview.Title</h2>
                <p>@_editPreview.ChangedFileCount files · @_editPreview.ChangedCharacterCount changed characters</p>
                <ul>@foreach (var item in _editPreview.Documents)
                    {
                        <li>@item.DocumentPath
                            @if (item.ExpectedRanges is { Count: > 0 })
                            {
                                <small> — @string.Join(", ", item.ExpectedRanges.Select(range => $"{range.Start}–{range.Start + range.Length}"))</small>
                            }
                        </li>
                    }
                    @foreach (var item in _editPreview.Resources ?? [])
                    {
                        <li>@item.Kind: @item.Path@if (item.NewPath is not null) { <text> → @item.NewPath</text> }</li>
                    }</ul>
                <div class="modal-actions"><button @onclick="ApplyWorkspaceEditAsync">Apply</button><button @onclick="CancelEditPreview">Cancel</button></div>
            </div>
        </div>
    }
    @if (_symbolSearchOpen)
    {
        <div class="modal-backdrop" @onclick="CloseWorkspaceSymbols">
            <form class="modal-dialog symbol-search" role="dialog" aria-modal="true" aria-labelledby="symbols-title"
                  @onclick:stopPropagation @onsubmit="SearchWorkspaceSymbolsAsync" @onsubmit:preventDefault>
                <h2 id="symbols-title">Workspace symbols</h2>
                <label class="modal-field"><span>Symbol name</span><input @bind="_symbolQuery" autofocus /></label>
                <div class="symbol-results">
                    @foreach (var symbol in _workspaceSymbols)
                    {
                        <button type="button" @onclick="() => OpenSymbolAsync(symbol)"><span>@symbol.Name</span><small>@symbol.ProjectName · @Path.GetFileName(symbol.DocumentPath)</small></button>
                    }
                </div>
                <div class="modal-actions"><button type="submit">Search</button><button type="button" @onclick="CloseWorkspaceSymbols">Close</button></div>
            </form>
        </div>
    }
    <QuickAccessOverlay Open="_quickAccessOpen" Commands="_quickAccessCommands" Query="_quickAccessQuery"
                        Busy="_quickAccessBusy" Items="_quickAccessItems" Selected="_quickAccessSelected"
                        QueryChanged="UpdateQuickAccessAsync" SelectedChanged="value => _quickAccessSelected = value"
                        Activate="ActivateQuickAccessAsync" Close="CloseQuickAccess" />
</main>

@code {
    private readonly EditorGroupWorkspace _workspace = new();
    private readonly RoslynProjectSystem _projectSystem = new();
    private readonly LspLanguageProvider _languageProvider;
    private readonly HashSet<EditorDocumentState> _projectDocuments = [];
    private readonly WorkspaceEditTransaction _workspaceEdits = new();
    private readonly CommandRegistry _commands = new();
    private readonly QuickAccessService _quickAccess;
    private readonly BuildRunService _buildRun;
    private readonly TerminalService _terminal = new();
    private DebugAdapterSession? _debugSession;
    private readonly List<(LanguageServerKind Kind, LanguageServerManager Manager)> _languageServers = [];
    private readonly Dictionary<LanguageServerManager, LanguageDocumentCoordinator> _languageCoordinators = [];
    private readonly HashSet<EditorDocumentState> _languageDocuments = [];
    private readonly SemaphoreSlim _languageSync = new(1, 1);
    private readonly Dictionary<LanguageServerKind, LanguageServerStatus> _languageServerStatuses = new()
    {
        [LanguageServerKind.RoslynRazor] = new(LanguageServerState.Stopped, Detail: "Waiting for workspace restoration."),
        [LanguageServerKind.Html] = new(LanguageServerState.Stopped, Detail: "Waiting for workspace restoration."),
        [LanguageServerKind.Css] = new(LanguageServerState.Stopped, Detail: "Waiting for workspace restoration.")
    };
    private readonly List<NavigationState> _navigationHistory = [];
    private readonly EditorDocumentState _emptyDocument = new();
    private EditorLayoutPersistence _persistence = null!;
    private EditorLayoutPersistence _globalPersistence = null!;
    private WorkbenchLayoutState? _lastNonEmptyLayout;
    private WorkbenchPersistence _recovery = null!;
    private BuildConfigurationStore _buildConfigurationStore = null!;
    private StartupRestoreGuard _restoreGuard = null!;
    private CancellationTokenSource? _recoverySave;
    private WorkspaceExplorer? _explorer;
    private SearchPanel? _searchPanel;
    private ElementReference _workbench;
    private DotNetObjectReference<WorkbenchPanel>? _self;
    private string? _status;
    private string? _explorerFileDrag;
    private string _query = "", _replacement = "";
    private string? _openMenu;
    private int? _renamePosition;
    private string _renameName = "", _symbolQuery = "";
    private string _quickAccessQuery = "";
    private string _buildConfiguration = "Debug";
    private string? _targetFramework, _launchProfile, _runWorkingDirectory;
    private IReadOnlyList<string> _runArguments = [];
    private bool _buildConfiguratorOpen;
    private bool _settingsOpen, _settingsReducedMotion, _settingsHighContrast, _settingsLigatures;
    private string _settingsTheme = "Rider Dark";
    private string _settingsScope = "User";
    private string _settingsPopupPlacement = "Contextual";
    private Dictionary<string, string> _settingsKeybindings = [];
    private int _settingsZoom = 100;
    private string _configuredProject = "", _configuredConfiguration = "Debug", _configuredFramework = "", _configuredProfile = "", _configuredArguments = "", _configuredWorkingDirectory = "";
    private IReadOnlyList<string> _availableConfigurations = ["Debug", "Release"], _availableFrameworks = [];
    private IReadOnlyList<LaunchProfile> _availableProfiles = [];
    private string? _startupProject;
    private string? _persistedSolutionPath;
    private WorkspaceEdit? _pendingWorkspaceEdit;
    private WorkspaceEditPreview? _editPreview;
    private IReadOnlyList<SymbolEntry> _workspaceSymbols = [];
    private IReadOnlyList<QuickAccessItem> _quickAccessItems = [];
    private CancellationTokenSource? _quickAccessCancellation;
    private int _quickAccessSelected;
    private int _navigationIndex = -1;
    private bool _restoringNavigation, _symbolSearchOpen, _searchOpen;
    private long _languageAnalysisRevision;
    private bool _quickAccessOpen, _quickAccessCommands, _quickAccessBusy;
    private bool _projectReloading, _outputOpen, _terminalOpen, _debugOpen;
    private bool _showFind, _wordWrap, _externalChange, _explorerOpen = true, _problemsOpen, _suggestions = true;
    private DocumentTab? ActiveTab => _workspace.FocusedGroup.ActiveTab;
    private EditorDocumentState _document => ActiveTab?.Document ?? _emptyDocument;
    private IReadOnlyList<(Microsoft.CodeAnalysis.ProjectId Id, string Name)> ActiveContexts =>
        _document.FilePath is { } path ? _projectSystem.GetContexts(path) : [];
    private string? ActiveContextId => _document.FilePath is { } path
        ? _projectSystem.GetActiveDocument(path)?.Project.Id.Id.ToString() : null;
    private bool CanNavigateBack => _navigationIndex > 0;
    private bool CanNavigateForward => _navigationIndex >= 0 && _navigationIndex < _navigationHistory.Count - 1;
    private string? WorkspaceRoot => _projectSystem.State.Path is { } path
        ? Path.GetDirectoryName(path) : _explorer?.RootPath;
    private IReadOnlyList<EditorDocumentState> OpenDocuments => _workspace.Layout.Groups.SelectMany(group => group.Tabs)
        .Select(tab => tab.Document).Distinct().ToArray();
    private IReadOnlyList<string> StartupProjects => _projectSystem.CurrentSolution?.Projects.Select(project => project.FilePath)
        .Where(path => path is not null).Cast<string>().Distinct().Order().ToArray() ?? [];
    private string? StartupProject => _startupProject is { } selected
        ? StartupProjects.FirstOrDefault(project => PathsEqual(project, selected)) ?? StartupProjects.FirstOrDefault()
        : StartupProjects.FirstOrDefault();
    private string WorkbenchClass => $"workbench {(Program.Configuration.Current.Theme == "Light" ? "theme-light" : "theme-dark")}{(Program.Configuration.Current.HighContrast ? " high-contrast" : "")}{(Program.Configuration.Current.ReducedMotion ? " reduced-motion" : "")}{(Program.Configuration.Current.Ligatures ? " editor-ligatures" : "")} popup-placement-{Program.Configuration.Current.PopupPlacement.ToLowerInvariant()}";

    public WorkbenchPanel()
    {
        _languageProvider = new(path => _languageServers.FirstOrDefault(server =>
                ServerHandles(server.Kind, Path.GetExtension(path))).Manager,
            path => OpenDocuments.FirstOrDefault(document => document.FilePath is not null
                && PathsEqual(document.FilePath, path))?.CreateSnapshot(), synchronize: (path, token) =>
                    CoordinatorFor(path)?.SynchronizeAsync(path, token) ?? Task.CompletedTask);
        _buildRun = new(_languageProvider.Diagnostics);
        _quickAccess = new(_commands);
        RegisterCommands();
    }

    protected override async Task OnInitializedAsync()
    {
        string? restoredStartupProject = null;
        WorkbenchLayoutState? restoredState = null;
        _wordWrap = Program.Configuration.Current.WordWrap;
        _suggestions = Program.Configuration.Current.AutoCompletion;
        var applicationData = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData), "NovaSharp");
        _globalPersistence = new(Path.Combine(applicationData, "workbench-session.json"));
        _persistence = _globalPersistence;
        _recovery = new(Path.Combine(applicationData, "workbench-state.json"), Path.Combine(applicationData, "recovery"));
        _buildConfigurationStore = new(Path.Combine(applicationData, "build-configurations"));
        _restoreGuard = new(Path.Combine(applicationData, "restore-attempts.json"));
        _workspace.Changed += WorkspaceChanged;
        _projectSystem.Changed += ProjectSystemChanged;
        _languageProvider.Diagnostics.Changed += DiagnosticsChanged;
        _buildRun.Changed += BuildChanged;
        _buildRun.Output.Changed += BuildChanged;
        Program.ConfirmWorkbenchClose = ConfirmClose;
        if (Program.Phase5Workspace is not null)
        {
            var path = Directory.EnumerateFiles(Program.Phase5Workspace, "*.cs").First();
            var tab = await _workspace.OpenAsync(path);
            var source = _workspace.FocusedGroup;
            var target = _workspace.Split(source.Id, SplitDirection.Right)!;
            await _workspace.CopyAsync(tab!, target.Id);
            _workspace.Focus(source.Id);
        }
        else if (Program.Phase4Workspace is not null)
            foreach (var path in Directory.EnumerateFiles(Program.Phase4Workspace, "*.cs").Order()) await _workspace.OpenAsync(path);
        else if (Program.SmokeFile is not null) await OpenTabAsync(Program.SmokeFile);
        else
        {
            if (await _restoreGuard.BeginAsync())
            {
                var state = await _globalPersistence.LoadAsync();
                var storedRoot = state.WorkspacePath ?? (state.SolutionPath is { } storedSolution
                    ? Path.GetDirectoryName(storedSolution) : null);
                if (storedRoot is not null)
                {
                    var workspaceStatePath = WorkspaceStatePath(storedRoot);
                    if (File.Exists(workspaceStatePath))
                    {
                        _persistence = new(workspaceStatePath);
                        state = await _persistence.LoadAsync();
                    }
                    _buildConfigurationStore = BuildConfigurationStoreFor(storedRoot);
                }
                _persistedSolutionPath = state.SolutionPath;
                restoredState = state;
                if (state.SolutionPath is { } persistedSolution)
                    _buildConfigurationStore = BuildConfigurationStoreFor(Path.GetDirectoryName(persistedSolution)!);
                if (HasTabs(state.Root)) _lastNonEmptyLayout = state;
                await _workspace.RestoreAsync(state);
                _explorerOpen = state.ExplorerOpen;
                _searchOpen = state.SearchOpen;
                _problemsOpen = state.ProblemsOpen;
                _outputOpen = state.OutputOpen;
                _terminalOpen = state.TerminalOpen;
                restoredStartupProject = state.StartupProject;
                if (state.SolutionPath is { } solutionPath && File.Exists(solutionPath))
                    await _projectSystem.OpenAsync(solutionPath);
                await _restoreGuard.CompleteAsync();
            }
            else _status = "Safe mode: workbench layout restoration was disabled after repeated startup failures.";
        }
        var smokeSolution = Program.Phase15Solution ?? Program.Phase9Solution ?? Program.Phase8Solution
            ?? Program.Phase7Solution ?? Program.Phase6Solution;
        if (smokeSolution is not null)
        {
            _buildConfigurationStore = BuildConfigurationStoreFor(Path.GetDirectoryName(smokeSolution)!);
            await _projectSystem.OpenAsync(smokeSolution);
            _persistedSolutionPath = smokeSolution;
        }
        if (restoredStartupProject is not null && StartupProjects.Any(project => PathsEqual(project, restoredStartupProject)))
            _startupProject = StartupProjects.First(project => PathsEqual(project, restoredStartupProject));
        if (StartupProject is { } startupProject)
        {
            _startupProject = startupProject;
            await RestoreBuildConfigurationAsync(startupProject);
            RestoreActiveBuildConfiguration(restoredState, startupProject);
        }
        if (Program.Phase11Workspace is not null) _terminalOpen = true;
        foreach (var recovery in await _recovery.LoadRecoveryAsync())
        {
            var document = OpenDocuments.FirstOrDefault(item => item.FilePath is not null && PathsEqual(item.FilePath, recovery.OriginalPath));
            if (document is not null && document.Content != recovery.Content) document.Content = recovery.Content;
        }
        TrackActiveDocument();
        if (Program.Phase2SmokeFile is null && Program.Phase3Workspace is null
            && Program.Phase4Workspace is null && Program.Phase5Workspace is null
            && Program.Phase11Workspace is null)
        {
            try { await StartLanguageServersAsync(); }
            catch (Exception exception) { _status = $"Language service startup failed: {exception.Message}"; }
        }
    }

    private async Task StartLanguageServersAsync()
    {
        var configured = Program.Phase15Solution ?? Program.Phase9Solution ?? Program.Phase8Solution
            ?? Program.Phase7Solution ?? Program.Phase6Solution;
        var workspace = configured is null
            ? Program.Phase11Workspace ?? Program.Phase5Workspace ?? Program.Phase4Workspace
                ?? Program.Phase3Workspace ?? WorkspaceRoot ?? Directory.GetCurrentDirectory()
            : Path.GetDirectoryName(configured)!;
        foreach (var definition in LanguageServerCatalog.Discover(workspace).Definitions)
        {
            var manager = new LanguageServerManager(definition, workspace);
            manager.SetApplyWorkspaceEditHandler(PreviewServerWorkspaceEditAsync);
            manager.StatusChanged += status => LanguageServerStatusChanged(definition.Kind, status);
            var coordinator = new LanguageDocumentCoordinator(manager);
            var publisher = new LspDiagnosticPublisher(definition.Kind.ToString(), _languageProvider.Diagnostics,
                path => OpenDocuments.FirstOrDefault(document => document.FilePath is not null
                    && PathsEqual(document.FilePath, path))?.CreateSnapshot());
            manager.DiagnosticsPublished += published => publisher.Publish(published);
            manager.DiagnosticRefreshRequested += () =>
                _ = InvokeAsync(() => { _languageAnalysisRevision++; StateHasChanged(); });
            manager.Ready += () => _ = ReplayAndAnalyzeAsync(definition.Kind, coordinator);
            manager.CapabilitiesChanged += LanguageServerCapabilitiesChanged;
            _languageServers.Add((definition.Kind, manager));
            _languageCoordinators.Add(manager, coordinator);
            _languageServerStatuses[definition.Kind] = manager.Status;
        }
        var razor = ServerManager(LanguageServerKind.RoslynRazor);
        var html = ServerManager(LanguageServerKind.Html);
        if (razor is not null && html is not null)
        {
            var bridge = new RazorHtmlBridge(() => html.IsReady, html.NotifyAsync,
                (method, parameters, token) => html.RequestAsync<System.Text.Json.JsonElement>(method, parameters, token));
            razor.SetRazorHtmlBridge(bridge);
            html.Ready += () => _ = bridge.ReplayAsync();
        }
        await Task.WhenAll(_languageServers.Select(server => server.Manager.StartAsync()));
        await SyncLanguageDocumentsAsync();
    }

    private async Task<bool> PreviewServerWorkspaceEditAsync(System.Text.Json.JsonElement edit,
        CancellationToken cancellationToken)
    {
        WorkspaceEdit? converted;
        try { converted = await _languageProvider.WorkspaceEditAsync("Language server edit", edit, cancellationToken); }
        catch (InvalidDataException exception)
        {
            await InvokeAsync(() => { _status = exception.Message; StateHasChanged(); });
            return false;
        }
        if (converted is null) return false;
        await InvokeAsync(() =>
        {
            _pendingWorkspaceEdit = converted;
            _editPreview = _workspaceEdits.Preview(converted);
            StateHasChanged();
        });
        return false;
    }

    private async Task ReplayAndAnalyzeAsync(LanguageServerKind kind, LanguageDocumentCoordinator coordinator)
    {
        try
        {
            await coordinator.ReplayAsync();
            await AnalyzeOpenDocumentsAsync(kind);
            await InvokeAsync(() => { _languageAnalysisRevision++; StateHasChanged(); });
        }
        catch (Exception exception) when (exception is OperationCanceledException or IOException
            or StreamJsonRpc.ConnectionLostException) { }
    }

    private async Task AnalyzeOpenDocumentsAsync(LanguageServerKind kind)
    {
        var documents = OpenDocuments.Where(document => document.FilePath is { } path
            && ServerHandles(kind, Path.GetExtension(path))).ToArray();
        foreach (var document in documents)
        {
            var snapshot = document.CreateSnapshot();
            await _languageProvider.GetDiagnosticsAsync(
                new(snapshot.Path, null, snapshot.Version, snapshot.Text.Length), default);
        }
    }

    private void LanguageServerCapabilitiesChanged() => _ = InvokeAsync(() =>
    {
        _languageAnalysisRevision++;
        StateHasChanged();
    });

    private async Task ReplaceLanguageServersAsync()
    {
        await StopLanguageServersAsync();
        await StartLanguageServersAsync();
    }

    private async Task StopLanguageServersAsync()
    {
        foreach (var coordinator in _languageCoordinators.Values) await coordinator.DisposeAsync();
        foreach (var server in _languageServers) await server.Manager.DisposeAsync();
        _languageCoordinators.Clear();
        _languageServers.Clear();
        _languageDocuments.Clear();
    }

    private LanguageServerStatus ServerStatus(LanguageServerKind kind) => _languageServerStatuses[kind];

    private void LanguageServerStatusChanged(LanguageServerKind kind, LanguageServerStatus status) => _ = InvokeAsync(() =>
    {
        _languageServerStatuses[kind] = status;
        if (status.State == LanguageServerState.Restarting) _languageProvider.Diagnostics.SetProducerStale(kind.ToString(), true);
        else if (status.State == LanguageServerState.Ready)
        {
            _languageProvider.Diagnostics.SetProducerStale(kind.ToString(), false);
            _languageAnalysisRevision++;
        }
        else if (status.State == LanguageServerState.Unavailable) _languageProvider.Diagnostics.ClearProducer(kind.ToString());
        StateHasChanged();
    });

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _self = DotNetObjectReference.Create(this);
        await RecoverWorkspaceSolutionAsync();
        await JS.InvokeVoidAsync("novaSharp.initEditorDragCleanup", _workbench, _self);
        await JS.InvokeVoidAsync("novaSharp.initPointerTabDrag", _workbench, _self);
        await JS.InvokeVoidAsync("novaSharp.initExplorerFileDrag", _workbench, _self);
        await JS.InvokeVoidAsync("novaSharp.initBottomPanelResize", _workbench);
        if (Program.Phase4Workspace is not null || Program.Phase5Workspace is not null)
            await JS.InvokeVoidAsync("novaSharp.startSmokePolling", _self,
                Program.Phase4Workspace is not null, Program.Phase5Workspace is not null);
        if (Program.Phase6Solution is not null)
            await JS.InvokeVoidAsync("novaSharp.runPhase6Smoke", _self);
        if (Program.Phase9Solution is not null)
            await JS.InvokeVoidAsync("novaSharp.runPhase9Smoke", _workbench, _self);
        if (Program.Phase11Workspace is not null)
        {
            await Task.Delay(100);
            await JS.InvokeVoidAsync("novaSharp.runPhase11Smoke", _workbench, _self);
        }
    }

    private async Task RecoverWorkspaceSolutionAsync()
    {
        if (_projectSystem.State.Path is not null || _explorer?.RootPath is not { } root
            || Program.Phase3Workspace is not null) return;
        await OfferWorkspaceSolutionAsync(root);
