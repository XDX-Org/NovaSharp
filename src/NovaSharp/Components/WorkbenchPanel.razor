    private async Task CloseSolutionAsync()
    {
        _openMenu = null;
        if (_projectSystem.State.Path is not { } solutionPath) return;
        var root = Path.GetDirectoryName(solutionPath)!;
        var comparer = OperatingSystem.IsWindows() ? StringComparer.OrdinalIgnoreCase : StringComparer.Ordinal;
        var solutionDocuments = _projectSystem.CurrentSolution?.Projects.SelectMany(project =>
                project.Documents.Select(document => document.FilePath)
                    .Concat(project.AdditionalDocuments.Select(document => document.FilePath)))
            .Where(path => path is not null).Select(path => Path.GetFullPath(path!)).ToHashSet(comparer) ?? [];
        var tabs = _workspace.Layout.Groups.SelectMany(group => group.Tabs)
            .Where(tab => tab.Document.FilePath is { } path
                && (solutionDocuments.Contains(Path.GetFullPath(path)) || IsUnderRoot(path, root))).ToArray();
        await CloseRequestedAsync(new(tabs));
        if (tabs.Any(tab => _workspace.Layout.Groups.Any(group => group.Tabs.Contains(tab)))) return;

        await StopLanguageServersAsync();
        await _projectSystem.CloseAsync();
        if (_explorer is not null) await _explorer.CloseWorkspaceAsync();
        _persistedSolutionPath = null;
        _startupProject = null;
        _languageProvider.Diagnostics.Clear();
        _persistence = _globalPersistence;
        await SaveLayoutAsync(allowEmpty: true);
    }
    private static bool IsUnderRoot(string path, string root)
    {
        var relative = Path.GetRelativePath(root, Path.GetFullPath(path));
        return relative != ".." && !relative.StartsWith($"..{Path.DirectorySeparatorChar}", StringComparison.Ordinal)
            && !Path.IsPathFullyQualified(relative);
    }
    private static string WorkspaceStatePath(string root) => Path.Combine(root, ".Nova", "workspace.json");
    private static BuildConfigurationStore BuildConfigurationStoreFor(string root) =>
        new(Path.Combine(root, ".Nova", "configurations"));
