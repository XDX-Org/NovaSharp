@using PhotinoEx.Core.Models
@using Microsoft.AspNetCore.Components.Web
@implements IDisposable
@inject IJSRuntime JS

<main @ref="_workbench" class="workbench" @onkeydown="HandleKeyAsync">
    <header class="toolbar">
        <nav class="menu-bar" aria-label="Application menu">
            @if (_openMenu is not null) { <div class="menu-dismiss" @onclick="CloseMenu"></div> }
            <div class="main-menu">
                <button class="menu-trigger" @onclick='() => ToggleMenu("file")' aria-expanded="@(_openMenu == "file")">File</button>
                @if (_openMenu == "file")
                {
                <div class="menu-popup" role="menu" @onclick:stopPropagation>
                    <button role="menuitem" @onclick="OpenFileAsync">Open <kbd>Ctrl+O</kbd></button>
                    <button role="menuitem" @onclick="OpenSolutionAsync">Open Solution</button>
                    <button role="menuitem" @onclick="SaveAsync" disabled="@(!_document.IsDirty)">Save <kbd>Ctrl+S</kbd></button>
                    <button role="menuitem" @onclick="SaveAsAsync" disabled="@(_document.FilePath is null)">Save As</button>
                </div>
                }
            </div>
            <div class="main-menu">
                <button class="menu-trigger" @onclick='() => ToggleMenu("edit")' aria-expanded="@(_openMenu == "edit")">Edit</button>
                @if (_openMenu == "edit")
                {
                <div class="menu-popup" role="menu" @onclick:stopPropagation>
                    <button role="menuitem" @onclick="Undo" disabled="@(!_document.CanUndo)">Undo <kbd>Ctrl+Z</kbd></button>
                    <button role="menuitem" @onclick="Redo" disabled="@(!_document.CanRedo)">Redo <kbd>Ctrl+Y</kbd></button>
                    <hr />
                    <button role="menuitem" @onclick="ToggleFind">Find <kbd>Ctrl+F</kbd></button>
                </div>
                }
            </div>
            <div class="main-menu">
                <button class="menu-trigger" @onclick='() => ToggleMenu("view")' aria-expanded="@(_openMenu == "view")">View</button>
                @if (_openMenu == "view")
                {
                <div class="menu-popup" role="menu" @onclick:stopPropagation>
                    <button role="menuitem" @onclick="ToggleExplorerAsync">Explorer</button>
                    <button role="menuitem" @onclick="ToggleWrapAsync">Word wrap <span>@(_wordWrap ? "On" : "Off")</span></button>
                </div>
                }
            </div>
            <div class="main-menu">
                <button class="menu-trigger" @onclick='() => ToggleMenu("groups")' aria-expanded="@(_openMenu == "groups")">Groups</button>
                @if (_openMenu == "groups")
                {
                <div class="menu-popup" role="menu" @onclick:stopPropagation>
                    <button role="menuitem" @onclick="() => Split(SplitDirection.Left)">Split left</button>
                    <button role="menuitem" @onclick="() => Split(SplitDirection.Right)">Split right <kbd>Ctrl+\</kbd></button>
                    <button role="menuitem" @onclick="() => Split(SplitDirection.Up)">Split up</button>
                    <button role="menuitem" @onclick="() => Split(SplitDirection.Down)">Split down</button>
                    <button role="menuitem" @onclick="Equalize" disabled="@(_workspace.Layout.Groups.Count < 2)">Distribute evenly</button>
                    <button role="menuitem" @onclick="() => TransferToNextAsync(false)" disabled="@(ActiveTab is null)">Move view to next group</button>
                    <button role="menuitem" @onclick="() => TransferToNextAsync(true)" disabled="@(ActiveTab is null)">Copy view to next group</button>
                    <button role="menuitem" @onclick="FocusNext" disabled="@(_workspace.Layout.Groups.Count < 2)">Focus next group</button>
                    <button role="menuitem" @onclick='() => FocusDirectionAsync("left")' disabled="@(_workspace.Layout.Groups.Count < 2)">Focus left</button>
                    <button role="menuitem" @onclick='() => FocusDirectionAsync("right")' disabled="@(_workspace.Layout.Groups.Count < 2)">Focus right</button>
                    <button role="menuitem" @onclick='() => FocusDirectionAsync("up")' disabled="@(_workspace.Layout.Groups.Count < 2)">Focus up</button>
                    <button role="menuitem" @onclick='() => FocusDirectionAsync("down")' disabled="@(_workspace.Layout.Groups.Count < 2)">Focus down</button>
                </div>
                }
            </div>
        </nav>
    </header>
    @if (_showFind)
    {
        <div class="findbar">
            <input aria-label="Find" @bind="_query" @bind:event="oninput" />
            <input aria-label="Replace" @bind="_replacement" />
            <span>@_document.Find(_query).Count matches</span>
            <button @onclick="ReplaceAll">Replace all</button>
            <button @onclick="ToggleFind" aria-label="Close find">×</button>
        </div>
    }
    @if (_externalChange)
    {
        <div class="conflict" role="alert">
            <span>@(_document.IsDeletedOnDisk ? "The file was deleted outside NovaSharp." : "The file changed outside NovaSharp.")</span>
            <button @onclick="ReloadAsync">Reload disk version</button>
            <button @onclick="KeepBuffer">Keep editor version</button>
        </div>
    }
    <div class="workbench-body">
        <div class="editor-area">
            <EditorGroupLayoutView @key="_workspace.Layout.Root.Id" Node="_workspace.Layout.Root" Workspace="_workspace" WordWrap="_wordWrap"
                                   ExternalDragActive="_explorerFileDrag is not null"
                                   ActiveChanged="ActiveChangedAsync" ContentEdited="ContentEditedAsync"
                                   CloseRequested="CloseRequestedAsync" />
        </div>
        <WorkspaceExplorer @ref="_explorer" Document="_document" ProjectSystem="_projectSystem" FileOpened="OpenWorkspaceFileAsync"
                           FilePreviewed="PreviewWorkspaceFileAsync" OpenChanged="ExplorerOpenChanged" />
        <nav class="activity-bar" aria-label="Tool windows">
            <button class="@(_explorerOpen ? "active" : null)" @onclick="ToggleExplorerAsync" aria-label="Explorer"
                    title="Explorer" aria-pressed="@_explorerOpen">
                <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M3 5.5h6l2 2h10v11H3z" /></svg>
            </button>
        </nav>
    </div>
    <footer class="statusbar">
        <span class="status-message">@Status</span>
        @if (ActiveContexts.Count > 1)
        {
            <select aria-label="Active project context" value="@ActiveContextId" @onchange="SelectContext">
                @foreach (var context in ActiveContexts) { <option value="@context.Id.Id">@context.Name</option> }
            </select>
        }
        <span class="pointer-status" aria-live="polite">LMB: @(_leftMouseDown ? "Down" : "Up")</span>
    </footer>
</main>

@code {
    private readonly EditorGroupWorkspace _workspace = new();
    private readonly RoslynProjectSystem _projectSystem = new();
    private readonly HashSet<EditorDocumentState> _projectDocuments = [];
    private readonly EditorDocumentState _emptyDocument = new();
    private EditorLayoutPersistence _persistence = null!;
    private WorkspaceExplorer? _explorer;
    private ElementReference _workbench;
    private DotNetObjectReference<WorkbenchPanel>? _self;
    private string? _status;
    private string? _explorerFileDrag;
    private string _query = "", _replacement = "";
    private string? _openMenu;
    private bool _showFind, _wordWrap, _externalChange, _leftMouseDown, _explorerOpen = true;
    private DocumentTab? ActiveTab => _workspace.FocusedGroup.ActiveTab;
    private EditorDocumentState _document => ActiveTab?.Document ?? _emptyDocument;
    private string Status => _status ?? _workspace.LastError ?? (_document.IsReadOnly ? "Read-only" : _document.FilePath ?? "Ready");
    private IReadOnlyList<(Microsoft.CodeAnalysis.ProjectId Id, string Name)> ActiveContexts =>
        _document.FilePath is { } path ? _projectSystem.GetContexts(path) : [];
    private string? ActiveContextId => _document.FilePath is { } path
        ? _projectSystem.GetActiveDocument(path)?.Project.Id.Id.ToString() : null;

    protected override async Task OnInitializedAsync()
    {
        _wordWrap = Program.Configuration.Current.WordWrap;
        _persistence = new(Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData),
            "NovaSharp", "workbench-session.json"));
        _workspace.Changed += WorkspaceChanged;
        _projectSystem.Changed += ProjectSystemChanged;
        Program.ConfirmWorkbenchClose = ConfirmClose;
        if (Program.Phase5Workspace is not null)
        {
            var path = Directory.EnumerateFiles(Program.Phase5Workspace, "*.cs").First();
            var tab = await _workspace.OpenAsync(path);
            var source = _workspace.FocusedGroup;
            var target = _workspace.Split(source.Id, SplitDirection.Right)!;
            await _workspace.CopyAsync(tab!, target.Id);
            _workspace.Focus(source.Id);
        }
        else if (Program.Phase4Workspace is not null)
            foreach (var path in Directory.EnumerateFiles(Program.Phase4Workspace, "*.cs").Order()) await _workspace.OpenAsync(path);
        else if (Program.SmokeFile is not null) await OpenTabAsync(Program.SmokeFile);
        else await _workspace.RestoreAsync(await _persistence.LoadAsync());
        if (Program.Phase6Solution is not null) await _projectSystem.OpenAsync(Program.Phase6Solution);
        TrackActiveDocument();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _self = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("novaSharp.initEditorDragCleanup", _workbench, _self);
        await JS.InvokeVoidAsync("novaSharp.initLeftMouseStatus", _workbench, _self);
        await JS.InvokeVoidAsync("novaSharp.initPointerTabDrag", _workbench, _self);
        await JS.InvokeVoidAsync("novaSharp.initExplorerFileDrag", _workbench, _self);
        if (Program.Phase4Workspace is not null || Program.Phase5Workspace is not null)
            await JS.InvokeVoidAsync("novaSharp.startSmokePolling", _self,
                Program.Phase4Workspace is not null, Program.Phase5Workspace is not null);
        if (Program.Phase6Solution is not null)
            await JS.InvokeVoidAsync("novaSharp.runPhase6Smoke", _self);
    }

    private async Task OpenFileAsync()
    {
        _openMenu = null;
        var files = await Program.App.MainWindow.ShowOpenFileDialogAsync(title: "Open C# file", multiSelect: true,
            filterPatterns: [new FileFilter("C# source", "*.cs")]);
        UntrackActiveDocument();
        foreach (var path in files ?? []) await _workspace.OpenAsync(path);
        TrackActiveDocument();
        await SaveLayoutAsync();
    }
    private async Task OpenSolutionAsync()
    {
        _openMenu = null;
        var files = await Program.App.MainWindow.ShowOpenFileDialogAsync(title: "Open solution or project", multiSelect: false,
            filterPatterns: [new FileFilter("Solution", "*.sln"), new FileFilter("XML solution", "*.slnx"),
                new FileFilter("C# project", "*.csproj")]);
        if (files is not [var path]) return;
        await _projectSystem.OpenAsync(path);
        _status = _projectSystem.State.Progress;
    }
    private Task OpenWorkspaceFileAsync(string path) => OpenTabAsync(path);
    private Task PreviewWorkspaceFileAsync(string path) => OpenTabAsync(path, true);
    private async Task OpenTabAsync(string path, bool preview = false)
    {
        UntrackActiveDocument();
        var tab = await _workspace.OpenAsync(path, preview);
        if (tab is null) _status = _workspace.LastError;
        else _status = null;
        TrackActiveDocument();
        await SaveLayoutAsync();
    }

    private async Task CloseRequestedAsync(EditorGroupLayoutView.CloseViewRequest request)
    {
        var tabs = request.Tabs.Where(tab => _workspace.Layout.Groups.Any(group => group.Tabs.Contains(tab))).ToArray();
        var targets = tabs.ToHashSet();
        var allTabs = _workspace.Layout.Groups.SelectMany(group => group.Tabs).ToArray();
        var dirty = tabs.Where(tab => tab.Document.IsDirty
            && allTabs.Where(candidate => ReferenceEquals(candidate.Document, tab.Document)).All(targets.Contains))
            .DistinctBy(tab => tab.Document).ToArray();
        var discard = false;
        if (dirty.Length > 0)
        {
            var names = string.Join(Environment.NewLine, dirty.Select(tab => $"• {tab.Document.DisplayName}"));
            var result = await Program.App.MainWindow.ShowMessageDialogAsync("Unsaved changes",
                $"Save these files before closing?{Environment.NewLine}{Environment.NewLine}{names}", DialogButtons.YesNoCancel, DialogIcon.Warning);
            if (result is not (DialogResult.Yes or DialogResult.No)) return;
            if (result == DialogResult.Yes)
                foreach (var tab in dirty) try { await tab.Document.SaveAsync(); } catch (Exception ex) { _status = ex.Message; return; }
            discard = true;
        }
        UntrackActiveDocument();
        foreach (var tab in tabs)
            if (_workspace.Layout.Groups.SelectMany(group => group.Tabs).Contains(tab))
                _workspace.Close(_workspace.GroupContaining(tab).Id, tab, discard);
        TrackActiveDocument();
        await SaveLayoutAsync();
    }

    private async Task ActiveChangedAsync() { TrackActiveDocument(); await SaveLayoutAsync(); }
    private async Task ContentEditedAsync() { _status = null; StateHasChanged(); await SaveLayoutAsync(); }
    private void Split(SplitDirection direction) { _openMenu = null; _status = null; _workspace.Split(_workspace.Layout.FocusedGroupId, direction); }
    private void Equalize() { _openMenu = null; _workspace.Equalize(); _ = SaveLayoutAsync(); }
    private async Task TransferToNextAsync(bool copy)
    {
        _openMenu = null;
        if (ActiveTab is not { } tab) return;
        var groups = _workspace.Layout.Groups;
        var source = _workspace.FocusedGroup;
        var index = Array.IndexOf(groups.ToArray(), source);
        var target = groups.Count == 1 ? _workspace.Split(source.Id, SplitDirection.Right)! : groups[(index + 1) % groups.Count];
        if (copy) await _workspace.CopyAsync(tab, target.Id); else _workspace.Move(tab, source.Id, target.Id);
        await ActiveChangedAsync();
    }
    private void FocusNext()
    {
        _openMenu = null;
        var groups = _workspace.Layout.Groups;
        var index = Array.IndexOf(groups.ToArray(), _workspace.FocusedGroup);
        _workspace.Focus(groups[(index + 1) % groups.Count].Id);
        TrackActiveDocument();
    }
    private async Task FocusDirectionAsync(string direction)
    {
        _openMenu = null;
        await JS.InvokeVoidAsync("novaSharp.focusEditorGroup", _workbench, _self, direction);
    }
    private async Task SaveAsync() { _openMenu = null; try { await _document.SaveAsync(); _status = "Saved"; } catch (Exception ex) { _status = ex.Message; } }
    private async Task SaveAsAsync()
    {
        _openMenu = null;
        var path = await Program.App.MainWindow.ShowSaveFileDialogAsync("Save C# file", _document.FilePath ?? "Untitled.cs", [new FileFilter("C# source", "*.cs")]);
        if (!string.IsNullOrWhiteSpace(path)) try { await _document.SaveAsync(path); _status = "Saved"; } catch (Exception ex) { _status = ex.Message; }
    }
    private void Undo() { _openMenu = null; _document.Undo(); StateHasChanged(); }
    private void Redo() { _openMenu = null; _document.Redo(); StateHasChanged(); }
    private void ReplaceAll() { _document.ReplaceAll(_query, _replacement); StateHasChanged(); }
    private void ToggleFind() { _openMenu = null; _showFind = !_showFind; }
    private void ToggleMenu(string menu) => _openMenu = _openMenu == menu ? null : menu;
    private void CloseMenu() => _openMenu = null;
    private async Task ToggleWrapAsync() { _openMenu = null; _wordWrap = !_wordWrap; await Program.Configuration.SaveUserAsync(Program.Configuration.Current with { WordWrap = _wordWrap }); }
    private async Task ReloadAsync() { await _document.ReloadAsync(); _externalChange = false; StateHasChanged(); }
    private void KeepBuffer() { _document.KeepBuffer(); _externalChange = false; }
    private Task ToggleExplorerAsync() => _explorer?.ToggleCollapsedAsync() ?? Task.CompletedTask;
    private void ExplorerOpenChanged(bool open) => _explorerOpen = open;
    private Task SaveLayoutAsync() => _persistence.SaveAsync(_workspace.CaptureState());
    private void WorkspaceChanged() => _ = InvokeAsync(StateHasChanged);
    private void OnExternalChange() => _ = InvokeAsync(() => { _externalChange = true; StateHasChanged(); });
    private void UntrackActiveDocument() => _document.ExternalChangeDetected -= OnExternalChange;
    private void TrackActiveDocument()
    {
        _document.ExternalChangeDetected -= OnExternalChange;
        _document.ExternalChangeDetected += OnExternalChange;
        Program.ActiveDocument = _document;
        SyncProjectDocuments();
    }

    private void SyncProjectDocuments()
    {
        var current = _workspace.Layout.Groups.SelectMany(group => group.Tabs).Select(tab => tab.Document).ToHashSet();
        foreach (var document in _projectDocuments.Except(current).ToArray())
        {
            _projectSystem.Untrack(document);
            _projectDocuments.Remove(document);
        }
        foreach (var document in current)
            if (_projectDocuments.Add(document)) _projectSystem.Track(document);
    }

    private void SelectContext(ChangeEventArgs args)
    {
        if (_document.FilePath is not { } path || !Guid.TryParse(args.Value?.ToString(), out var id)) return;
        var context = ActiveContexts.FirstOrDefault(item => item.Id.Id == id);
        if (context.Id is not null) _projectSystem.SelectContext(path, context.Id);
    }

    private void ProjectSystemChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task HandleKeyAsync(KeyboardEventArgs args)
    {
        if (!(args.CtrlKey || args.MetaKey)) return;
        switch (args.Key.ToLowerInvariant())
        {
            case "o": await OpenFileAsync(); break;
            case "s" when args.ShiftKey: await SaveAsAsync(); break;
            case "s": await SaveAsync(); break;
            case "f": _showFind = true; break;
            case "z" when args.ShiftKey: Redo(); break;
            case "z": Undo(); break;
            case "y": Redo(); break;
            case "\\": Split(SplitDirection.Right); break;
            case "arrowleft" when args.AltKey && args.ShiftKey: Split(SplitDirection.Left); break;
            case "arrowright" when args.AltKey && args.ShiftKey: Split(SplitDirection.Right); break;
            case "arrowup" when args.AltKey && args.ShiftKey: Split(SplitDirection.Up); break;
            case "arrowdown" when args.AltKey && args.ShiftKey: Split(SplitDirection.Down); break;
            case "arrowleft" when args.AltKey: await FocusDirectionAsync("left"); break;
            case "arrowright" when args.AltKey: await FocusDirectionAsync("right"); break;
            case "arrowup" when args.AltKey: await FocusDirectionAsync("up"); break;
            case "arrowdown" when args.AltKey: await FocusDirectionAsync("down"); break;
            case "=" when args.ShiftKey: Equalize(); break;
            case "]" when args.AltKey: await TransferToNextAsync(args.ShiftKey); break;
            case "`": FocusNext(); break;
        }
    }

    [JSInvokable]
    public Task CompletePhase4SmokeAsync(Phase4SmokeResult result) => Program.CompletePhase4SmokeAsync(result);

    [JSInvokable]
    public Task CompletePhase5SmokeAsync(Phase5SmokeResult result) => Program.CompletePhase5SmokeAsync(result);

    [JSInvokable]
    public Task CompletePhase6SmokeAsync(bool solutionTreePresent, int projectNodes, bool projectFileEditable,
        bool contextMenuPresent, string? error = null) =>
        Program.CompletePhase6SmokeAsync(new(solutionTreePresent, projectNodes,
            !_projectSystem.State.IsLoading && _projectSystem.State.Root is not null,
            _projectSystem.CurrentSolution?.Projects.SelectMany(project => project.Documents).Any() == true,
            _projectSystem.HasLinkedDocuments,
            _projectSystem.Contexts.Any(context => context.TargetFramework is not null && context.Configuration is not null),
            projectFileEditable, contextMenuPresent, error));

    [JSInvokable]
    public void CancelEditorDrag() => _workspace.CancelDrag();

    [JSInvokable]
    public void BeginPointerTabDrag(string id)
    {
        if (Guid.TryParse(id, out var tabId) && _workspace.Layout.Groups
            .SelectMany(group => group.Tabs).FirstOrDefault(tab => tab.Id == tabId) is { } tab)
            _workspace.BeginDrag(tab);
    }

    [JSInvokable]
    public void BeginExplorerFileDrag(string path)
    {
        _explorerFileDrag = path;
        StateHasChanged();
    }

    [JSInvokable]
    public void CancelExplorerFileDrag()
    {
        _explorerFileDrag = null;
        StateHasChanged();
    }

    [JSInvokable]
    public async Task DropExplorerFile(string groupId, string? direction)
    {
        var path = _explorerFileDrag;
        _explorerFileDrag = null;
        if (path is null || !Guid.TryParse(groupId, out var targetId)) { StateHasChanged(); return; }
        if (Enum.TryParse<SplitDirection>(direction, true, out var split))
            targetId = _workspace.Split(targetId, split)?.Id ?? targetId;
        await _workspace.OpenAsync(path, groupId: targetId);
        await ActiveChangedAsync();
    }

    [JSInvokable]
    public async Task DropPointerTab(string groupId, int? index, string? direction, bool copy)
    {
        if (!Guid.TryParse(groupId, out var targetId)) { _workspace.CancelDrag(); return; }
        var split = Enum.TryParse<SplitDirection>(direction, true, out var parsed) ? parsed : (SplitDirection?)null;
        await _workspace.DropAsync(targetId, index, split, copy);
        await ActiveChangedAsync();
    }

    [JSInvokable]
    public void LeftMouseChanged(bool down)
    {
        if (_leftMouseDown == down) return;
        _leftMouseDown = down;
        StateHasChanged();
    }

    [JSInvokable]
    public async Task FocusEditorGroup(string id)
    {
        if (Guid.TryParse(id, out var groupId) && _workspace.Focus(groupId))
        {
            TrackActiveDocument();
            await SaveLayoutAsync();
        }
    }

    public void Dispose()
    {
        _ = SaveLayoutAsync();
        _workspace.Changed -= WorkspaceChanged;
        _projectSystem.Changed -= ProjectSystemChanged;
        UntrackActiveDocument();
        _workspace.Dispose();
        _emptyDocument.Dispose();
        _self?.Dispose();
        _projectSystem.DisposeAsync().AsTask().GetAwaiter().GetResult();
        if (Program.ConfirmWorkbenchClose == ConfirmClose) Program.ConfirmWorkbenchClose = null;
    }

    private bool ConfirmClose()
    {
        var dirty = _workspace.Layout.Groups.SelectMany(group => group.Tabs).Where(tab => tab.Document.IsDirty)
            .DistinctBy(tab => tab.Document).ToArray();
        if (dirty.Length == 0) return true;
        var names = string.Join(Environment.NewLine, dirty.Select(tab => $"• {tab.Document.DisplayName}"));
        var result = Program.App.MainWindow.ShowMessageDialogAsync("Unsaved changes",
            $"Save these files before closing?{Environment.NewLine}{Environment.NewLine}{names}",
            DialogButtons.YesNoCancel, DialogIcon.Warning).GetAwaiter().GetResult();
        if (result == DialogResult.No) return true;
        if (result != DialogResult.Yes) return false;
        try { foreach (var tab in dirty) tab.Document.SaveAsync().GetAwaiter().GetResult(); return true; }
        catch { return false; }
    }
}
