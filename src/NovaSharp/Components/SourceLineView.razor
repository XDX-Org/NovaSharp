<div class="source-line" @key="Line.Number"><span class="line-number">@Line.Number</span><code>@foreach (var guide in Line.BraceGuides ?? [])
    {
        <span class="brace-guide brace-guide-@guide.Part.ToString().ToLowerInvariant()" style="@GuideStyle(guide)"></span>
    }@RenderLine()</code></div>

@code {
    [Parameter, EditorRequired] public EditorLine Line { get; set; }
    [Parameter] public IReadOnlyList<LanguageDiagnostic> Diagnostics { get; set; } = [];
    private RenderFragment RenderLine() => builder =>
    {
        var position = 0;
        var sequence = 0;
        var boundaries = Line.Spans.SelectMany(span => new[] { span.Start, span.Start + span.Length })
            .Concat(Diagnostics.SelectMany(item => new[] { LocalStart(item), LocalEnd(item) }))
            .Append(0).Append(Line.Text.Length).Where(value => value >= 0 && value <= Line.Text.Length)
            .Distinct().Order().ToArray();
        foreach (var end in boundaries.Skip(1))
        {
            if (end <= position) continue;
            var token = Line.Spans.FirstOrDefault(span => span.Start <= position && span.Start + span.Length >= end);
            var diagnostic = Diagnostics.FirstOrDefault(item => LocalStart(item) < end && LocalEnd(item) > position);
            if (token.Length == 0 && diagnostic is null) { builder.AddContent(sequence++, Line.Text[position..end]); position = end; continue; }
            builder.OpenElement(sequence++, "span");
            var classes = token.Length > 0 ? $"token-{token.Kind.ToString().ToLowerInvariant()}" : "";
            if (diagnostic is not null) classes += $" diagnostic diagnostic-{diagnostic.Severity.ToString().ToLowerInvariant()}";
            builder.AddAttribute(sequence++, "class", classes);
            if (diagnostic is not null) builder.AddAttribute(sequence++, "title", $"{diagnostic.Id}: {diagnostic.Message}");
            builder.AddContent(sequence++, Line.Text[position..end]);
            builder.CloseElement();
            position = end;
        }
        if (position < Line.Text.Length) builder.AddContent(sequence, Line.Text[position..]);
        if (Line.Text.Length == 0) builder.AddContent(sequence, " ");
    };
    private int LocalStart(LanguageDiagnostic item) => item.StartLine == Line.Number - 1 ? item.StartColumn : 0;
    private int LocalEnd(LanguageDiagnostic item) => (item.EndLine < 0 ? item.StartLine : item.EndLine) == Line.Number - 1
        ? (item.EndColumn < 0 ? item.StartColumn + item.Range.Length : item.EndColumn) : Line.Text.Length;
    private static string GuideStyle(BraceGuide guide) =>
        $"left:calc(12px + {(guide.Column + .5).ToString(System.Globalization.CultureInfo.InvariantCulture)}ch)";
}
