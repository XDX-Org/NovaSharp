@using System.Text
@using PhotinoEx.Core.Models
@implements IDisposable
@inject IJSRuntime JS

@if (Open)
{
    <section class="terminal-panel bottom-panel" aria-label="Integrated terminal">
        <div class="bottom-panel-resizer" role="separator" aria-orientation="horizontal" tabindex="0"></div>
        <header>
            <div class="terminal-tabs" role="tablist" aria-label="Terminal sessions">
                @foreach (var session in Service.Sessions)
                {
                    <div role="tab" aria-selected="@(session == Service.ActiveSession)" tabindex="@(session == Service.ActiveSession ? 0 : -1)"
                         class="terminal-tab @(session == Service.ActiveSession ? "active" : null)"
                         title="@session.WorkingDirectory" @onclick="() => Service.Activate(session.Id)"
                         @onmousedown="args => MiddleCloseAsync(args, session)">
                        <span class="tab-label">@session.Name</span>
                        <button class="tab-close" aria-label="Close @session.Name" title="Close terminal"
                                @onclick="() => CloseSessionAsync(session)" @onclick:stopPropagation>×</button>
                    </div>
                }
            </div>
            <select aria-label="Terminal profile" @bind="_profileId">
                @foreach (var profile in Service.Profiles) { <option value="@profile.Id">@profile.Name</option> }
            </select>
            <button title="New terminal" aria-label="New terminal" @onclick="CreateAsync">＋</button>
            <button title="Rename terminal" aria-label="Rename terminal" disabled="@(Service.ActiveSession is null)" @onclick="RenameAsync">Rename</button>
            <button title="Restart terminal" aria-label="Restart terminal" disabled="@(Service.ActiveSession is null)" @onclick="RestartAsync">↻</button>
        </header>
        @if (Service.ActiveSession is { } active)
        {
            <div @key="active.Id" @ref="_host" class="terminal-host" role="application"
                 aria-label="Terminal @active.Name, @active.State" data-terminal-id="@active.Id">
                <Xterm @ref="_xterm" Id="@XtermId(active)" Options="_options" Class="terminal-xterm" OnFirstRender="XtermReadyAsync"
                       OnData="SendTerminalInput" OnBinary="SendTerminalBinary" OnResize="XtermResized" />
            </div>
            <footer>
                <span>@active.State@if (active.ExitCode is { } exitCode) { <text> (exit @exitCode)</text> }</span>
                <span>@active.WorkingDirectory</span>
            </footer>
        }
        else
        {
            <div class="terminal-empty" role="status">Starting terminal…</div>
        }
    </section>
}

@code {
    [Parameter, EditorRequired] public TerminalService Service { get; set; } = null!;
    [Parameter] public bool Open { get; set; }
    [Parameter] public string? WorkingDirectory { get; set; }
    [Parameter] public EventCallback<TerminalSession> ConfirmClose { get; set; }
    private ElementReference _host;
    private Xterm? _xterm;
    private DotNetObjectReference<TerminalPanel>? _self;
    private readonly SemaphoreSlim _renderGate = new(1, 1);
    private readonly object _inputGate = new();
    private readonly object _outputGate = new();
    private readonly TerminalOptions _options = new()
    {
        CursorBlink = true, CursorStyle = CursorStyle.Block, FontSize = 14,
        FontFamily = "JetBrains Mono, Cascadia Code, ui-monospace, monospace",
        Scrollback = 5_000, ScreenReaderMode = true,
        Theme = new() { Background = "#121419", Foreground = "#d8dee9", Cursor = "#eceff4", SelectionBackground = "#4b6eaf88" }
    };
    private Task _inputQueue = Task.CompletedTask;
    private Task _outputQueue = Task.CompletedTask;
    private string? _profileId;
    private Guid? _initializedSession;
    private Guid? _renderedSession;
    private long _lastWrittenSequence;
    private bool _creating;

    protected override void OnInitialized()
    {
        _profileId = Service.Profiles.FirstOrDefault()?.Id;
        Service.Changed += ServiceChanged;
        Service.OutputReceived += OutputReceived;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!Open) { _initializedSession = null; return; }
        if (Service.Sessions.Count == 0)
        {
            if (_creating) return;
            _creating = true;
            try { await CreateAsync(); }
            finally { _creating = false; }
            return;
        }
        if (Service.ActiveSession is not { } session || _initializedSession == session.Id) return;
        _initializedSession = session.Id;
    }

    private async Task CreateAsync() { await Service.CreateAsync(_profileId, WorkingDirectory); }
    private async Task RestartAsync() { if (Service.ActiveSession is { } session) await Service.RestartAsync(session.Id); }
    private async Task RenameAsync()
    {
        if (Service.ActiveSession is not { } session) return;
        var name = await JS.InvokeAsync<string?>("prompt", "Terminal name", session.Name);
        if (name is not null) Service.Rename(session.Id, name);
    }
    private Task MiddleCloseAsync(MouseEventArgs args, TerminalSession session) =>
        args.Button == 1 ? CloseSessionAsync(session) : Task.CompletedTask;
    private async Task CloseSessionAsync(TerminalSession session)
    {
        if (session.State == TerminalSessionState.Running) await ConfirmClose.InvokeAsync(session);
        else await Service.CloseAsync(session.Id, force: true);
    }

    private void ServiceChanged() => _ = InvokeAsync(() => { StateHasChanged(); });

    private async Task XtermReadyAsync()
    {
        if (_xterm is null || Service.ActiveSession is not { } session) return;
        _self ??= DotNetObjectReference.Create(this);
        await _renderGate.WaitAsync();
        try
        {
            _renderedSession = session.Id; _lastWrittenSequence = 0;
            foreach (var chunk in session.Transcript.Chunks) await WriteChunkAsync(session, chunk);
        }
        finally { _renderGate.Release(); }
        await JS.InvokeVoidAsync("novaSharp.initTerminal", _host, _self, XtermId(session));
        await _xterm.Focus();
    }

    private async Task SendTerminalInput(string value)
    {
        if ((value.Contains('\n') || (value.Contains('\r') && value != "\r") || value.Length > 1_000)
            && Service.ActiveSession is { } session)
        {
            var result = await Program.App.MainWindow.ShowMessageDialogAsync("Paste into terminal",
                $"Paste {value.Length} characters into {session.Name}?", DialogButtons.YesNo, DialogIcon.Warning);
            if (result != DialogResult.Yes) return;
        }
        await QueueInput(Encoding.UTF8.GetBytes(value));
    }
    private Task SendTerminalBinary(string value) => QueueInput(value.Select(character => (byte)character).ToArray());
    private Task QueueInput(byte[] value)
    {
        lock (_inputGate)
            return _inputQueue = _inputQueue.ContinueWith(_ => Service.ActiveSession?.SendAsync(value) ?? Task.CompletedTask,
                CancellationToken.None, TaskContinuationOptions.ExecuteSynchronously, TaskScheduler.Default).Unwrap();
    }
    private void XtermResized(ResizeEventArgs args) => Service.ActiveSession?.Resize(args.Columns, args.Rows);
    private void OutputReceived(TerminalSession session, TerminalOutputChunk chunk)
    {
        lock (_outputGate)
            _outputQueue = _outputQueue.ContinueWith(async _ =>
            {
                try { await InvokeAsync(() => WriteChunkSerializedAsync(session, chunk)); }
                catch (Exception exception) when (exception is InvalidOperationException or JSDisconnectedException) { }
            }, CancellationToken.None, TaskContinuationOptions.ExecuteSynchronously, TaskScheduler.Default).Unwrap();
    }
    private async Task WriteChunkSerializedAsync(TerminalSession session, TerminalOutputChunk chunk)
    {
        await _renderGate.WaitAsync();
        try { await WriteChunkAsync(session, chunk); }
        finally { _renderGate.Release(); }
    }
    private async Task WriteChunkAsync(TerminalSession session, TerminalOutputChunk chunk)
    {
        if (!Open || _xterm is null || _renderedSession != session.Id || chunk.Sequence <= _lastWrittenSequence) return;
        await _xterm.Write(chunk.Data); _lastWrittenSequence = chunk.Sequence;
    }
    private static string XtermId(TerminalSession session) => $"terminal-{session.Id:N}";

    [JSInvokable]
    public async Task ResizeTerminal(int columns, int rows)
    {
        if (_xterm is not null) await _xterm.Resize(columns, rows);
        Service.ActiveSession?.Resize(columns, rows);
    }

    public void Dispose()
    {
        Service.Changed -= ServiceChanged;
        Service.OutputReceived -= OutputReceived;
        _self?.Dispose();
        _renderGate.Dispose();
    }
}
