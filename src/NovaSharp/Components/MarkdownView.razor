@{ var blocks = Blocks(Content).ToArray(); }
@for (var index = 0; index < blocks.Length; index++)
{
    var block = blocks[index];
    @if (block.Kind == "code")
    {
        <pre><code class="@(block.Language is null ? null : $"language-{block.Language}")">@block.Text</code></pre>
    }
    else if (block.Kind == "heading")
    {
        <div class="markdown-heading">@block.Text</div>
    }
    else if (block.Kind == "list")
    {
        <ul class="markdown-list">
            @while (index < blocks.Length && blocks[index].Kind == "list")
            {
                block = blocks[index];
                <li style="margin-left:@(block.Indent * 12)px">@block.Text</li>
                index++;
            }
        </ul>
        index--;
    }
    else
    {
        <div class="markdown-paragraph">@block.Text</div>
    }
}

@code {
    [Parameter] public string Content { get; set; } = string.Empty;

    private static IEnumerable<(string Kind, string? Language, string Text, int Indent)> Blocks(string markdown)
    {
        for (var count = 0; count < 2; count++) markdown = System.Net.WebUtility.HtmlDecode(markdown);
        markdown = System.Text.RegularExpressions.Regex.Replace(markdown, @"\\([^\p{L}\p{N}\s])", "$1");
        var lines = markdown.Replace("\r\n", "\n", StringComparison.Ordinal).Split('\n');
        for (var index = 0; index < lines.Length;)
        {
            if (!lines[index].TrimStart().StartsWith("```", StringComparison.Ordinal))
            {
                var line = lines[index++];
                if (string.IsNullOrWhiteSpace(line)) continue;
                var trimmed = line.Trim();
                var indent = Math.Max(0, line.Length - line.TrimStart().Length) / 2;
                if (trimmed.Length > 0 && trimmed[0] is '-' or '*' or '+' or '○' or '◦')
                {
                    var item = trimmed[1..].TrimStart();
                    if (item.Length > 0) yield return ("list", null, item, indent);
                }
                else if (trimmed.EndsWith(':') && !trimmed.Contains(' '))
                    yield return ("heading", null, trimmed[..^1], 0);
                else yield return ("paragraph", null, trimmed, 0);
                continue;
            }
            var fence = lines[index++].TrimStart();
            var language = fence[3..].Trim() is { Length: > 0 } value ? value : null;
            var code = new List<string>();
            while (index < lines.Length && !lines[index].TrimStart().StartsWith("```", StringComparison.Ordinal))
                code.Add(lines[index++]);
            if (index < lines.Length) index++;
            var codeText = string.Join('\n', code).TrimEnd();
            if (string.IsNullOrWhiteSpace(codeText)) continue;
            var trimmedCode = codeText.Trim();
            if (!trimmedCode.Contains('\n') && trimmedCode[0] is '-' or '*' or '+' or '○' or '◦')
            {
                var item = trimmedCode[1..].TrimStart();
                if (item.Length > 0) yield return ("list", null, item, 0);
            }
            else yield return ("code", language, codeText, 0);
        }
    }
}
