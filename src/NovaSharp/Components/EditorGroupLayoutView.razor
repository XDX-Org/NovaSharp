@using Microsoft.AspNetCore.Components.Web

@if (Node is EditorSplit split)
{
    <div class="editor-split @OrientationClass(split)" style="@SplitStyle(split)"
         data-ratio="@split.Ratio.ToString(System.Globalization.CultureInfo.InvariantCulture)">
        <EditorGroupLayoutView @key="split.First.Id" Node="split.First" Workspace="Workspace" WordWrap="WordWrap"
                               ExternalDragActive="ExternalDragActive"
                               ActiveChanged="ActiveChanged" ContentEdited="ContentEdited" CloseRequested="CloseRequested" />
        <EditorSplitter @key="split.Id" Split="split" Workspace="Workspace" Resized="ActiveChanged" />
        <EditorGroupLayoutView @key="split.Second.Id" Node="split.Second" Workspace="Workspace" WordWrap="WordWrap"
                               ExternalDragActive="ExternalDragActive"
                               ActiveChanged="ActiveChanged" ContentEdited="ContentEdited" CloseRequested="CloseRequested" />
    </div>
}
else if (Node is EditorGroup group)
{
    <section class="editor-group @(Workspace.Layout.FocusedGroupId == group.Id ? "focused" : null)"
             aria-label="Editor group" data-group-id="@group.Id" data-focus-rank="@Workspace.Layout.FocusRank(group.Id)"
             @onclick="() => Focus(group)">
        <div class="group-actions">
            @if (group.Tabs.Count == 0 && Workspace.Layout.Groups.Count > 1)
            {
                <button aria-label="Close editor group" title="Close editor group" @onclick="() => CloseGroup(group)" @onclick:stopPropagation>×</button>
            }
        </div>
        @if (group.Tabs.Count > 0)
        {
            <div class="document-tabs" role="tablist" aria-label="Open editors">
                @for (var index = 0; index < group.Tabs.Count; index++)
                {
                    var tab = group.Tabs[index];
                    var insertionIndex = index;
                    <div class="document-tab @(ReferenceEquals(tab, group.ActiveTab) ? "active" : null) @(tab.IsPreview ? "preview" : null)"
                         role="tab" aria-selected="@ReferenceEquals(tab, group.ActiveTab)" tabindex="@(ReferenceEquals(tab, group.ActiveTab) ? 0 : -1)"
                         aria-label="@AccessibleLabel(tab)" title="@tab.Document.FilePath"
                         data-tab-id="@tab.Id" data-tab-index="@index"
                         @onclick="() => Activate(group, tab)" @ondblclick="() => Pin(tab)"
                         @onmousedown="args => MiddleClose(args, tab)"
                         @oncontextmenu="args => ShowContextMenu(args, group, tab)"
                         @oncontextmenu:preventDefault>
                        <span class="tab-label">@DisplayName(group, tab)</span>
                        @if (tab.Document.IsDirty) { <span class="tab-dirty" aria-label="Unsaved changes">●</span> }
                        <button class="tab-close" aria-label="Close @DisplayName(group, tab)"
                                @onclick="() => RequestClose(group, tab)" @onclick:stopPropagation>×</button>
                    </div>
                }
            </div>
        }
        @if (_contextTab is not null && _contextGroup is not null)
        {
            <div class="context-menu-dismiss" @onclick="HideContextMenu"></div>
            <div class="explorer-context-menu tab-context-menu" role="menu" style="left:@(_contextX)px;top:@(_contextY)px" @onclick:stopPropagation>
                <button role="menuitem" @onclick="() => SplitContext(SplitDirection.Left)">Split left</button>
                <button role="menuitem" @onclick="() => SplitContext(SplitDirection.Right)">Split right</button>
                <button role="menuitem" @onclick="() => SplitContext(SplitDirection.Up)">Split up</button>
                <button role="menuitem" @onclick="() => SplitContext(SplitDirection.Down)">Split down</button>
                <hr />
                <button role="menuitem" @onclick="() => RequestClose([_contextTab])">Close</button>
                <button role="menuitem" @onclick="() => RequestClose(_contextGroup.Tabs.Where(tab => !ReferenceEquals(tab, _contextTab)).ToArray())">Close others</button>
                <button role="menuitem" @onclick="() => RequestClose(_contextGroup.Tabs.Skip(_contextGroup.IndexOf(_contextTab) + 1).ToArray())">Close to the right</button>
                <button role="menuitem" @onclick="() => RequestClose(Workspace.Layout.Groups.SelectMany(group => group.Tabs).Where(tab => !tab.Document.IsDirty).ToArray())">Close saved</button>
                <button role="menuitem" @onclick="() => RequestClose(Workspace.Layout.Groups.SelectMany(group => group.Tabs).ToArray())">Close all</button>
            </div>
        }
        <div class="group-editor">
            @if (group.ActiveTab is { } active)
            {
                @if (active.Document.Error is not null) { <div class="error" role="alert">@active.Document.Error</div> }
                <CodeEditor Value="@(active.Document.Content ?? string.Empty)" ValueChanged="value => Edit(active, value)"
                            WordWrap="WordWrap" ViewState="active.ViewState" ViewStateChanged="ActiveChanged"
                            @key="(active.Id, WordWrap)" />
            }
            @if (Workspace.DraggedTab is not null || ExternalDragActive)
            {
                <div class="group-drop-zones" aria-label="Editor drop zones">
                    <div class="drop-zone left" data-direction="left" aria-label="Drop left"></div>
                    <div class="drop-zone right" data-direction="right" aria-label="Drop right"></div>
                    <div class="drop-zone up" data-direction="up" aria-label="Drop above"></div>
                    <div class="drop-zone down" data-direction="down" aria-label="Drop below"></div>
                    <div class="drop-zone center" data-direction="center" aria-label="Drop in group"></div>
                </div>
            }
        </div>
    </section>
}

@code {
    [Parameter, EditorRequired] public EditorLayoutNode Node { get; set; } = null!;
    [Parameter, EditorRequired] public EditorGroupWorkspace Workspace { get; set; } = null!;
    [Parameter] public bool WordWrap { get; set; }
    [Parameter] public bool ExternalDragActive { get; set; }
    [Parameter] public EventCallback ActiveChanged { get; set; }
    [Parameter] public EventCallback ContentEdited { get; set; }
    [Parameter] public EventCallback<CloseViewRequest> CloseRequested { get; set; }
    private DocumentTab? _contextTab;
    private EditorGroup? _contextGroup;
    private double _contextX, _contextY;

    private static string OrientationClass(EditorSplit split) => split.Orientation == SplitOrientation.Horizontal ? "horizontal" : "vertical";
    private static string SplitStyle(EditorSplit split)
    {
        var first = (split.Ratio * 100).ToString(System.Globalization.CultureInfo.InvariantCulture);
        var second = ((1 - split.Ratio) * 100).ToString(System.Globalization.CultureInfo.InvariantCulture);
        return split.Orientation == SplitOrientation.Horizontal
            ? $"grid-template-columns:minmax(160px,{first}fr) 5px minmax(160px,{second}fr)"
            : $"grid-template-rows:minmax(160px,{first}fr) 5px minmax(160px,{second}fr)";
    }
    private async Task Focus(EditorGroup group) { Workspace.Focus(group.Id); await ActiveChanged.InvokeAsync(); }
    private async Task Split(EditorGroup group, SplitDirection direction) { Workspace.Split(group.Id, direction); await ActiveChanged.InvokeAsync(); }
    private async Task CloseGroup(EditorGroup group) { Workspace.CloseGroup(group.Id); await ActiveChanged.InvokeAsync(); }
    private async Task Activate(EditorGroup group, DocumentTab tab)
    {
        if (!group.Tabs.Contains(tab)) return;
        group.Activate(tab);
        Workspace.Focus(group.Id);
        await ActiveChanged.InvokeAsync();
    }
    private void Pin(DocumentTab tab) { if (!tab.IsPinned) Workspace.Promote(tab); }
    private Task RequestClose(EditorGroup group, DocumentTab tab) => RequestClose([tab]);
    private Task MiddleClose(MouseEventArgs args, DocumentTab tab) => args.Button == 1 ? RequestClose([tab]) : Task.CompletedTask;
    private Task RequestClose(DocumentTab[] tabs) { HideContextMenu(); return CloseRequested.InvokeAsync(new(tabs)); }
    private void ShowContextMenu(MouseEventArgs args, EditorGroup group, DocumentTab tab)
    { _contextGroup = group; _contextTab = tab; _contextX = args.ClientX; _contextY = args.ClientY; }
    private void HideContextMenu() { _contextGroup = null; _contextTab = null; }
    private async Task SplitContext(SplitDirection direction)
    {
        if (_contextGroup is { } group && _contextTab is { } tab
            && Workspace.Split(group.Id, direction) is { } created)
        {
            await Workspace.CopyAsync(tab, created.Id);
            await ActiveChanged.InvokeAsync();
        }
        HideContextMenu();
    }
    private async Task Edit(DocumentTab tab, string value) { tab.Document.Content = value; if (tab.IsPreview) Workspace.Promote(tab); await ContentEdited.InvokeAsync(); }
    private Task DropOnTabAsync(EditorGroup group, int index, DragEventArgs args) => DropAsync(group, index, null, args);
    private Task DropEdgeAsync(EditorGroup group, SplitDirection direction, DragEventArgs args) => DropAsync(group, null, direction, args);
    private Task DropCenterAsync(EditorGroup group, DragEventArgs args) => DropAsync(group, null, null, args);
    private async Task DropAsync(EditorGroup group, int? index, SplitDirection? direction, DragEventArgs args)
    { await Workspace.DropAsync(group.Id, index, direction, args.CtrlKey || args.MetaKey); await ActiveChanged.InvokeAsync(); }
    private string AccessibleLabel(DocumentTab tab) => $"{tab.Document.DisplayName}, {(tab.Document.IsDirty ? "unsaved" : "saved")}, {(tab.IsPinned ? "pinned" : "preview")}";
    private static string DisplayName(EditorGroup group, DocumentTab tab)
    {
        var duplicates = group.Tabs.Count(candidate => string.Equals(candidate.Document.DisplayName,
            tab.Document.DisplayName, StringComparison.OrdinalIgnoreCase));
        if (duplicates == 1) return tab.Document.DisplayName;
        return $"{tab.Document.DisplayName} — {Path.GetFileName(Path.GetDirectoryName(tab.Document.FilePath))}";
    }
}

@code {
    public sealed record CloseViewRequest(DocumentTab[] Tabs);
}
