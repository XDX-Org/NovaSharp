@if (Open)
{
    <section class="debug-panel" aria-label="Debugger">
        <header>
            <strong>Debugger</strong>
            <span aria-live="polite">@State</span>
            <button @onclick="Continue" disabled="@(State != DebugSessionState.Paused)">Continue</button>
            <button @onclick="Pause" disabled="@(State != DebugSessionState.Running)">Pause</button>
            <button @onclick='() => Step("next")' disabled="@(State != DebugSessionState.Paused)">Step over</button>
            <button @onclick='() => Step("stepIn")' disabled="@(State != DebugSessionState.Paused)">Step into</button>
            <button @onclick='() => Step("stepOut")' disabled="@(State != DebugSessionState.Paused)">Step out</button>
            <button @onclick="Stop" disabled="@(Session is null)">Stop</button>
            <button @onclick="RefreshStack" disabled="@(State != DebugSessionState.Paused)">Refresh stack</button>
        </header>
        @if (Session?.Breakpoints.Count > 0)
        {
            <ul aria-label="Breakpoints">@foreach (var breakpoint in Session.Breakpoints) { <li>@Path.GetFileName(breakpoint.SourcePath):@breakpoint.Line — @breakpoint.State</li> }</ul>
        }
        @if (Session?.Inspection.Frames.Count > 0)
        {
            <ol aria-label="Call stack">@foreach (var frame in Session.Inspection.Frames) { <li><button @onclick="() => SelectFrame(frame)">@frame.Name — @Path.GetFileName(frame.SourcePath):@frame.Line</button></li> }</ol>
        }
        @if (_scopes.Count > 0)
        {
            <div class="debug-scopes" aria-label="Scopes">@foreach (var scope in _scopes) { <button @onclick="() => LoadVariables(scope)">@scope.Name</button> }</div>
        }
        @if (_variables.Count > 0)
        {
            <table aria-label="Variables"><tbody>@foreach (var variable in _variables) { <tr><th>@variable.Name</th><td>@variable.Value</td><td>@variable.Type</td></tr> }</tbody></table>
        }
        <form class="debug-evaluate" @onsubmit="Evaluate" aria-label="Watch expression">
            <input aria-label="Expression" @bind="_expression" disabled="@(State != DebugSessionState.Paused)" />
            <button type="submit" disabled="@(State != DebugSessionState.Paused)">Evaluate</button>
            @if (_evaluation is not null) { <output>@_evaluation.Result @if (_evaluation.Type is not null) { <small>(@_evaluation.Type)</small> }</output> }
        </form>
    </section>
}

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public DebugAdapterSession? Session { get; set; }
    [Parameter] public EventCallback Stopped { get; set; }
    private DebugSessionState State => Session?.Coordinator.State ?? DebugSessionState.Idle;
    private string _expression = "";
    private DebugEvaluation? _evaluation;
    private IReadOnlyList<DebugScope> _scopes = [];
    private IReadOnlyList<DebugVariable> _variables = [];
    private int? _selectedFrame;
    private Task Continue() => Session?.CurrentThreadId is { } thread ? Session.ContinueAsync(thread) : Task.CompletedTask;
    private Task Pause() => Session?.PauseAsync(Session.CurrentThreadId ?? 0) ?? Task.CompletedTask;
    private Task Step(string command) => Session?.CurrentThreadId is { } thread ? Session.StepAsync(command, thread) : Task.CompletedTask;
    private Task Stop() => Stopped.InvokeAsync();
    private async Task RefreshStack() { if (Session is not null) await Session.LoadStackAsync(); }
    private async Task SelectFrame(DebugStackFrame frame)
    {
        if (Session is null) return;
        _selectedFrame = frame.Id;
        _variables = [];
        _scopes = await Session.LoadScopesAsync(frame.Id);
    }
    private async Task LoadVariables(DebugScope scope)
    {
        if (Session is not null) _variables = await Session.LoadVariablesAsync(scope.VariablesReference);
    }
    private async Task Evaluate()
    {
        if (Session is null) return;
        _evaluation = await Session.EvaluateAsync(_expression, _selectedFrame ?? Session.Inspection.Frames.FirstOrDefault()?.Id);
    }
}
