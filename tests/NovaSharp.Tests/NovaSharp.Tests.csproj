<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/NovaSharp/NovaSharp.csproj" />
  </ItemGroup>

  <!-- Contract tests read these as text. Copying them keeps the tests free of any build-machine path. -->
  <ItemGroup>
    <Content Include="../../src/NovaSharp/wwwroot/monaco-editor-host.js"
             Link="Contracts/monaco-editor-host.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../src/NovaSharp/wwwroot/index.html"
             Link="Contracts/index.html" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../src/NovaSharp/wwwroot/app.css"
             Link="Contracts/app.css" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../src/NovaSharp/wwwroot/workspace-explorer.js"
             Link="Contracts/workspace-explorer.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../src/NovaSharp/wwwroot/workbench-shell.js"
             Link="Contracts/workbench-shell.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../src/NovaSharp/Components/EditorPanel.razor"
             Link="Contracts/EditorPanel.razor" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../src/NovaSharp/Components/WorkspaceExplorer.razor"
             Link="Contracts/WorkspaceExplorer.razor" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../src/NovaSharp/Components/ContextCommandMenu.razor"
             Link="Contracts/ContextCommandMenu.razor" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../src/NovaSharp/Components/CommandMenu.razor"
             Link="Contracts/CommandMenu.razor" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../src/NovaSharp/Components/WorkspaceTreeNode.razor"
             Link="Contracts/WorkspaceTreeNode.razor" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
